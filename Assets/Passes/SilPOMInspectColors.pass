{
    "Type": "JsonSerialization",
    "Version": 1,
    "ClassName": "PassAsset",
    "ClassData": {
        "PassTemplate": {
            "Name": "SilPOMInspectColorsTemplate",
            "PassClass": "FullScreenTriangle",
            "Slots": [
                {
                    "Name": "Diffuse",
                    "ShaderInputName": "m_diffuse",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader"
                },
                {
                    "Name": "Specular",
                    "ShaderInputName": "m_specular",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader"
                },
                {
                    "Name": "DiffuseSamples",
                    "SlotType": "Output",
                    "ScopeAttachmentUsage": "RenderTarget"
                },
                {
                    "Name": "SpecularSamples",
                    "SlotType": "Output",
                    "ScopeAttachmentUsage": "RenderTarget"
                }
            ],
            "Connections": [
                {
                    "LocalSlot": "Diffuse",
                    "AttachmentRef": {
                        "Pass": "Forward",
                        "Attachment": "DiffuseOutput"
                    }
                },
                {
                    "LocalSlot": "Specular",
