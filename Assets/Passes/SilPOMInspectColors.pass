                    }
                },
                {
                    "Name": "SpecularSamplesImage",
                    "SizeSource": {
                        "Source": {
                            "Pass": "This",
                            "Attachment": "Diffuse"
                        },
                        "Multipliers": {
                            "WidthMultiplier": 4,
                            "HeightMultiplier": 1
                        }
                    },
                    "ImageDescriptor": {
                        "Format": "R16G16B16A16_FLOAT",
                        "SharedQueueMask": "Graphics"
                    }
                }
            ],
            "PassData": {
                "$type": "FullscreenTrianglePassData",
