                        "Pass": "Forward",
                        "Attachment": "SpecularOutput"
                    }
                },
                {
                    "LocalSlot": "DiffuseSamples",
                    "AttachmentRef": {
                        "Pass": "This",
                        "Attachment": "DiffuseSamplesImage"
                    }
                },
                {
                    "LocalSlot": "SpecularSamples",
                    "AttachmentRef": {
                        "Pass": "This",
                        "Attachment": "SpecularSamplesImage"
                    }
                }
            ],
            "ImageAttachments": [
                {
                    "Name": "DiffuseSamplesImage",
                    "SizeSource": {
                        "Source": {
                            "Pass": "This",
                            "Attachment": "Diffuse"
                        },
                        "Multipliers": {
                            "WidthMultiplier": 4,
                            "HeightMultiplier": 1
                        }
                    },
                    "ImageDescriptor": {
                        "Format": "R16G16B16A16_FLOAT",
