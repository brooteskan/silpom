#pragma once
#include <Atom/Feature/Common/Assets/Shaders/Materials/StandardPBR/StandardPBR_MaterialInputs.azsli>
#if !SHADOWMAP
#include "../../../Shaders/SilPOM/Heightfield.azsli"

SilPomPatch SilPomGetPatch(const MaterialParameters params)
{
    SilPomPatch p;
    p.width=params.m_silpomWidth; p.height=params.m_silpomHeight;
    p.scale=params.m_silpomScale; p.reference=params.m_silpomReference;
    p.tileU=params.m_silpomTileU; p.tileV=params.m_silpomTileV;
    p.offsetU=params.m_silpomOffsetU; p.offsetV=params.m_silpomOffsetV;
    p.addressMode=params.m_silpomAddressMode; p.maxCells=params.m_silpomMaxCells;
    GetMaterialTexture(params.m_silpomHeightMap).GetDimensions(p.textureWidth,p.textureHeight);
    return p;
}
#endif

VsOutput EvaluateVertexGeometry(VsInput IN, VsSystemValues SV, const MaterialParameters params)
{
    VsOutput output = (VsOutput)0;
#if MATERIALPIPELINE_USES_PREV_VERTEX_POSITION
    // Static v0 uses camera motion reconstructed from the true depth buffer.
    // Suppress the proxy motion pass even when mesh instancing is enabled.
    output.position=float4(2,2,0,1);
    return output;
#endif
    float4x4 objectToWorld=GetObjectToWorldMatrix(SV);
    float4x4 vp=GetViewProjectionMatrix(SV);
#if SHADOWMAP
    // Shadow geometry is the original finite rectangle, never the expanded
    // camera coverage. This variant does not even include the height kernel.
    float3 flat=float3(IN.position.xy*float2(params.m_silpomWidth,params.m_silpomHeight)*.5,0);
    float4 world=mul(objectToWorld,float4(flat,1));
    output.position=mul(vp,world);
    output.worldPosition=world.xyz;
    return output;
#else
    float2 low=float2(1.0,1.0), high=float2(-1.0,-1.0);
    float h0=-params.m_silpomScale*params.m_silpomReference;
    float h1=params.m_silpomScale*(1.0-params.m_silpomReference);
    bool conservative=false;
    for(uint i=0;i<8;++i)
    {
        float3 p=float3((i&1)!=0?params.m_silpomWidth*.5:-params.m_silpomWidth*.5,
            (i&2)!=0?params.m_silpomHeight*.5:-params.m_silpomHeight*.5,
            (i&4)!=0?max(h0,h1)+1e-5:min(h0,h1)-1e-5);
        float4 clip=mul(vp,mul(objectToWorld,float4(p,1.0)));
        if(clip.w<=1e-6 || clip.z<0.0 || clip.z>clip.w) conservative=true;
        float2 xy=clip.xy/max(clip.w,1e-6);
        low=min(low,xy); high=max(high,xy);
    }
    if(conservative) { low=float2(-1,-1); high=float2(1,1); }
    // A small expansion includes boundary samples despite projection rounding.
    low=max(low-.00001,float2(-1,-1)); high=min(high+.00001,float2(1,1));
    float2 corner=IN.position.xy*.5+.5;
    output.ndc=lerp(low,high,corner);
    output.position=float4(output.ndc,.5,1);
    output.normal=float3(0,0,1); output.tangent=float4(1,0,0,1);
    output.color0=float4(1,1,1,1);
    return output;
#endif
}

#if MATERIALPIPELINE_SHADER_HAS_PIXEL_STAGE || MATERIALPIPELINE_SHADER_HAS_GEOMETRIC_PIXEL_STAGE
COMMON_OPTIONS_PARALLAX()
bool ShouldHandleParallax() { return false; }
bool NeedsTangentFrame() { return true; }

PixelGeometryData EvaluatePixelGeometry(inout VsOutput IN, VsSystemValues SV, bool isFrontFace, const MaterialParameters params)
{
#if SHADOWMAP
    // Atom selects shadow_customZ together with camera custom depth. Preserve
    // hardware-interpolated shadow depth; no ray, height fetch or clipping.
    PixelGeometryData geo=(PixelGeometryData)0;
    geo.positionWS=IN.worldPosition;
    return geo;
#else
    SilPomPatch p=SilPomGetPatch(params);
    float nearZ=1.0;
    float4 nearH=mul(ViewSrg::m_viewProjectionInverseMatrix,float4(IN.ndc,nearZ,1));
    float4 midH=mul(ViewSrg::m_viewProjectionInverseMatrix,float4(IN.ndc,.5,1));
    float3 origin=nearH.xyz/nearH.w;
    float3 direction=normalize(midH.xyz/midH.w-origin);
    float4x4 model=GetObjectToWorldMatrix(SV);
    // Component uploads a rigid metre-space frame, with footprint scale resolved separately.
    float3x3 inverseRotation=transpose((float3x3)model);
    float3 translation=mul(model,float4(0,0,0,1)).xyz;
    SilPomRay ray;
    ray.origin=mul(inverseRotation,origin-translation);
    ray.direction=mul(inverseRotation,direction);
    ray.tMin=0; ray.tMax=1e7;
    SilPomHit hit;
    if(o_silpomUseHierarchy)
        hit=SilPomIntersectBounds(GetMaterialTexture(params.m_silpomHeightMap),
            GetMaterialTexture(params.m_silpomHeightBounds),p,ray);
    else
        hit=SilPomIntersectMode(GetMaterialTexture(params.m_silpomHeightMap),p,ray,o_silpomReuseTexels);
    IN.silpomDiagnostic=float4(float(hit.status),float(hit.cells),hit.t,0);
    // Exhaustion is conspicuous, never silently treated as a physical miss.
    if(hit.status==SP_MISS) discard;
    if(hit.status!=SP_HIT)
    {
        float begin=0,end=0;
        if(!SilPomInterval(ray,p,begin,end)) discard;
        hit.position=ray.origin+ray.direction*begin;
        hit.normal=float3(0,0,1); hit.uv=float2(0,0);
    }
    PixelGeometryData geo=(PixelGeometryData)0;
    geo.positionWS=mul(model,float4(hit.position,1)).xyz;
    float4 clip=mul(GetViewProjectionMatrix(SV),float4(geo.positionWS,1));
    if(clip.w<=0 || clip.z<0 || clip.z>clip.w) discard;
    IN.position.z=clip.z/clip.w;
    IN.worldPosition=geo.positionWS;
    IN.color0=hit.status==SP_HIT?float4(1,1,1,1):float4(1,0,1,1);
    geo.vertexNormal=normalize(mul((float3x3)model,hit.normal));
    geo.isFrontFace=dot(hit.normal,ray.direction)<0;
    geo.isDisplacementClipped=hit.status!=SP_HIT;
    for(uint i=0;i<UvSetCount;++i)
    {
        geo.uvs[i]=hit.uv;
        geo.tangents[i]=normalize(mul((float3x3)model,float3(1,0,0)));
        geo.bitangents[i]=normalize(mul((float3x3)model,float3(0,1,0)));
    }
    return geo;
#endif
}
#endif

#if MATERIALPIPELINE_SHADER_HAS_PIXEL_STAGE
COMMON_OPTIONS_BASE_COLOR()
COMMON_OPTIONS_VERTEX_COLOR()
COMMON_OPTIONS_ROUGHNESS()
COMMON_OPTIONS_METALLIC()
COMMON_OPTIONS_SPECULAR_F0()
COMMON_OPTIONS_NORMAL()
COMMON_OPTIONS_CLEAR_COAT()
COMMON_OPTIONS_OCCLUSION()
COMMON_OPTIONS_EMISSIVE()
#define EvaluateSurface EvaluateSurface_SilPomBase
#include <Atom/Feature/Common/Assets/Shaders/Materials/StandardPBR/StandardPBR_SurfaceEval.azsli>
#undef EvaluateSurface
Surface EvaluateSurface(VsOutput IN, VsSystemValues SV, PixelGeometryData geo, const MaterialParameters params)
{
    bool failed=geo.isDisplacementClipped;
    float3 geometricNormal=geo.vertexNormal;
    // The supplied normal map already describes the full relief slope in the planar frame.
    if(o_normal_useTexture) geo.vertexNormal=normalize(cross(geo.tangents[0],geo.bitangents[0]));
    Surface surface=EvaluateSurface_StandardPBR(IN,SV,geo,params);
    if(failed)
    {
        // Failures have priority over every optional debug view.
        float3 color=IN.silpomDiagnostic.x==float(SP_INVALID)?float3(1,1,0):float3(1,0,1);
        surface.emissiveLighting=color*8; surface.albedo=color;
    }
    else if(params.m_silpomDebug!=0)
    {
        float3 color=float3(0,1,0); // 5: hit mask, failures retain their colors
        if(params.m_silpomDebug==1) color=geometricNormal*.5+.5;
        if(params.m_silpomDebug==2)
        {
            float work=saturate(IN.silpomDiagnostic.y/max(float(params.m_silpomMaxCells),1.0));
            color=float3(work,1-work,0);
        }
        if(params.m_silpomDebug==3) color=float3(frac(geo.uvs[0]),0);
        if(params.m_silpomDebug==4) color=float3(IN.position.z,IN.position.z,IN.position.z);
        surface.albedo=float3(0,0,0); surface.emissiveLighting=color;
    }
    return surface;
}
#include <Atom/Feature/Common/Assets/Shaders/Materials/StandardPBR/StandardPBR_LightingEval.azsli>
#elif MATERIALPIPELINE_SHADER_HAS_GEOMETRIC_PIXEL_STAGE
void EvaluateSurface(VsOutput IN, VsSystemValues SV, PixelGeometryData geo, const MaterialParameters params) {}
#endif
