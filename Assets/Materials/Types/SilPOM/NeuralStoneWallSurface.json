{
    "name": "surface",
    "displayName": "SilPOM Surface",
    "properties": [
        {
            "name": "heightMap",
            "type": "Image",
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomHeightMap"
            }
        },
        {
            "name": "reuseTexels",
            "displayName": "Reuse adjacent height texels",
            "description": "Compile the exact traversal with adjacent-cell texel reuse. Disable only for frozen performance comparisons.",
            "type": "Bool",
            "defaultValue": true,
            "connection": {
                "type": "ShaderOption",
                "name": "o_silpomReuseTexels"
            }
        },
        {
            "name": "heightBounds",
            "displayName": "Conservative height bounds",
            "description": "RG32F min/max atlas derived from the exact height source.",
            "type": "Image",
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomHeightBounds"
            }
        },
        {
            "name": "useHierarchy",
            "displayName": "Use conservative bounds",
            "description": "Use precomputed conservative cell bounds for long traversals; exact height samples and roots remain authoritative.",
            "type": "Bool",
            "defaultValue": true,
            "connection": {
                "type": "ShaderOption",
                "name": "o_silpomUseHierarchy"
            }
        },
        {
            "name": "width",
            "type": "Float",
            "defaultValue": 2,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomWidth"
            }
        },
        {
            "name": "height",
            "type": "Float",
            "defaultValue": 2,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomHeight"
            }
        },
        {
            "name": "scale",
            "type": "Float",
            "defaultValue": 0.1,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomScale"
            }
        },
        {
            "name": "reference",
            "type": "Float",
            "defaultValue": 0.5,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomReference"
            }
        },
        {
            "name": "tileU",
            "type": "Float",
            "defaultValue": 1,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomTileU"
            }
        },
        {
            "name": "tileV",
            "type": "Float",
            "defaultValue": 1,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomTileV"
            }
        },
        {
            "name": "offsetU",
            "type": "Float",
            "defaultValue": 0,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomOffsetU"
            }
        },
        {
            "name": "offsetV",
            "type": "Float",
            "defaultValue": 0,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomOffsetV"
            }
        },
        {
            "name": "addressMode",
            "type": "UInt",
            "defaultValue": 0,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomAddressMode"
            }
        },
        {
            "name": "maxCells",
            "type": "UInt",
            "defaultValue": 1024,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomMaxCells"
            }
        },
        {
            "name": "debug",
            "type": "UInt",
            "defaultValue": 0,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomDebug"
            }
        },
        {
            "name": "neuralCache",
            "type": "Image",
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomNeuralCache"
            }
        },
        {
            "name": "grazingCache",
            "type": "Image",
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomGrazingCache"
            }
        },
        {
            "name": "useGrazingCache",
            "type": "UInt",
            "defaultValue": 0,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomUseGrazingCache"
            }
        },
        {
            "name": "reliefFadeStart",
            "displayName": "Relief Fade Start (m)",
            "description": "Keep full relief up to this distance from the panel.",
            "type": "Float",
            "defaultValue": 0.0,
            "min": 0.0,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomFadeStart"
            }
        },
        {
            "name": "fillCacheGaps",
            "displayName": "Fill Cache Gaps",
            "description": "Shade the flat stone surface when the two-cache material cannot resolve a relief hit.",
            "type": "Bool",
            "defaultValue": false,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomFillCacheGaps"
            }
        },
        {
            "name": "reliefFadeEnd",
            "displayName": "Relief Fade End (m)",
            "description": "Render flat at this distance. Set above the start distance to enable fading on the dual-cache material.",
            "type": "Float",
            "defaultValue": 0.0,
            "min": 0.0,
            "connection": {
                "type": "ShaderInput",
                "name": "m_silpomFadeEnd"
            }
        }
    ]
}
