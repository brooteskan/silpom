#pragma once
#include <Atom/Feature/Common/Assets/Materials/Types/StandardPBR_Defines.azsli>

// Compiled as separate material variants so the frozen traversal comparison
// does not pay for a dynamic branch in the measured inner loop.
option bool o_silpomReuseTexels = true;
option bool o_silpomUseHierarchy = true;

// Sample interpolation makes the intersection ray agree with MSAA depth samples.
#define VsOutput VsOutput_SilPom
struct VsOutput_SilPom
{
    precise linear centroid float4 position : SV_Position;
    float3 normal : NORMAL;
    float4 tangent : TANGENT;
    float2 uvs[UvSetCount] : UV0;
    float3 worldPosition : UV4;
    float3 worldPosPrev : UV6;
    float4 color0 : UV7;
    sample float2 ndc : UV9;
    float4 silpomDiagnostic : UV10;
    uint m_instanceId : SV_InstanceID;
};
