static uint silpomPaintReceiverFace=0,silpomPaintReceiverOwner=0;
#define DECAL_PAINT_RECEIVER_FACE() silpomPaintReceiverFace
#define DECAL_PAINT_RECEIVER_OWNER() silpomPaintReceiverOwner
#define DECAL_PAINT_HEIGHT() SilPomPaintHeight()
#endif
