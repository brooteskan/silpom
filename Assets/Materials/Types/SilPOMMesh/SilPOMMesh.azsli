#if defined(SILPOM_LEARNED_MATERIAL)
#include "../../../Shaders/SilPOM/LearnedMaterialSurface.azsli"
#if SILPOM_SHARED_VISIBILITY && SILPOM_DIRECTIONAL_COMPARISON
#include "../../../Shaders/SilPOM/DirectionalEstimator.azsli"
#endif
#else
#define EvaluateSurface EvaluateSurface_SilPomFaceBase
#include <Atom/Feature/Common/Assets/Shaders/Materials/StandardPBR/StandardPBR_SurfaceEval.azsli>
#undef EvaluateSurface
#include "../../../Shaders/SilPOM/StandardPbrNormal.azsli"
#endif
#if SILPOM_LEVEL_FIVE
#include "../../../Shaders/SilPOM/ProxyAppearance.azsli"
#endif
Surface SilPomEvaluateSurfaceCore(VsOutput IN,VsSystemValues SV,PixelGeometryData geo,const MaterialParameters params)
{
    silpomPaintHeightTexture=params.m_silpomHeightMap;
#if defined(SILPOM_LEARNED_MATERIAL)
    float4 materialDerivatives=silpomUvDerivatives;
#endif
#if SILPOM_LEVEL_FIVE
    if(silpomLitProxy)
    {
#if SILPOM_SHARED_VISIBILITY && SILPOM_DIRECTIONAL_COMPARISON
        if(o_silpomLightingEstimator!=SilPomLightingEstimator::CurrentRouting && o_silpomLightingEstimator!=SilPomLightingEstimator::PhysicalRayNeural)
        {
            float comparisonMaterial[6];SilPomAcquireComparisonMaterial(geo.uvs[0],params,materialDerivatives,comparisonMaterial);
            SilPomAcquireDirectionalEstimator(materialDerivatives);
        }
#endif
#if SILPOM_SHARED_VISIBILITY && SILPOM_DIRECTIONAL_COMPARISON
        Surface proxySurface=SilPomEvaluateProxySurface(IN,SV,geo,params);
#if SILPOM_DIFFUSE_ACCESSIBILITY
        proxySurface.diffuseAmbientOcclusion*=SilPomDirectionalAmbientAccessibility();
#endif
        return proxySurface;
#else
        return SilPomEvaluateProxySurface(IN,SV,geo,params);
#endif
    }
#endif
#if defined(SILPOM_LEARNED_MATERIAL)
    Surface surface=SilPomEvaluateLearnedSurface(IN,SV,geo,params,materialDerivatives);
#if SILPOM_SHARED_VISIBILITY && SILPOM_DIRECTIONAL_COMPARISON
    if(o_silpomLightingEstimator!=SilPomLightingEstimator::CurrentRouting && o_silpomLightingEstimator!=SilPomLightingEstimator::PhysicalRayNeural)
        SilPomAcquireDirectionalEstimator(materialDerivatives);
#if SILPOM_DIFFUSE_ACCESSIBILITY
    surface.diffuseAmbientOcclusion*=SilPomDirectionalAmbientAccessibility();
#endif
#endif
#else
    Surface surface=EvaluateSurface_StandardPBR(IN,SV,geo,params,silpomUvDerivatives,true);
#endif
    if(geo.isDisplacementClipped)
    {
        float3 diagnostic=IN.silpomDiagnostic.x==float(SP_INVALID)?float3(1,1,0):float3(1,0,1);
        surface.emissiveLighting=diagnostic*8; surface.albedo=diagnostic;
    }
    return surface;
}

#include "../../../Shaders/SilPOM/GradientConsumers.azsli"
#include "../../../Shaders/SilPOM/NormalQueryPolicy.azsli"
#if SILPOM_HIT_FORWARD
float4 SilPomGoboUvGradients(float4x4 worldToLightClip,float4 lightClip)
{
    return SilPomProjectedUvDerivatives(lightClip,mul(worldToLightClip,float4(silpomPositionDx,0)),
        mul(worldToLightClip,float4(silpomPositionDy,0)));
}

float SilPomExplicitSpecularAA(float3 normal,float roughnessA2)
{
    bool centerAppearanceCoarse=false;
#if SILPOM_LEVEL_FIVE
    centerAppearanceCoarse=silpomLitProxy && silpomAppearanceGradientsCoarse;
#endif
    return SilPomNormalQueryRoughness(roughnessA2,true,silpomSourceGradient.validity,
        silpomNormalProbesCoarse,centerAppearanceCoarse,silpomNormalDx,silpomNormalDy);
}

PixelGeometryData SilPomVirtualGeometry(PixelGeometryData center,float2 uvOffset,float3 positionOffset,
    VsOutput IN,MaterialParameters params)
{
    PixelGeometryData geo=center;
    geo.positionWS+=positionOffset;
    const float2 uv=center.uvs[0]+uvOffset;
    float3 normal=silpomLitFace.normal;
    if(silpomLitValid && params.m_silpomUseHeightDerivedNormals
#if SILPOM_LEVEL_FIVE
        && !silpomLitProxy
#endif
    )
        normal=SilPomFaceNormal(GetMaterialTexture(params.m_silpomHeightMap),silpomLitPatch,silpomLitFace,uv,
            min(silpomLitFace.uv0,min(silpomLitFace.uv1,silpomLitFace.uv2)));
    const float4 nearH=mul(ViewSrg::m_viewProjectionInverseMatrix,float4(IN.ndc,1,1));
    const float4 midH=mul(ViewSrg::m_viewProjectionInverseMatrix,float4(IN.ndc,.5f,1));
    const float3 toward=normalize(midH.xyz/midH.w-nearH.xyz/nearH.w);
    const float3 direction=mul(transpose(silpomLitRotation),toward);
    if(SilPomTowerNoMarch(silpomLitPatch.maxCells))
    {
        const float faceFacing=dot(silpomLitFace.normal,direction);
        const float facing=dot(normal,direction)*(center.isFrontFace?-1.0f:1.0f);
        const float transition=max(.25f*abs(faceFacing),1e-5f);
        if(facing<transition)normal=normalize(lerp(silpomLitFace.normal,normal,smoothstep(0.0f,transition,facing)));
    }
    geo.vertexNormal=normalize(mul(silpomLitRotation,normal));
    const float3 tangent=normalize(silpomLitFace.du-normal*dot(normal,silpomLitFace.du));
    const float handedness=dot(cross(normal,tangent),silpomLitFace.dv)<0?-1:1;
    for(uint i=0;i<UvSetCount;++i)
    {
        geo.uvs[i]=uv;geo.tangents[i]=normalize(mul(silpomLitRotation,tangent));
        geo.bitangents[i]=handedness*normalize(cross(geo.vertexNormal,geo.tangents[i]));
    }
    return geo;
}

#endif

Surface EvaluateSurface_SilPomMesh(VsOutput IN,VsSystemValues SV,PixelGeometryData geo,const MaterialParameters params)
{
#if SILPOM_HIT_FORWARD && ENABLE_SPECULARAA
    // Local numerical material-normal differential. Every evaluation retains
    // this sample's owner, branch, footprint and pre-paint material stage.
    // Center runs last to publish its complete material and lighting state.
    silpomNormalDx=0;silpomNormalDy=0;silpomNormalProbesCoarse=false;
    if(SilPomNormalQueryNeedsProbes(o_applySpecularAA,silpomLitValid,silpomSourceGradient.validity))
    {
        const float step=.25f;
        const float2 centerUv=silpomLitUv;
        float3 normals[4];
#if SILPOM_LEVEL_FIVE
        SilPomProxyNormalSetup proxySetup=(SilPomProxyNormalSetup)0;
        if(silpomLitProxy)proxySetup=SilPomPrepareProxyNormalSetup(params);
#endif
#if defined(SILPOM_LEARNED_MATERIAL)
        SilPomLearnedNormalSetup learnedSetup=(SilPomLearnedNormalSetup)0;
        if(params.m_silpomMaterialUseNormal && AreNormalMapsEnabled()
#if SILPOM_LEVEL_FIVE
            && !silpomLitProxy
#endif
        )learnedSetup=SilPomPrepareLearnedNormalSetup(params,silpomUvDerivatives);
#endif
        [unroll] for(uint k=0;k<4;++k)
        {
            const float signedStep=(k&1u)==0u?step:-step;
            const bool x=k<2u;
            const float3 positionOffset=(x?silpomPositionDx:silpomPositionDy)*signedStep;
#if SILPOM_LEVEL_FIVE
            if(silpomLitProxy)
            {
                bool probeCoarse;
                normals[k]=SilPomEvaluateProxyNormalPrepared(geo.positionWS+positionOffset,geo.isFrontFace,
                    params,proxySetup,probeCoarse);
                silpomNormalProbesCoarse=silpomNormalProbesCoarse||probeCoarse;
            }
            else
#endif
            {
                const float2 uvOffset=(x?silpomUvDerivatives.xy:silpomUvDerivatives.zw)*signedStep;
                VsOutput virtualIn=IN;
                virtualIn.ndc+=(x?float2(2,0):float2(0,-2))*signedStep/PassSrg::m_silpomViewport.zw;
                virtualIn.position.xy+=(x?float2(1,0):float2(0,1))*signedStep;
                PixelGeometryData virtualGeo=SilPomVirtualGeometry(geo,uvOffset,positionOffset,virtualIn,params);
                virtualIn.worldPosition=virtualGeo.positionWS;
                silpomLitUv=centerUv+uvOffset;
#if defined(SILPOM_LEARNED_MATERIAL)
                normals[k]=SilPomEvaluateLearnedNormalPrepared(virtualGeo,params,learnedSetup);
#else
                normals[k]=SilPomEvaluateStandardNormal(virtualIn,SV,virtualGeo,params,silpomUvDerivatives);
#endif
            }
        }
        silpomLitUv=centerUv;
        silpomNormalDx=(normals[0]-normals[1])/(2*step);
        silpomNormalDy=(normals[2]-normals[3])/(2*step);
        if(!SilPomGradientFinite3(silpomNormalDx)||!SilPomGradientFinite3(silpomNormalDy))
        {silpomNormalProbesCoarse=true;silpomNormalDx=0;silpomNormalDy=0;}
    }
#endif
    return SilPomEvaluateSurfaceCore(IN,SV,geo,params);
}
#if !defined(SILPOM_RECEIVER_UV)
Surface EvaluateSurface(VsOutput IN,VsSystemValues SV,PixelGeometryData geo,const MaterialParameters params)
{return EvaluateSurface_SilPomMesh(IN,SV,geo,params);}
#endif
