#pragma once
#include "../../../Shaders/SilPOM/GradientConsumers.azsli"
// Keep the engine's light/BRDF implementation, replacing only directional
// visibility. Other lighting, IBL and emissive are evaluated normally.
#define ApplyDirectionalLights ApplyDirectionalLights_StandardSilPom
#include <Atom/Features/Pipeline/Forward/ForwardPassDirectionalLights.azsli>
#undef ApplyDirectionalLights
// The hit-forward pass with the shadow frame, lit from the scene's SRGs. The
// UV bake pass also defines SILPOM_HIT_FORWARD but has its own pass SRGs.
#if SILPOM_FORWARD_SHADOW_FRAME && SILPOM_HIT_FORWARD && !defined(SILPOM_UV_BAKE)
#define SILPOM_FORWARD_SCENE_LIGHTING 1
#endif
#if SILPOM_FORWARD_SCENE_LIGHTING
#include "../../../Shaders/SilPOM/CascadeShadow.azsli"
#endif
#if defined(SILPOM_NEURAL_VISIBILITY_ONLY)
// One center-owned context is created only at direct-light entry. Compile-time
// backend guards omit unused families; options gate lazy preparation.
struct SilPomLightingReceiver
{
#if !SILPOM_SHARED_VISIBILITY || SILPOM_DIRECTIONAL_COMPARISON
    SilPomNeuralPhysicalReceiver physical;
#endif
#if SILPOM_SHARED_VISIBILITY
    SilPomSharedVisibilityReceiver sharedReceiver;
#if SILPOM_DIRECTIONAL_COMPARISON
    bool queryFramePrepared;
    float3 T,B;
#endif
#endif
#if SILPOM_LEVEL_FIVE && !SILPOM_DIRECTIONAL_COMPARISON
    SilPomAppearanceLightReceiver appearance;
#endif
};
void SilPomInitLightingReceiver(inout SilPomLightingReceiver receiver)
{
#if SILPOM_DIRECTIONAL_COMPARISON
    if(o_silpomLightingEstimator==SilPomLightingEstimator::PhysicalRayNeural)
        SilPomInitNeuralPhysicalReceiver(receiver.physical);
#if SILPOM_SHARED_VISIBILITY
    else if(o_silpomLightingEstimator!=SilPomLightingEstimator::CurrentRouting)
        receiver.queryFramePrepared=false;
    else SilPomInitSharedVisibilityReceiver(receiver.sharedReceiver);
#endif
#else
#if SILPOM_LEVEL_FIVE
    if(silpomLitProxy){SilPomInitAppearanceLightReceiver(receiver.appearance);return;}
#endif
#if SILPOM_SHARED_VISIBILITY
    SilPomInitSharedVisibilityReceiver(receiver.sharedReceiver);
#else
    SilPomInitNeuralPhysicalReceiver(receiver.physical);
#endif
#endif
}
#define SILPOM_RECEIVER_PARAMETER ,inout SilPomLightingReceiver receiver
#define SILPOM_RECEIVER_ARGUMENT ,receiver
#else
#define SILPOM_RECEIVER_PARAMETER
#define SILPOM_RECEIVER_ARGUMENT
#endif
#if SILPOM_FORWARD_SHADOW_FRAME
SilPomPatch SilPomForwardShadowPatch(MaterialParameters params)
{
    SilPomPatch p=(SilPomPatch)0;
    p.width=1;p.height=1;p.scale=params.m_silpomScale;p.reference=params.m_silpomReference;
    p.tileU=params.m_silpomTileU;p.tileV=params.m_silpomTileV;
    p.offsetU=params.m_silpomOffsetU;p.offsetV=params.m_silpomOffsetV;
    p.addressMode=params.m_silpomAddressMode;p.maxCells=params.m_silpomMaxCells;
    GetMaterialTexture(params.m_silpomHeightMap).GetDimensions(p.textureWidth,p.textureHeight);
    return p;
}
// Reloads the hit face and builds the shadow frame at directional-light entry.
// In the hit-forward pass the index is laundered through a uniform scene
// constant so the compiler cannot reuse the geometry stage's face load (which
// would keep the face live through surface evaluation and decals).
SilPomForwardShadowFrame SilPomLitShadowFrame(MaterialParameters params)
{
#if SILPOM_FORWARD_SCENE_LIGHTING
    const uint faceIndex=SceneSrg::m_directionalLightCount==0xFFFFFFFFu?0u:silpomLitFaceIndex;
#else
    const uint faceIndex=silpomLitFaceIndex;
#endif
    const SilPomMeshFace face=SilPomLoadFace(params.m_meshBufferIndex,faceIndex
#if SILPOM_FACE_COEFFICIENT_CACHE
        ,params.m_silpomFaceCoefficientBuffer
#endif
    );
    return SilPomMakeForwardShadowFrame(GetMaterialTexture(params.m_silpomHeightMap),SilPomForwardShadowPatch(params),
        face,silpomLitUv,params.m_silpomNeuralDirectionalVisibility || params.m_silpomSpiralLightShadowSteps!=0u);
}
#define SILPOM_LIT_NORMAL silpomLitShadow.normal
#define SILPOM_LIT_ORIGIN silpomLitShadow.origin
#define SILPOM_LIT_LOCAL_VISIBILITY(light,steps,reach,params) \
    SilPomForwardFrameVisibility(GetMaterialTexture(params.m_silpomHeightMap),SilPomForwardShadowPatch(params), \
        silpomLitShadow,light,steps,reach,SilPomMaterialModel(params),SilPomNeuralOnlyThreshold(SilPomMaterialModel(params)))
#else
#define SILPOM_LIT_NORMAL silpomLitFace.normal
#define SILPOM_LIT_ORIGIN silpomLitFace.origin
#define SILPOM_LIT_LOCAL_VISIBILITY(light,steps,reach,params) \
    SilPomLocalVisibility(GetMaterialTexture(params.m_silpomHeightMap),silpomLitPatch,silpomLitFace,silpomLitUv, \
        min(silpomLitFace.uv0,min(silpomLitFace.uv1,silpomLitFace.uv2)),light,steps,reach,params SILPOM_RECEIVER_ARGUMENT)
#endif
// The object rotation, reloaded where lighting needs it instead of carried in
// VGPRs from the hit. Without instancing it is uniform per draw. The index is
// laundered through another uniform constant (a light count that is never
// 0xFFFFFFFF), so the compiler cannot merge this load with the geometry
// stage's (which would keep that copy live through lighting) and the loads
// stay scalar. A per-pixel condition would make them per-lane (150 vs 141
// peak on gfx1100); wave intrinsics are unavailable on Vulkan.
float3x3 SilPomLitRotationReload()
{
#if SILPOM_FORWARD_SCENE_LIGHTING
    if(o_meshInstancingIsEnabled)return silpomLitRotation;
    const uint objectId=SceneSrg::m_directionalLightCount==0xFFFFFFFFu?0u:ObjectSrg::m_objectId;
    return (float3x3)SceneSrg::GetObjectToWorldMatrix(objectId);
#else
    return silpomLitRotation;
#endif
}
float SilPomLocalVisibility(Texture2D texture,SilPomPatch p,SilPomMeshFace face,float2 uv,float2 low,
    float3 light,uint steps,float reach,MaterialParameters params SILPOM_RECEIVER_PARAMETER)
{
#if defined(SILPOM_NEURAL_VISIBILITY_ONLY) && SILPOM_DIRECTIONAL_COMPARISON
    if(o_silpomLightingEstimator==SilPomLightingEstimator::PhysicalRayNeural)
        return SilPomNeuralOnlyVisibilityPrepared(texture,p,face,uv,low,light,steps,reach,SilPomMaterialModel(params),
            SilPomNeuralOnlyThreshold(SilPomMaterialModel(params)),receiver.physical);
#if SILPOM_SHARED_VISIBILITY
    if(o_silpomLightingEstimator!=SilPomLightingEstimator::CurrentRouting)
    {
        if(steps==0u)return 1;
        if(!receiver.queryFramePrepared)
        {
            receiver.T=normalize(silpomLitFace.du);
            receiver.B=normalize(cross(silpomLitFace.normal,receiver.T));
            receiver.queryFramePrepared=true;
        }
        float3 L=normalize(float3(dot(light,receiver.T),dot(light,receiver.B),dot(light,silpomLitFace.normal)));
        return SilPomDirectionalFrameVisibility(L,steps,reach);
    }
#endif
#endif
#if SILPOM_LEVEL_FIVE
    if(silpomLitProxy)return 1.0f; // directional correction reuses the acquired features below
#endif
#if SILPOM_SHARED_VISIBILITY
#if defined(SILPOM_NEURAL_VISIBILITY_ONLY)
    return SilPomSharedVisibilityPrepared(light,steps,reach,params,receiver.sharedReceiver);
#else
    return SilPomSharedVisibility(light,steps,reach,params);
#endif
#elif defined(SILPOM_NEURAL_VISIBILITY_ONLY)
    return SilPomNeuralOnlyVisibilityPrepared(texture,p,face,uv,low,light,steps,reach,SilPomMaterialModel(params),
        SilPomNeuralOnlyThreshold(SilPomMaterialModel(params)),receiver.physical);
#else
    if(o_silpomLocalShadowMethod==SilPomLocalShadowMethod::Baseline)
        return SilPomReliefVisibility(texture,p,face,uv,low,light,steps,reach);
    // NeuralOnly is enabled exclusively on the separately compiled forward
    // shader. An invalid material/shader binding must never start a march.
    if(o_silpomLocalShadowMethod==SilPomLocalShadowMethod::NeuralOnly) return 0;
    return SilPomLearnedReliefVisibility(texture,p,face,uv,low,light,steps,reach,SilPomMaterialModel(params),
        o_silpomLocalShadowMethod==SilPomLocalShadowMethod::Neural,params.m_silpomNeuralShadowConfidence);
#endif
}

void ApplySpiralLightRay(Surface surface, inout LightingData lightingData, MaterialParameters params, float3 ray, float lux SILPOM_RECEIVER_PARAMETER)
{
    if (lux <= 0.0f || dot(ray, SILPOM_LIT_NORMAL) <= 0.0f) return;
    const float rayLength = length(ray);
    const float3 toLight = ray / rayLength;
    const float intensity = lux * rayLength;
    const real3 diffuse = GetDiffuseLighting(surface, lightingData,
        real3(intensity, intensity, intensity), real3(mul(SilPomLitRotationReload(), toLight)));
    if (!any(diffuse > 0.0f)) return;

    const float shadowReach = min(0.30f, 8.0f * abs(params.m_silpomScale));
    const float relief = SILPOM_LIT_LOCAL_VISIBILITY(toLight, params.m_silpomSpiralLightShadowSteps, shadowReach, params);
#if SILPOM_LEVEL_FIVE
    #if SILPOM_DIRECTIONAL_COMPARISON
    float gain=1.0f;
#else
    float gain=silpomLitProxy?
#if defined(SILPOM_NEURAL_VISIBILITY_ONLY)
        SilPomAppearanceLightGainPrepared(toLight,shadowReach,params.m_silpomSpiralLightShadowSteps!=0u,params,receiver.appearance).x:
#else
        SilPomAppearanceLightGain(toLight,shadowReach,params.m_silpomSpiralLightShadowSteps!=0u,params).x:
#endif
        1.0f;
#endif
    lightingData.diffuseLighting += diffuse * relief * gain;
#else
    lightingData.diffuseLighting += diffuse * relief;
#endif
}

void ApplySpiralLight(Surface surface, inout LightingData lightingData, MaterialParameters params SILPOM_RECEIVER_PARAMETER)
{
    const uint windowCount = params.m_silpomSpiralWindowCount;
    if (params.m_silpomSpiralLightBrightness <= 0.0f || (params.m_silpomSpiralLightPeakLux <= 0.0f && windowCount == 0)) return;

    const float4 path = params.m_silpomSpiralLightPath;
    const float3 position = SILPOM_LIT_ORIGIN
        + mul(transpose(SilPomLitRotationReload()), surface.position - silpomLitOriginWS);
    const float2 end = params.m_silpomSpiralLightEnd;
    const float endFade = SilPomSpiralLightGain(position.z,end.x,end.y,params.m_silpomSpiralLightBrightness);
    if (endFade <= 0.0f) return;
    const float radius = length(position.xy);
    if (radius < 1e-4f) return;

    const float twoPi = 6.28318530718f;
    const float2 radial = position.xy / radius;
    const float corridorRadius = length(path.xy);
    const float2 window = path.xy / corridorRadius;
    const float angleTurns = atan2(window.x * radial.y - window.y * radial.x, dot(window, radial)) / twoPi;
    const float heightTurns = (position.z - path.z) / path.w;
    // Blend adjacent spiral turns instead of fading each turn to an unlit seam.
    // The cubic weights and the blended ray bias stay continuous at turn boundaries.
    const float lowerTurn = angleTurns + floor(heightTurns - angleTurns);
    const float upperTurn = lowerTurn + 1.0f;
    const float turnBlend = SilPomSpiralTurnBlend(heightTurns - lowerTurn);
    const float turns = lerp(lowerTurn, upperTurn, turnBlend);

    const float3 tangent = normalize(float3(-radial.y, radial.x, path.w / (twoPi * corridorRadius)));
    // Bias the ray toward the centre of the corridor, consistently across wall facets.
    const float3 offset = float3(radial * (corridorRadius - radius), 0.35f * (path.z + turns * path.w - position.z));
    const float3 towardCorridor = 0.24f * offset / max(length(offset), 0.2f);
    const float firstLower = SilPomSpiralWindowLux(lowerTurn,0.0f,params.m_silpomSpiralLightPeakLux);
    const float firstUpper = SilPomSpiralWindowLux(upperTurn,0.0f,params.m_silpomSpiralLightPeakLux);
    const float lowerBlend = smoothstep(-0.045f,0.045f,lowerTurn);
    const float upperBlend = smoothstep(-0.045f,0.045f,upperTurn);
    float2 lowerLobes = firstLower * float2(1.0f-lowerBlend,lowerBlend);
    float2 upperLobes = firstUpper * float2(1.0f-upperBlend,upperBlend);
    float brightestLower = firstLower;
    float brightestUpper = firstUpper;
    [loop] for (uint i = 0; i < windowCount; ++i)
    {
        const float2 windowLight = asfloat(Bindless::GetByteAddressBuffer(params.m_silpomSpiralWindowBuffer).Load2(i * 8u));
        // One window-buffer fetch supplies both neighboring turns.
        const float luxLower = SilPomSpiralWindowLux(lowerTurn,windowLight.x,windowLight.y);
        const float luxUpper = SilPomSpiralWindowLux(upperTurn,windowLight.x,windowLight.y);
        const float blendLower = smoothstep(-0.045f,0.045f,lowerTurn-windowLight.x);
        const float blendUpper = smoothstep(-0.045f,0.045f,upperTurn-windowLight.x);
        lowerLobes = max(lowerLobes,luxLower*float2(1.0f-blendLower,blendLower));
        upperLobes = max(upperLobes,luxUpper*float2(1.0f-blendUpper,blendUpper));
        brightestLower = max(brightestLower,luxLower);
        brightestUpper = max(brightestUpper,luxUpper);
    }
    // Keep each turn's original non-stacking brightness, then interpolate its
    // directional contributions. This retains the same maximum two shadow rays.
    const float lowerTotal = lowerLobes.x + lowerLobes.y;
    const float upperTotal = upperLobes.x + upperLobes.y;
    if(lowerTotal>0.0f) lowerLobes*=brightestLower/lowerTotal;
    if(upperTotal>0.0f) upperLobes*=brightestUpper/upperTotal;
    const float2 lobes = lerp(lowerLobes,upperLobes,turnBlend);
    if(!any(lobes>0.0f)) return;
    ApplySpiralLightRay(surface, lightingData, params, tangent + towardCorridor, lobes.x * endFade SILPOM_RECEIVER_ARGUMENT);
    ApplySpiralLightRay(surface, lightingData, params, -tangent + towardCorridor, lobes.y * endFade SILPOM_RECEIVER_ARGUMENT);
}

#if SILPOM_FORWARD_SCENE_LIGHTING
// The shadow-casting directional light's visibility at a neural-only hit:
// relief first (the cascaded shadow map is skipped where the relief occludes),
// then the cascade PCF from the flat receiver. The fullscreen shadow result is
// bypassed: its receiver is the displaced camera depth, which can lie below
// the flat caster. The SilPOMHitShadow pass evaluates this per sample.
real SilPomSunVisibility(uint index,float3 position,float3 toLight,float3 baseNormal,float signedHeight,
    uint localSchedule,MaterialParameters params)
{
    real visibility=1;
    if(!o_enableShadows)return visibility;
    if(localSchedule>0u)
        visibility=SILPOM_LIT_LOCAL_VISIBILITY(mul(transpose(SilPomLitRotationReload()),toLight),localSchedule,0.0f,params);
    if(visibility>0)
    {
        const float lightNormalDot=dot(toLight,baseNormal);
        const float advance=SilPomFlatReceiverAdvance(signedHeight,lightNormalDot,1e-4f);
        visibility*=SilPomCascadeShadowVisibility(index,position+toLight*advance,baseNormal,
            SilPomFlatReceiverDerivative(silpomPositionDx,baseNormal,toLight,signedHeight,lightNormalDot,1e-4f),
            SilPomFlatReceiverDerivative(silpomPositionDy,baseNormal,toLight,signedHeight,lightNormalDot,1e-4f));
    }
    return visibility;
}
// Entry for the SilPOMHitShadow pass, after EvaluatePixelGeometry.
float SilPomHitShadowVisibility(float3 position)
{
    const uint index=ViewSrg::m_shadowIndexDirectionalLight;
    if(!silpomLitValid || !o_enableShadows || index>=SceneSrg::m_directionalLightCount)return 1;
    MaterialParameters params=GetMaterialParameters();
    silpomLitShadow=SilPomLitShadowFrame(params);
    const float3 baseNormal=normalize(mul(SilPomLitRotationReload(),SILPOM_LIT_NORMAL));
    const float3 toLight=normalize(-SceneSrg::m_directionalLights[index].m_direction);
    return SilPomSunVisibility(index,position,toLight,baseNormal,dot(position-silpomLitOriginWS,baseNormal),
        params.m_silpomNeuralDirectionalVisibility?16u:0u,params);
}
#endif

void ApplyDirectionalLights(Surface surface,inout LightingData lightingData,float4 screenUv)
{
    if(!silpomLitValid)
    {
#if SILPOM_HIT_FORWARD
        // Exhausted/invalid records are diagnostic samples, with no geometric
        // receiver continuation. Their emissive diagnostic remains visible.
#else
        ApplyDirectionalLights_StandardSilPom(surface,lightingData,screenUv);
#endif
        return;
    }
#if defined(SILPOM_NEURAL_VISIBILITY_ONLY)
    SilPomLightingReceiver receiver;
    SilPomInitLightingReceiver(receiver);
#endif
    MaterialParameters params=GetMaterialParameters();
#if SILPOM_FORWARD_SHADOW_FRAME
    silpomLitShadow=SilPomLitShadowFrame(params);
#endif
    float3 baseNormal=normalize(mul(SilPomLitRotationReload(),SILPOM_LIT_NORMAL));
    float signedHeight=dot(surface.position-silpomLitOriginWS,baseNormal);
    // Spiral first: its state is dead before the directional loop's.
    ApplySpiralLight(surface, lightingData, params SILPOM_RECEIVER_ARGUMENT);
    for(uint index=0;index<SceneSrg::m_directionalLightCount;++index)
    {
        DirectionalLight srgLight=SceneSrg::m_directionalLights[index];
        if(!IsSameLightChannel(srgLight.m_lightingChannelMask,surface.lightingChannels)) continue;
        float3 toLight=normalize(-srgLight.m_direction);
        real visibility=1;
#if ENABLE_SHADOWS
#if defined(SILPOM_NEURAL_VISIBILITY_ONLY)
        // Separate enablement: trained geometry keeps legacy march steps at 0.
        // Descriptor schedule only. Zero maxDistance below means relief-top
        // exit for learned near/shared/proxy lighting, independent of this count.
        const uint localSchedule=
#if SILPOM_LEVEL_FIVE && SILPOM_DIRECTIONAL_COMPARISON
            silpomLitProxy && o_silpomLightingEstimator!=SilPomLightingEstimator::CurrentRouting?0u:
#endif
            params.m_silpomNeuralDirectionalVisibility?16u:0u;
#else
        const uint localSchedule=params.m_silpomReliefShadowSteps;
#endif
#if SILPOM_FORWARD_SCENE_LIGHTING
        if(index==ViewSrg::m_shadowIndexDirectionalLight)
        {
#if SILPOM_HIT_SHADOW_READ
            // Written for this sample by the SilPOMHitShadow pass.
            visibility=o_enableShadows?real(PassSrg::m_silpomHitShadow.Load(silpomHitPixel,silpomHitSampleIndex)):1;
#else
            visibility=SilPomSunVisibility(index,surface.position,toLight,baseNormal,signedHeight,localSchedule,params);
#endif
        }
        else if(o_enableShadows && localSchedule>0u)
            visibility=SILPOM_LIT_LOCAL_VISIBILITY(mul(transpose(SilPomLitRotationReload()),toLight),localSchedule,0.0f,params);
#else
        // Relief before the cascaded shadow map (same product): the cascade
        // coordinates are not live across the relief query, and the shadow
        // map is skipped where the relief occludes.
        if(o_enableShadows && localSchedule>0u)
            visibility=SILPOM_LIT_LOCAL_VISIBILITY(mul(transpose(SilPomLitRotationReload()),toLight),localSchedule,0.0f,params);
        if(o_enableShadows && visibility>0 && index==ViewSrg::m_shadowIndexDirectionalLight)
        {
            const float lightNormalDot=dot(toLight,baseNormal);
            float advance=SilPomFlatReceiverAdvance(signedHeight,lightNormalDot,1e-4f);
            // Bypass the fullscreen shadow result: its receiver is the displaced
            // camera depth, which can lie below our flat caster.
            DirectionalShadowCalculator calc=DirectionalLightShadow::MakeShadowCalculator(
                index,surface.position+toLight*advance,baseNormal);
#if SILPOM_HIT_FORWARD
            calc.SetReceiverDerivatives(
                SilPomFlatReceiverDerivative(silpomPositionDx,baseNormal,toLight,signedHeight,lightNormalDot,1e-4f),
                SilPomFlatReceiverDerivative(silpomPositionDy,baseNormal,toLight,signedHeight,lightNormalDot,1e-4f),
                float3(0,0,0),float3(0,0,0));
#endif
            visibility*=calc.GetVisibility();
        }
#endif
#endif
        DirectionalLightUtil light=DirectionalLightUtil::Init(srgLight,surface);
#if SILPOM_LEVEL_FIVE
        if(silpomLitProxy)
        {
#if SILPOM_DIRECTIONAL_COMPARISON
            if(params.m_silpomProxyDirectionalResponse)
            {
                float2 low=min(silpomLitFace.uv0,min(silpomLitFace.uv1,silpomLitFace.uv2));
                visibility*=SilPomLocalVisibility(GetMaterialTexture(params.m_silpomHeightMap),silpomLitPatch,silpomLitFace,
                    silpomLitUv,low,mul(transpose(SilPomLitRotationReload()),toLight),16u,0.0f,params SILPOM_RECEIVER_ARGUMENT);
            }
#endif
            const real3 beforeDiffuse=lightingData.diffuseLighting;
            real3 beforeSpecular[MAX_SHADING_VIEWS];
            SP_UNROLL for(uint view=0;view<MAX_SHADING_VIEWS;++view)beforeSpecular[view]=lightingData.specularLighting[view];
            light.Apply(srgLight,surface,visibility,lightingData);
            // Joint V*BRDF response has its own control, independent of both
            // the legacy sample count and external scene-shadow enablement.
#if SILPOM_DIRECTIONAL_COMPARISON
            const float2 gain=float2(1,1);
#else
            const float2 gain=
#if defined(SILPOM_NEURAL_VISIBILITY_ONLY)
                SilPomAppearanceLightGainPrepared(mul(transpose(SilPomLitRotationReload()),toLight),0.0f,params.m_silpomProxyDirectionalResponse,params,receiver.appearance);
#else
                SilPomAppearanceLightGain(mul(transpose(SilPomLitRotationReload()),toLight),0.0f,params.m_silpomProxyDirectionalResponse,params);
#endif
#endif
            lightingData.diffuseLighting=beforeDiffuse+(lightingData.diffuseLighting-beforeDiffuse)*gain.x;
            SP_UNROLL for(uint view=0;view<MAX_SHADING_VIEWS;++view)
                lightingData.specularLighting[view]=beforeSpecular[view]+(lightingData.specularLighting[view]-beforeSpecular[view])*gain.y;
        }
        else
#endif
        light.Apply(srgLight,surface,visibility,lightingData);
    }
}
#undef SILPOM_LIT_NORMAL
#undef SILPOM_LIT_ORIGIN
#undef SILPOM_LIT_LOCAL_VISIBILITY
#undef SILPOM_RECEIVER_PARAMETER
#undef SILPOM_RECEIVER_ARGUMENT
