#pragma once
// Keep the engine's light/BRDF implementation, replacing only directional
// visibility. Other lighting, IBL and emissive are evaluated normally.
#define ApplyDirectionalLights ApplyDirectionalLights_StandardSilPom
#include <Atom/Features/Pipeline/Forward/ForwardPassDirectionalLights.azsli>
#undef ApplyDirectionalLights
float SilPomLocalVisibility(Texture2D texture,SilPomPatch p,SilPomMeshFace face,float2 uv,float2 low,
    float3 light,uint steps,float reach,MaterialParameters params)
{
    if(o_silpomLocalShadowMethod==SilPomLocalShadowMethod::Baseline)
        return SilPomReliefVisibility(texture,p,face,uv,low,light,steps,reach);
    return SilPomLearnedReliefVisibility(texture,p,face,uv,low,light,steps,reach,params.m_silpomNeuralModel,
        o_silpomLocalShadowMethod==SilPomLocalShadowMethod::Neural,params.m_silpomNeuralShadowConfidence);
}

void ApplySpiralLightRay(Surface surface, inout LightingData lightingData, MaterialParameters params, float3 ray, float lux)
{
    if (lux <= 0.0f || dot(ray, silpomLitFace.normal) <= 0.0f) return;
    const float rayLength = length(ray);
    const float3 toLight = ray / rayLength;
    const float intensity = lux * rayLength;
    const real3 diffuse = GetDiffuseLighting(surface, lightingData,
        real3(intensity, intensity, intensity), real3(mul(silpomLitRotation, toLight)));
    if (!any(diffuse > 0.0f)) return;

    const float2 low = min(silpomLitFace.uv0, min(silpomLitFace.uv1, silpomLitFace.uv2));
    const float shadowReach = min(0.30f, 8.0f * abs(silpomLitPatch.scale));
    const float relief = SilPomLocalVisibility(GetMaterialTexture(params.m_silpomHeightMap),
        silpomLitPatch, silpomLitFace, silpomLitUv, low, toLight, params.m_silpomSpiralLightShadowSteps, shadowReach,params);
    lightingData.diffuseLighting += diffuse * relief;
}

void ApplySpiralLight(Surface surface, inout LightingData lightingData, MaterialParameters params)
{
    const uint windowCount = params.m_silpomSpiralWindowCount;
    if (params.m_silpomSpiralLightBrightness <= 0.0f || (params.m_silpomSpiralLightPeakLux <= 0.0f && windowCount == 0)) return;

    const float4 path = params.m_silpomSpiralLightPath;
    const float3 position = silpomLitFace.origin
        + mul(transpose(silpomLitRotation), surface.position - silpomLitOriginWS);
    const float2 end = params.m_silpomSpiralLightEnd;
    const float endFade = SilPomSpiralLightGain(position.z,end.x,end.y,params.m_silpomSpiralLightBrightness);
    if (endFade <= 0.0f) return;
    const float radius = length(position.xy);
    if (radius < 1e-4f) return;

    const float twoPi = 6.28318530718f;
    const float2 radial = position.xy / radius;
    const float corridorRadius = length(path.xy);
    const float2 window = path.xy / corridorRadius;
    const float angleTurns = atan2(window.x * radial.y - window.y * radial.x, dot(window, radial)) / twoPi;
    const float heightTurns = (position.z - path.z) / path.w;
    // Blend adjacent spiral turns instead of fading each turn to an unlit seam.
    // The cubic weights and the blended ray bias stay continuous at turn boundaries.
    const float lowerTurn = angleTurns + floor(heightTurns - angleTurns);
    const float upperTurn = lowerTurn + 1.0f;
    const float turnBlend = SilPomSpiralTurnBlend(heightTurns - lowerTurn);
    const float turns = lerp(lowerTurn, upperTurn, turnBlend);

    const float3 tangent = normalize(float3(-radial.y, radial.x, path.w / (twoPi * corridorRadius)));
    // Bias the ray toward the centre of the corridor, consistently across wall facets.
    const float3 offset = float3(radial * (corridorRadius - radius), 0.35f * (path.z + turns * path.w - position.z));
    const float3 towardCorridor = 0.24f * offset / max(length(offset), 0.2f);
    const float firstLower = SilPomSpiralWindowLux(lowerTurn,0.0f,params.m_silpomSpiralLightPeakLux);
    const float firstUpper = SilPomSpiralWindowLux(upperTurn,0.0f,params.m_silpomSpiralLightPeakLux);
    const float lowerBlend = smoothstep(-0.045f,0.045f,lowerTurn);
    const float upperBlend = smoothstep(-0.045f,0.045f,upperTurn);
    float2 lowerLobes = firstLower * float2(1.0f-lowerBlend,lowerBlend);
    float2 upperLobes = firstUpper * float2(1.0f-upperBlend,upperBlend);
    float brightestLower = firstLower;
    float brightestUpper = firstUpper;
    [loop] for (uint i = 0; i < windowCount; ++i)
    {
        const float2 windowLight = asfloat(Bindless::GetByteAddressBuffer(params.m_silpomSpiralWindowBuffer).Load2(i * 8u));
        // One window-buffer fetch supplies both neighboring turns.
        const float luxLower = SilPomSpiralWindowLux(lowerTurn,windowLight.x,windowLight.y);
        const float luxUpper = SilPomSpiralWindowLux(upperTurn,windowLight.x,windowLight.y);
        const float blendLower = smoothstep(-0.045f,0.045f,lowerTurn-windowLight.x);
        const float blendUpper = smoothstep(-0.045f,0.045f,upperTurn-windowLight.x);
        lowerLobes = max(lowerLobes,luxLower*float2(1.0f-blendLower,blendLower));
        upperLobes = max(upperLobes,luxUpper*float2(1.0f-blendUpper,blendUpper));
        brightestLower = max(brightestLower,luxLower);
        brightestUpper = max(brightestUpper,luxUpper);
    }
    // Keep each turn's original non-stacking brightness, then interpolate its
    // directional contributions. This retains the same maximum two shadow rays.
    const float lowerTotal = lowerLobes.x + lowerLobes.y;
    const float upperTotal = upperLobes.x + upperLobes.y;
    if(lowerTotal>0.0f) lowerLobes*=brightestLower/lowerTotal;
    if(upperTotal>0.0f) upperLobes*=brightestUpper/upperTotal;
    const float2 lobes = lerp(lowerLobes,upperLobes,turnBlend);
    if(!any(lobes>0.0f)) return;
    ApplySpiralLightRay(surface, lightingData, params, tangent + towardCorridor, lobes.x * endFade);
    ApplySpiralLightRay(surface, lightingData, params, -tangent + towardCorridor, lobes.y * endFade);
}

void ApplyDirectionalLights(Surface surface,inout LightingData lightingData,float4 screenUv)
{
    if(!silpomLitValid)
    {
        ApplyDirectionalLights_StandardSilPom(surface,lightingData,screenUv);
        return;
    }
    MaterialParameters params=GetMaterialParameters();
    float3 baseNormal=normalize(mul(silpomLitRotation,silpomLitFace.normal));
    float signedHeight=dot(surface.position-silpomLitOriginWS,baseNormal);
    for(uint index=0;index<SceneSrg::m_directionalLightCount;++index)
    {
        DirectionalLight srgLight=SceneSrg::m_directionalLights[index];
        if(!IsSameLightChannel(srgLight.m_lightingChannelMask,surface.lightingChannels)) continue;
        float3 toLight=normalize(-srgLight.m_direction);
        real visibility=1;
#if ENABLE_SHADOWS
        if(o_enableShadows && index==ViewSrg::m_shadowIndexDirectionalLight)
        {
            float advance=SilPomFlatReceiverAdvance(signedHeight,dot(toLight,baseNormal),1e-4f);
            // Bypass the fullscreen shadow result: its receiver is the displaced
            // camera depth, which can lie below our flat caster.
            DirectionalShadowCalculator calc=DirectionalLightShadow::MakeShadowCalculator(
                index,surface.position+toLight*advance,baseNormal);
            visibility=calc.GetVisibility();
        }
        if(o_enableShadows && params.m_silpomReliefShadowSteps>0 && visibility>0)
        {
            float2 low=min(silpomLitFace.uv0,min(silpomLitFace.uv1,silpomLitFace.uv2));
            visibility*=SilPomLocalVisibility(GetMaterialTexture(params.m_silpomHeightMap),
                silpomLitPatch,silpomLitFace,silpomLitUv,low,
                mul(transpose(silpomLitRotation),toLight),params.m_silpomReliefShadowSteps,0.0f,params);
        }
#endif
        DirectionalLightUtil light=DirectionalLightUtil::Init(srgLight,surface);
        light.Apply(srgLight,surface,visibility,lightingData);
    }
    ApplySpiralLight(surface, lightingData, params);
}
