#pragma once
#define SILPOM_HIT_DEPTH 1
#define SILPOM_FACE_CACHE_PASS 1
// Application-owned; follows Atom's actual sample count. Default preserves
// center SV_Position depth exactly on the established 1x route.
option bool o_silpomSampleFrequency=false;
#include <Atom/Features/SrgSemantics.azsli>

#define MATERIALPIPELINE_SHADER_HAS_GEOMETRIC_PIXEL_STAGE 1
// Depth has a viewport SRG but none of the forward lighting bindings selected
// by this StandardPBR flag. Declare the viewport SRG explicitly below.
#define PIPELINE_HAS_PASS_SRG 0

//////////////////////////////////////////////////////////////////////////////////////////////////

#ifdef MATERIAL_TYPE_DEFINES_AZSLI_FILE_PATH
#include MATERIAL_TYPE_DEFINES_AZSLI_FILE_PATH
#endif

//////////////////////////////////////////////////////////////////////////////////////////////////

#include <viewsrg_all.srgi>
#include <scenesrg_all.srgi>
#include "../../../Shaders/SilPOM/HitReuse/SilPOMHitDepthSrg.azsli"
#include <Atom/Features/Pipeline/Forward/ForwardPassVertexData.azsli>
#include <Atom/Features/Pipeline/Forward/ForwardPassPipelineCallbacks.azsli>

//////////////////////////////////////////////////////////////////////////////////////////////////

#include MATERIAL_TYPE_AZSLI_FILE_PATH
#include "../../../Shaders/SilPOM/HitReuse/SilPOMHitRecord.azsli"
#include "../../../Shaders/SilPOM/GradientContext.azsli"

//////////////////////////////////////////////////////////////////////////////////////////////////
struct PsOutput
{
    // Implicit hits are behind their constant raster bound. A shell plane's
    // sample depth can be nearer than its pixel-center raster depth, so its
    // MSAA variant must not promise the conservative pixel-center constraint.
#if SILPOM_MSAA_PLANE_DEPTH
    precise float m_depth : SV_Depth;
#else
    precise float m_depth : SV_DepthLessEqual;
#endif
    uint4 m_hit : SV_Target0;
    float4 m_uvGradients : SV_Target1;
    float4 m_depthGradients : SV_Target2;
};

#if SILPOM_RELIEF_LOD_SHELL
struct SilPomShellVertex
{
    float4 position : SV_Position;
    sample float2 uv : TEXCOORD0;
    nointerpolation uint face : TEXCOORD1;
    noperspective sample float rasterDepth : TEXCOORD2;
    nointerpolation uint instance : TEXCOORD3;
};

SilPomShellVertex VertexShader(VsInput IN, uint instanceId : SV_InstanceID)
{
    SilPomShellVertex output=(SilPomShellVertex)0;
    output.position=float4(2,2,0,1);
    VsSystemValues sv;
    sv.m_instanceId=instanceId;
    const MaterialParameters params=GetMaterialParameters();
#if SILPOM_WALL_BACKUP_SHELL
    if(SilPomProxySelected(params,uint(round(IN.position.z))))return output;
#else
    if(params.m_silpomProxyLodEnabled)return output;
#endif
#if SILPOM_WALL_BACKUP_SHELL
    // The opening trim and doorway reveal need the same inset coverage
    // when a neural hit is missed along a triangle edge.
    const bool isOpeningSurface=params.m_silpomProfileRole==SP_ROLE_OPENING;
    if((params.m_silpomProfileRole!=SP_ROLE_WALL && !isOpeningSurface)
        || params.m_silpomReliefMode!=SP_RELIEF_LOD_4PX_RESOLVE)
        return output;
#endif
    const SilPomMeshFace face=SilPomLoadFace(params.m_meshBufferIndex,uint(round(IN.position.z)),params.m_silpomFaceCoefficientBuffer);
    const float4x4 localToWorld=GetObjectToWorldMatrix(sv);
    const float4x4 localToClip=mul(GetViewProjectionMatrix(sv),localToWorld);
    const float cutoff=SilPomReliefLodDepth(params);
#if SILPOM_WALL_BACKUP_SHELL
    const float3 toCamera=ViewSrg::m_worldPosition.xyz-mul(localToWorld,float4(face.origin,1)).xyz;
    if(dot(mul((float3x3)localToWorld,face.normal),toCamera)<=0.0f)
        return output;

    // Use the bottom of the same displacement volume as the neural pass.
    // The shared corner directions keep the inset continuous at welded edges.
    const float height=min(0.0f,min(-params.m_silpomScale*params.m_silpomReference,
        params.m_silpomScale*(1.0f-params.m_silpomReference)));
    const float3 directions[3]={face.d0,face.d1,face.d2};
#else
    const float limit=cutoff>0 ? cutoff-SilPomReliefLodOverlap(params) : -1e20f;
#endif
    const float2 uv[3]={face.uv0,face.uv1,face.uv2};
    float4 corners[3];
    for(uint i=0;i<3;++i)
    {
        const float2 offset=uv[i]-face.uv0;
        float3 vertex=face.origin+face.du*offset.x+face.dv*offset.y;
#if SILPOM_WALL_BACKUP_SHELL
        vertex+=directions[i]*height;
#endif
        corners[i]=mul(localToClip,float4(vertex,1));
    }
    // A single plane clips the authored triangle to at most four vertices.
    float4 poly[4];
    float2 polyUv[4];
    uint count=0;
    for(uint i=0;i<3;++i)
    {
        const uint previous=(i+2)%3;
#if SILPOM_WALL_BACKUP_SHELL
        const float a=cutoff-corners[previous].w;
        const float b=cutoff-corners[i].w;
#else
        const float a=corners[previous].w-limit;
        const float b=corners[i].w-limit;
#endif
        if((a<0)!=(b<0))
        {
            const float t=a/(a-b);
            poly[count]=lerp(corners[previous],corners[i],t);
            polyUv[count++]=lerp(uv[previous],uv[i],t);
        }
        if(b>=0)
        {
            poly[count]=corners[i];
            polyUv[count++]=uv[i];
        }
    }
    if(count<3) return output;
    // The existing proxy indices are (0,1,2), (2,1,3).
    const uint corner=IN.position.y>0 ? (IN.position.x>0 ? 2u : count-1u) : uint(IN.position.x>0);
    output.position=poly[corner];
    output.rasterDepth=output.position.z/output.position.w;
    output.uv=polyUv[corner];
    output.face=params.m_silpomHitFaceBase+uint(round(IN.position.z));
    output.instance=instanceId;
    if(params.m_silpomProfileRole==SP_ROLE_WALL) output.face|=SP_HIT_RECORD_WALL;
    return output;
}

uint4 ShellHit(SilPomShellVertex IN)
{
    // SV_Position.z is center-interpolated. Preserve its established 1x
    // result; the sample-interpolated plane depth is required for MSAA.
    if(o_silpomSampleFrequency)IN.position.z=IN.rasterDepth;
    const uint flags=SP_HIT_RECORD_SHELL|(IN.face&SP_HIT_RECORD_WALL);
    return uint4(asuint(IN.uv),asuint(IN.position.z)|flags,(IN.face<<2)|SP_HIT);
}

SilPomGradientContext SilPomShellGradient(SilPomShellVertex IN)
{
    const MaterialParameters params=GetMaterialParameters();
    const uint faceIndex=(IN.face&~SP_HIT_RECORD_WALL)-params.m_silpomHitFaceBase;
    const SilPomMeshFace face=SilPomLoadFace(params.m_meshBufferIndex,faceIndex,params.m_silpomFaceCoefficientBuffer);
    const float2 q=IN.uv-face.uv0;
#if SILPOM_WALL_BACKUP_SHELL
    const float height=min(0.0f,min(-params.m_silpomScale*params.m_silpomReference,
        params.m_silpomScale*(1.0f-params.m_silpomReference)));
    const uint representation=SP_GRADIENT_BACKUP;
#else
    const float height=0;
    const uint representation=SP_GRADIENT_SHELL;
#endif
    const float2 coarseSpan=max(max(face.uv0,max(face.uv1,face.uv2))-min(face.uv0,min(face.uv1,face.uv2)),
        rcp(max(abs(float2(params.m_silpomTileU,params.m_silpomTileV)),1e-20f)));
    float3 dU,dV;
    if(!SilPomFaceGradientDirectionPartials(face,dU,dV))
        return SilPomGradientCoarse(coarseSpan,representation);
    const float3 direction=face.d0+dU*q.x+dV*q.y;
    const float3 position=face.origin+face.du*q.x+face.dv*q.y+direction*height;
    VsSystemValues sv;sv.m_instanceId=IN.instance;
    const float4x4 localToClip=mul(GetViewProjectionMatrix(sv),GetObjectToWorldMatrix(sv));
    return SilPomGradientFromTangents(mul(localToClip,float4(position,1)),
        mul(localToClip,float4(face.du+dU*height,0)),mul(localToClip,float4(face.dv+dV*height,0)),
        PassSrg::m_silpomViewport.zw,coarseSpan,representation);
}

#if SILPOM_WALL_BACKUP_SHELL && SILPOM_WALL_BACKUP_PREPASS
// Depth-only pre-pass: the wall-backup shell's own raster depth, drawn before
// SilPOMHitDepth. The visible relief is never behind the nearest bottom shell
// (a ray from outside crosses the relief to reach it), so early depth testing
// rejects hidden relief fragments regardless of draw order. The backup later
// draws the same vertices with GreaterEqual, so every pixel the hit, repair
// and fill passes leave at this depth still receives a backup record.
// Vertex-only, like Atom's DepthPass: no fragment entry, no output contract.
#elif SILPOM_WALL_BACKUP_SHELL
struct SilPomWallBackupOutput
{
    uint4 hit : SV_Target0;
    float4 uvGradients : SV_Target1;
    float4 depthGradients : SV_Target2;
    // The published depth is the fragment's own raster depth (record depth
    // bits clear none of a [0,1] float's bits), so at 1x it can promise the
    // conservative bound. Early depth testing then rejects the shell under
    // every neural hit before the shader runs, instead of after it. Under
    // MSAA the sample-interpolated depth may round past the raster sample's.
#if SILPOM_MSAA_PLANE_DEPTH
    precise float depth : SV_Depth;
#else
    precise float depth : SV_DepthLessEqual;
#endif
};
SilPomWallBackupOutput PixelShader(SilPomShellVertex IN)
{
    SilPomWallBackupOutput output;
    output.hit=ShellHit(IN);
    const SilPomGradientContext gradients=SilPomShellGradient(IN);
    output.uvGradients=gradients.uv;
    output.depthGradients=SilPomGradientPackDepth(gradients);
    // Hardware raster depth can round differently from the interpolated
    // sample depth recorded by ShellHit. Publish one identical value to both
    // targets, or the depth-equal forward pass leaves covered samples black.
    output.depth=asfloat(output.hit.z&SP_HIT_RECORD_DEPTH);
    return output;
}
#else
PsOutput PixelShader(SilPomShellVertex IN,uint sampleIndex:SV_SampleIndex)
{
    PsOutput output;
    output.m_depth=o_silpomSampleFrequency?IN.rasterDepth:IN.position.z;
    // The reverse clip depth is nonnegative. Flag shell winners for the capture.
    output.m_hit=ShellHit(IN);
    const SilPomGradientContext gradients=SilPomShellGradient(IN);
    output.m_uvGradients=gradients.uv;
    output.m_depthGradients=SilPomGradientPackDepth(gradients);
    return output;
}
#endif
#else
#include "../../../Shaders/SilPOM/FrustumDepthBound.azsli"
float SilPomNearestFaceDepth(SilPomMeshFace face, VsSystemValues systemValues, const MaterialParameters params)
{
    return SilPomImplicitNearestDepth(face,params.m_silpomScale,params.m_silpomReference,
        GetObjectToWorldMatrix(systemValues),GetViewProjectionMatrix(systemValues));
}

VsOutput VertexShader(VsInput IN, uint instanceId : SV_InstanceID)
{
    VsSystemValues SV;
    SV.m_instanceId = instanceId;
#if SILPOM_MSAA_STATIC_WALL
    MaterialParameters params = GetMaterialParameters();
    params.m_silpomNeuralModel=4u;params.m_silpomProfileRole=SP_ROLE_WALL;
#else
    const MaterialParameters params = GetMaterialParameters();
#endif
    VsOutput OUT;
#if SILPOM_RELIEF_LOD_NEAR
    float cachedDepth;
    if(SilPomTryCachedImplicitVertex(IN,params,GetObjectToWorldMatrix(SV),OUT,cachedDepth))
    {
        OUT.position.z=cachedDepth;OUT.m_instanceId=instanceId;
        return OUT;
    }
#endif
    OUT=EvaluateVertexGeometry(IN,SV,params);
    const SilPomMeshFace face = SilPomLoadFace(params.m_meshBufferIndex,OUT.faceIndex,params.m_silpomFaceCoefficientBuffer);
    OUT.position.z = SilPomNearestFaceDepth(face, SV, params);
    OUT.m_instanceId = instanceId;
    return OUT;
}

PsOutput PixelShader(VsOutput IN, bool isFrontFace : SV_IsFrontFace,uint sampleIndex:SV_SampleIndex)
{
    // ------- Reconstruct the Instance-Id --------
    VsSystemValues SV;
    SV.m_instanceId = IN.m_instanceId;

#if SILPOM_MSAA_STATIC_WALL
    MaterialParameters params = GetMaterialParameters();
    params.m_silpomNeuralModel=4u;params.m_silpomProfileRole=SP_ROLE_WALL;
#else
    const MaterialParameters params = GetMaterialParameters();
#endif
    PixelGeometryData geoData = EvaluatePixelGeometry(IN, SV, isFrontFace, params);

    // Pixel clipping can be done here
    EvaluateSurface(IN, SV, geoData, params);

    PsOutput OUT;
    OUT.m_depth = IN.position.z;
    const uint flags = params.m_silpomProfileRole==SP_ROLE_WALL ? SP_HIT_RECORD_WALL : 0u;
    OUT.m_hit = uint4(asuint(silpomDepthHitUv), asuint(IN.position.z)|flags,
        ((params.m_silpomHitFaceBase + IN.faceIndex) << 2) | uint(IN.silpomDiagnostic.x));
    OUT.m_uvGradients=silpomDepthUvGradients;
    OUT.m_depthGradients=silpomDepthDepthGradients;

    return OUT;
}
#endif
