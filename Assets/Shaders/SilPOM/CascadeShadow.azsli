#pragma once
// Directional cascaded shadow visibility for SilPOM's forward receiver, with
// the decisions of Atom's DirectionalShadowCalculator (cascade range, PCF with
// cascade blending, ESM, ESM+PCF, receiver-plane depth bias from explicit
// receiver derivatives) but no per-cascade arrays. Atom keeps the coordinates
// and derivatives of every cascade in float3[MaxCascadeCount] members indexed
// by the selected cascade; gfx90c places those in an indexed register block
// and scratch. Here each cascade's coordinate is recomputed where it is used
// (two matrix products). SilPOM's receiver normal derivatives are zero.
struct SilPomCascadeCoordinate
{
    float3 coord,dx,dy;
};
SilPomCascadeCoordinate SilPomCascadeAt(uint lightIndex,int cascade,float3 receiver,
    float3 positionDx,float3 positionDy)
{
    const float4x4 toLightView=ViewSrg::m_directionalLightShadows[lightIndex].m_worldToLightViewMatrices[cascade];
    float4 lightSpace=mul(toLightView,float4(receiver,1.));
    const float4 lightDx=mul(toLightView,float4(positionDx,0));
    const float4 lightDy=mul(toLightView,float4(positionDy,0));
    lightSpace.z+=ViewSrg::m_directionalLightShadows[lightIndex].m_shadowBias;
    // Load the second matrix only after the first products: its index depends
    // on them (lightSpace.w is never this NaN pattern). Otherwise the compiler
    // issues all eight matrix rows at once, 32 registers in flight on gfx90c.
    const int shadowmapCascade=asuint(lightSpace.w)==0xFFFFFFFFu?0:cascade;
    const float4x4 toShadowmap=ViewSrg::m_directionalLightShadows[lightIndex].m_lightViewToShadowmapMatrices[shadowmapCascade];
    const float4 clip=mul(toShadowmap,lightSpace);
    SilPomCascadeCoordinate c;
    c.coord=clip.xyz/clip.w;
    const float4 clipDx=mul(toShadowmap,lightDx);
    const float4 clipDy=mul(toShadowmap,lightDy);
    c.dx=(clipDx.xyz-c.coord*clipDx.w)/clip.w;
    c.dy=(clipDy.xyz-c.coord*clipDy.w)/clip.w;
    return c;
}
// Atom's 16-tap bicubic PCF (same offsets, weights and receiver-plane bias),
// evaluated four taps per iteration. Atom's fully unrolled version keeps all 16
// compare samples, their coordinates and depths in flight at once; the trip
// count is laundered through the map size so the compiler cannot unroll it.
real SilPomCascadePcf16(SampleShadowMapBicubicParameters param)
{
    const real2 shadowXY=param.shadowPos.xy*param.shadowMapSize+real2(0.5,0.5);
    const real2 shadowUV=floor(shadowXY);
    const real2 f=shadowXY-shadowUV;
    const real2 texelCenter=(shadowUV-real2(0.5,0.5))*param.invShadowMapSize;
    const real2 w0=5.0*f-6.0,w1=11.0*f-28.0,w2=-(11.0*f+17.0),w3=-(5.0*f+1.0);
    const real2 o0=((4.0*f-5.0)/w0)-3.0,o1=((4.0*f-16.0)/w1)-1.0,o2=-((7.0*f+5.0)/w2)+1.0,o3=-(f/w3)+3.0;
    real shadow=0;
    const uint rows=asuint(float(param.shadowMapSize))==0xFFFFFFFFu?0u:4u;
    [loop] for(uint row=0u;row<rows;++row)
    {
        const real wy=row==0u?w0.y:row==1u?w1.y:row==2u?w2.y:w3.y;
        const real oy=row==0u?o0.y:row==1u?o1.y:row==2u?o2.y:o3.y;
        [unroll] for(uint column=0u;column<4u;++column)
        {
            const real wx=column==0u?w0.x:column==1u?w1.x:column==2u?w2.x:w3.x;
            const real ox=column==0u?o0.x:column==1u?o1.x:column==2u?o2.x:o3.x;
            const real2 offset=real2(ox,oy)*param.invShadowMapSize;
            const real depth=min(param.comparisonValue+ApplyReceiverPlaneDepthBias(real2(param.receiverPlaneDepthBias),offset),DepthMargin);
            shadow+=wx*wy*real(param.shadowMap.SampleCmpLevelZero(param.samplerState,real3(texelCenter+offset,param.shadowPos.z),depth));
        }
    }
    shadow/=2704;
    return shadow*shadow;
}
real SilPomCascadePcf(uint lightIndex,int cascade,SilPomCascadeCoordinate c,uint size)
{
    SampleShadowMapBicubicParameters param;
    param.shadowMap=PassSrg::m_directionalLightShadowmap;
    param.shadowPos=float3(c.coord.xy,cascade);
    param.shadowMapSize=real(size);
    param.invShadowMapSize=rcp(real(size));
    param.comparisonValue=c.coord.z;
    param.samplerState=SceneSrg::m_hwPcfSampler;
    param.receiverPlaneDepthBias=o_directional_shadow_receiver_plane_bias_enable?ComputeReceiverPlaneDepthBias(c.dx,c.dy):0;
    switch(o_directional_shadow_filtering_sample_count)
    {
        case ShadowFilterSampleCount::PcfTap4: return SampleShadowMapBicubic_4Tap(param);
        case ShadowFilterSampleCount::PcfTap9: return SampleShadowMapBicubic_9Tap(param);
        default: return SilPomCascadePcf16(param);
    }
}
real SilPomCascadeShadowVisibility(uint lightIndex,float3 worldPos,real3 worldNormal,
    float3 positionDx,float3 positionDy)
{
    const uint size=ViewSrg::m_directionalLightShadows[lightIndex].m_shadowmapSize;
    const int count=min(ViewSrg::m_directionalLightShadows[lightIndex].m_cascadeCount,ViewSrg::MaxCascadeCount);
    const float3 receiver=worldPos+ComputeNormalShadowOffset(
        ViewSrg::m_directionalLightShadows[lightIndex].m_normalShadowBias,worldNormal,size);
    // Cascade range, as DirectionalShadowCalculator::GetShadowCascadeRange.
    const float xyMax=size-PIXEL_MARGIN,xyMin=PIXEL_MARGIN;
    int minCascade=-1,maxCascade=-1;
    for(int index=0;index<count;++index)
    {
        const float2 xy=SilPomCascadeAt(lightIndex,index,receiver,positionDx,positionDy).coord.xy*real(size);
        if(all(xy>=xyMin) && all(xy<=xyMax))
        {
            minCascade=index;
            while(index<count && SilPomCascadeAt(lightIndex,index,receiver,positionDx,positionDy).coord.z>(1.0-DEPTH_MARGIN))
                ++index;
            // Atom can leave the maximum one past the last cascade; keep it in range.
            maxCascade=min(index,count-1);
            break;
        }
    }
    [branch] if(maxCascade<0)return 1.0;
    switch(o_directional_shadow_filtering_method)
    {
        case ShadowFilterMethod::None:
        {
            for(int cascade=minCascade;cascade<=maxCascade;++cascade)
            {
                const float3 coord=SilPomCascadeAt(lightIndex,cascade,receiver,positionDx,positionDy).coord;
                const float depth=PassSrg::m_directionalLightShadowmap.SampleLevel(PassSrg::PointSampler,float3(coord.xy,cascade),0).r;
                if(depth!=1.0 && coord.z-depth>0)return 0.0;
            }
            return 1.0;
        }
        case ShadowFilterMethod::Pcf:
        {
            real lit=1.0;
            for(int cascade=minCascade;cascade<=maxCascade && lit>0.01;++cascade)
                lit=min(lit,SilPomCascadePcf(lightIndex,cascade,SilPomCascadeAt(lightIndex,cascade,receiver,positionDx,positionDy),size));
            if(o_blend_between_cascades_enable)
            {
                const real3 texCoord=real3(SilPomCascadeAt(lightIndex,maxCascade,receiver,positionDx,positionDy).coord);
                const real blend=min(min(texCoord.x,texCoord.y),min3(1.0-texCoord))/0.015;
                const int next=maxCascade+1;
                [branch] if(blend<1.0f && next<count)
                    lit=lerp(SilPomCascadePcf(lightIndex,next,SilPomCascadeAt(lightIndex,next,receiver,positionDx,positionDy),size),lit,blend);
            }
            return lit;
        }
        default: // Esm, EsmPcf
        {
            for(int cascade=minCascade;cascade<=maxCascade;++cascade)
            {
                const SilPomCascadeCoordinate c=SilPomCascadeAt(lightIndex,cascade,receiver,positionDx,positionDy);
                const float distanceMin=ViewSrg::m_esmsDirectional[cascade].m_lightDistanceOfCameraViewFrustum;
                const float depthDiff=c.coord.z-distanceMin;
                [branch] if(depthDiff>=0)
                {
                    const float within=depthDiff/(1.-distanceMin);
                    const float occluder=PassSrg::m_directionalLightExponentialShadowmap.SampleLevel(
                        PassSrg::LinearSampler,float3(c.coord.xy,cascade),0).r;
                    if(occluder<ESM_CASCADE_MARGIN)
                    {
                        float ratio=exp(-EsmExponentialShift*(within-occluder));
                        if(o_directional_shadow_filtering_method==ShadowFilterMethod::EsmPcf && ratio>1.04)
                            ratio=SilPomCascadePcf(lightIndex,cascade,c,size);
                        return saturate(ratio);
                    }
                }
            }
            return 1.0;
        }
    }
}
