#pragma once
// Restricted extension for planar base triangles with generated corner normals.
// D(u,v) is AFFINE, not normalized after interpolation: this keeps the six
// displaced corner extrema conservative, and makes shared edges identical.
#include "MeshFace.azsli"
#if SILPOM_FACE_COEFFICIENT_CACHE
#include "FaceCoefficients.azsli"
#endif
#include "Quality.azsli"
#include "EvaluationHooks.azsli"
#if !defined(SILPOM_CPU) && defined(SILPOM_VALIDATION_GATHER)
#include "ValidationHeight.azsli"
#endif
// A planar seed need not intersect the deformed surface. Newton rejection is
// not traversal-budget exhaustion and must not be published as diagnostic
// geometry at the bounding-box entry point.
static const uint SP_REFINE_REJECTED=4;
// No-march relief modes use the learned candidate with either coverage proxy.
#include "ReliefMode.azsli"
static const float SP_TOWER_MAX_FILL_INCIDENCE=.20f;
float SilPomUvArea(SilPomMeshFace f)
{
#if SILPOM_FACE_COEFFICIENT_CACHE
    float cachedArea;
    if(SilPomTryFaceCoefficientArea(f,cachedArea))return cachedArea;
#endif
    return (f.uv1.x-f.uv0.x)*(f.uv2.y-f.uv0.y)-(f.uv1.y-f.uv0.y)*(f.uv2.x-f.uv0.x);
}
float3 SilPomFaceWeights(SilPomMeshFace f, float2 uv)
{
#if SILPOM_FACE_COEFFICIENT_CACHE
    // Keep this denominator in its original expression graph. A conditional
    // cached-area load can alter reciprocal CSE/contraction inside Newton even
    // when the stored area bits match; full stored-vs-inline GPU tests guard it.
    float area=SilPomFaceUncachedUvArea(f);
#else
    float area=SilPomUvArea(f);
#endif
    float b=((uv.x-f.uv0.x)*(f.uv2.y-f.uv0.y)-(uv.y-f.uv0.y)*(f.uv2.x-f.uv0.x))/area;
    float c=((f.uv1.x-f.uv0.x)*(uv.y-f.uv0.y)-(f.uv1.y-f.uv0.y)*(uv.x-f.uv0.x))/area;
    return float3(1-b-c,b,c);
}
float3 SilPomFaceDirection(SilPomMeshFace f, float2 uv)
{
    float3 w=SilPomFaceWeights(f,uv);
    return f.d0*w.x+f.d1*w.y+f.d2*w.z;
}
// Returns height and derivatives in SOURCE UV coordinates.
float3 SilPomFaceHeight(SP_TEX texture, SilPomPatch p, float2 uv, float2 low)
{
    float u=(uv.x-low.x)*p.tileU/p.width+p.offsetU;
    float v=(uv.y-low.y)*p.tileV/p.height+p.offsetV;
    float x=u*p.textureWidth-.5f,y=v*p.textureHeight-.5f;
    int ix=int(floor(x)),iy=int(floor(y)); float fx=x-floor(x),fy=y-floor(y);
    float a=SilPomTexel(texture,p,ix,iy),b=SilPomTexel(texture,p,ix+1,iy)-a;
    float c=SilPomTexel(texture,p,ix,iy+1)-a;
    float d=SilPomTexel(texture,p,ix+1,iy+1)-a-b-c;
    return float3(p.scale*(a+b*fx+c*fy+d*fx*fy-p.reference),
        p.scale*(b+d*fy)*p.textureWidth*p.tileU/p.width,
        p.scale*(c+d*fx)*p.textureHeight*p.tileV/p.height);
}
float3 SilPomRotateNormal(float3 value,float3 from,float3 to)
{
    float3 axis=cross(from,to);
    return value+cross(axis,value)+cross(axis,cross(axis,value))*(1/(1+dot(from,to)));
}
float3 SilPomFaceNormal(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,float2 uv,float2 low)
{
    float3 h=SilPomFaceHeight(texture,p,uv,low);
    float det=dot(f.du,cross(f.dv,f.normal));
    float3 dualU=cross(f.dv,f.normal)*(1/det),dualV=cross(f.normal,f.du)*(1/det);
    float3 baseNormal=normalize(f.normal-dualU*h.y-dualV*h.z);
    return normalize(SilPomRotateNormal(baseNormal,f.normal,normalize(SilPomFaceDirection(f,uv))));
}
float3 SilPomShadingNormal(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,float2 uv,float2 low,bool useHeight)
{
    if(!useHeight) return f.normal;
    return SilPomFaceNormal(texture,p,f,uv,low);
}
// Private to one bounded solve. Keep the unaddressed integer cell and raw
// texels; fractions, bilinear coefficients and derivatives remain current.
struct SilPomRefineHeightCell
{
    bool valid;
    int ix,iy;
    float h00,h10,h01,h11;
};
float3 SilPomRefineFaceHeight(SP_TEX texture,SilPomPatch p,float2 uv,float2 low,
    SP_REF(SilPomRefineHeightCell) cell)
{
    float u=(uv.x-low.x)*p.tileU/p.width+p.offsetU;
    float v=(uv.y-low.y)*p.tileV/p.height+p.offsetV;
    float x=u*p.textureWidth-.5f,y=v*p.textureHeight-.5f;
    int ix=int(floor(x)),iy=int(floor(y));float fx=x-floor(x),fy=y-floor(y);
    if(!cell.valid || cell.ix!=ix || cell.iy!=iy)
    {
#if !defined(SILPOM_CPU) && defined(SILPOM_VALIDATION_GATHER)
        bool gathered=false;
        [branch] if(SILPOM_VALIDATION_GATHER)
        {
            int ax=SilPomAddress(ix,int(p.textureWidth),p.addressMode);
            int ay=SilPomAddress(iy,int(p.textureHeight),p.addressMode);
            if(ax+1<int(p.textureWidth) && ay+1<int(p.textureHeight)
                && (p.addressMode==0 || (ix>=0 && iy>=0)))
            {
                // Match SilPomGatherFaceHeight's original interior footprint
                // and channel ordering. Border quads retain integer loads.
                float4 quad=texture.GatherRed(GetMaterialTextureSampler(),
                    (float2(ax,ay)+1.0f)/float2(p.textureWidth,p.textureHeight));
                cell.h00=quad.w;cell.h10=quad.z;cell.h01=quad.x;cell.h11=quad.y;
                gathered=true;
            }
        }
        if(!gathered)
#endif
        {
            cell.h00=SilPomTexel(texture,p,ix,iy);cell.h10=SilPomTexel(texture,p,ix+1,iy);
            cell.h01=SilPomTexel(texture,p,ix,iy+1);cell.h11=SilPomTexel(texture,p,ix+1,iy+1);
        }
        cell.ix=ix;cell.iy=iy;cell.valid=true;
    }
    float a=cell.h00,b=cell.h10-a,c=cell.h01-a,d=cell.h11-a-b-c;
    return float3(p.scale*(a+b*fx+c*fy+d*fx*fy-p.reference),
        p.scale*(b+d*fy)*p.textureWidth*p.tileU/p.width,
        p.scale*(c+d*fx)*p.textureHeight*p.tileV/p.height);
}
// Bounded Newton refinement of a planar-kernel seed. Never accept an
// unconverged iterate as geometry. This is a local heuristic, not a complete
// intersection algorithm for arbitrary curved surfaces or folded volumes.
uint SilPomRefineFace(SP_TEX texture, SilPomPatch p, SilPomMeshFace f,
    SilPomRay ray,float2 low,SP_REF(float2) uv,SP_REF(float) t,uint maxIterations=16,float toleranceMultiplier=1.0f)
{
    SilPomRefineHeightCell heightCell=SP_ZERO(SilPomRefineHeightCell);
#if SILPOM_FACE_COEFFICIENT_CACHE
    float3 dU,dV;float baseTolerance;
    if(!SilPomTryFaceNewtonCoefficients(f,dU,dV,baseTolerance))
    {
        float area=SilPomUvArea(f);
        dU=((f.d1-f.d0)*(f.uv2.y-f.uv0.y)-(f.d2-f.d0)*(f.uv1.y-f.uv0.y))*(1/area);
        dV=((f.d2-f.d0)*(f.uv1.x-f.uv0.x)-(f.d1-f.d0)*(f.uv2.x-f.uv0.x))*(1/area);
        baseTolerance=2e-6f*max(1.0f,max(length(f.du),length(f.dv)));
    }
    float tolerance=baseTolerance*toleranceMultiplier;
#else
    float area=SilPomUvArea(f);
    float3 dU=((f.d1-f.d0)*(f.uv2.y-f.uv0.y)-(f.d2-f.d0)*(f.uv1.y-f.uv0.y))*(1/area);
    float3 dV=((f.d2-f.d0)*(f.uv1.x-f.uv0.x)-(f.d1-f.d0)*(f.uv2.x-f.uv0.x))*(1/area);
    float tolerance=2e-6f*max(1.0f,max(length(f.du),length(f.dv)))*toleranceMultiplier;
#endif
    for(uint iteration=0;iteration<maxIterations;++iteration)
    {
        SILPOM_DIAGNOSTIC(1,iteration);
        // Direction is independent of height. Keeping it before the cell
        // lookup preserves approved tangent-sum association under DXC's
        // fast-math CSE; stored-coefficient GPU regressions guard this order.
        float3 D=SilPomFaceDirection(f,uv);
        float3 h=SilPomRefineFaceHeight(texture,p,uv,low,heightCell);
        float3 position=f.origin+f.du*(uv.x-f.uv0.x)+f.dv*(uv.y-f.uv0.y)+D*h.x;
        float3 residual=position-(ray.origin+ray.direction*t);
        if(dot(residual,residual)<=tolerance*tolerance)
        {
            float3 w=SilPomFaceWeights(f,uv);
            uint status=min(w.x,min(w.y,w.z))>=-2e-6f && t>=ray.tMin && t<=ray.tMax ? SP_HIT : SP_MISS;
            SILPOM_DIAGNOSTIC(2,status);
            return status;
        }
        float3 U=f.du+dU*h.x+D*h.y,V=f.dv+dV*h.x+D*h.z;
        float determinant=dot(U,cross(V,ray.direction));
        if(abs(determinant)<1e-9f) { SILPOM_DIAGNOSTIC(3,0); return SP_REFINE_REJECTED; }
        float deltaU=-dot(residual,cross(V,ray.direction))/determinant;
        float deltaV=-dot(U,cross(residual,ray.direction))/determinant;
        float deltaT=dot(U,cross(V,residual))/determinant;
        // Keep Newton from jumping across many unrelated heightfield features.
        float step=max(abs(deltaU)/p.width,abs(deltaV)/p.height);
        float damping=step>.25f?.25f/step:1.0f;
        uv.x+=deltaU*damping;uv.y+=deltaV*damping;t+=deltaT*damping;
        if(uv.x<low.x-p.width || uv.x>low.x+2*p.width || uv.y<low.y-p.height || uv.y>low.y+2*p.height)
        { SILPOM_DIAGNOSTIC(4,0); return SP_REFINE_REJECTED; }
    }
    SILPOM_DIAGNOSTIC(5,0);
    return SP_REFINE_REJECTED;
}
// The displaced point is a convex combination of the six corner extrema.
// Bound their projections along three side normals of an oblique triangular
// prism. Clip only the planar seed search. The refinement ray retains its
// original interval because a planar seed can converge to a different t.
bool SilPomSweptFaceInterval(SilPomPatch p, SilPomMeshFace f, SP_REF(SilPomRay) ray)
{
    const float3 b = f.du*(f.uv1.x-f.uv0.x) + f.dv*(f.uv1.y-f.uv0.y);
    const float3 c = f.du*(f.uv2.x-f.uv0.x) + f.dv*(f.uv2.y-f.uv0.y);
    const float3 extrusion = f.d0+f.d1+f.d2;
    const float h0 = -p.scale*p.reference;
    const float h1 = p.scale*(1-p.reference);
    const float3 origin = ray.origin-f.origin;
    const float3 start = origin+ray.direction*ray.tMin;
    const float3 end = origin+ray.direction*ray.tMax;
    // Include the Newton residual and shared-edge tolerances, and allow for
    // cancellation when evaluating a distant ray at the face.
    const float size = max(1.0f,max(length(f.du),max(length(f.dv),abs(p.scale))));
    const float padding = 1e-5f*(size+length(origin));
    float enter = 0.0f, exit = 1.0f;
    for(uint side=0;side<3;++side)
    {
        const float3 edge = side==0 ? b : (side==1 ? c-b : c*(-1.0f));
        const float3 normal = cross(extrusion,edge);
        const float d0 = dot(normal,f.d0), d1 = dot(normal,f.d1), d2 = dot(normal,f.d2);
        const float lower0 = min(d0*h0,d0*h1);
        const float lower1 = dot(normal,b)+min(d1*h0,d1*h1);
        const float lower2 = dot(normal,c)+min(d2*h0,d2*h1);
        const float lower = min(lower0,min(lower1,lower2))
            -padding*(abs(normal.x)+abs(normal.y)+abs(normal.z));
        const float first = dot(normal,start)-lower;
        const float last = dot(normal,end)-lower;
        if(max(first,last)<0.0f) return false;
        if(min(first,last)<0.0f)
        {
            const float crossing = first/(first-last);
            if(first<0.0f) enter=max(enter,crossing);
            else exit=min(exit,crossing);
        }
    }
    if(enter>exit+1e-6f) return false;

    const float span = ray.tMax-ray.tMin;
    ray.tMin += span*max(0.0f,enter-1e-6f);
    ray.tMax -= span*max(0.0f,1.0f-exit-1e-6f);
    return true;
}

bool SilPomMakeSeedRay(SilPomMeshFace f,float3 D,SilPomRay worldRay,SP_REF(SilPomRay) ray)
{
    float determinant=dot(f.du,cross(f.dv,D));
    if(abs(determinant)<1e-10f) return false;
    float3 U=cross(f.dv,D)*(1/determinant),V=cross(D,f.du)*(1/determinant),Z=cross(f.du,f.dv)*(1/determinant);
    ray.origin=float3(f.uv0.x+dot(U,worldRay.origin-f.origin),f.uv0.y+dot(V,worldRay.origin-f.origin),dot(Z,worldRay.origin-f.origin));
    ray.direction=float3(dot(U,worldRay.direction),dot(V,worldRay.direction),dot(Z,worldRay.direction));
    return true;
}

SilPomHit SilPomSearchFace(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,
    SilPomRay worldRay,float2 low,float searchBegin,float searchEnd,bool constant
#if SILPOM_MESH_DEPTH_BOUNDS
    ,SP_BOUND_TEX bounds,bool useBounds
#endif
    ,bool useHeightDerivedNormals=true
)
{
    SilPomHit best=SP_ZERO(SilPomHit);best.t=worldRay.tMax;
    float2 center=float2(low.x+p.width*.5f,low.y+p.height*.5f);
    uint spent=0;bool unresolved=false;
    for(uint seed=0;seed<(constant?1u:4u);++seed)
    {
        float3 D=seed==0?(f.d0+f.d1+f.d2)*(1.0f/3.0f):(seed==1?f.d0:(seed==2?f.d1:f.d2));
        SilPomRay ray;
        if(!SilPomMakeSeedRay(f,D,worldRay,ray)) {best.status=SP_INVALID;return best;}
        ray.tMin=searchBegin;ray.tMax=searchEnd;
        if(constant)
        {
            float begin,end;
            if(!SilPomFaceInterval(ray,f.uv0,f.uv1,f.uv2,begin,end)) continue;
            ray.tMin=begin;ray.tMax=end;
        }
        ray.origin.x-=center.x;ray.origin.y-=center.y;
        // Outside-triangle roots of the seed rectangle must not hide later
        // roots inside the triangle. Bound both candidates and total cell work.
        for(uint candidate=0;candidate<8;++candidate)
        {
            if(spent>=p.maxCells) {unresolved=true;break;}
            SilPomPatch bounded=p;bounded.maxCells=p.maxCells-spent;
#if SILPOM_MESH_DEPTH_BOUNDS
            SilPomHit hit=SilPomIntersectMode(texture,bounded,ray,true,bounds,useBounds);
#else
            SilPomHit hit=SilPomIntersect(texture,bounded,ray);
#endif
            spent+=hit.cells;
            if(hit.status==SP_MISS) break;
            if(hit.status!=SP_HIT) {unresolved=true;break;}
            float2 uv=float2(hit.position.x+center.x,hit.position.y+center.y);float t=hit.t;
            uint status=constant?SP_HIT:SilPomRefineFace(texture,p,f,worldRay,low,uv,t);
            if(status==SP_HIT)
            {
                if(best.status!=SP_HIT || t<best.t)
                {
                    best=hit;best.status=SP_HIT;best.t=t;
                    best.position=worldRay.origin+worldRay.direction*t;
                    best.uv=float2((uv.x-low.x)*p.tileU/p.width+p.offsetU,(uv.y-low.y)*p.tileV/p.height+p.offsetV);
#if SILPOM_HIT_DEPTH
                    best.faceUv=uv;
#else
                    best.normal=SilPomShadingNormal(texture,p,f,uv,low,useHeightDerivedNormals);
#endif
                }
                break;
            }
            // Rejected/outside seeds contribute no geometry. Continue looking
            // for candidates; only actual work-budget limits set unresolved.
            ray.tMin=hit.t+max(1e-5f,abs(hit.t)*1e-6f);
            if(candidate==7) unresolved=true;
        }
    }
    best.cells=spent;
#if SILPOM_MESH_DEPTH_BOUNDS
    if(useBounds && unresolved) best.status=SP_EXHAUSTED;
#endif
    if(best.status!=SP_HIT && unresolved) {best.status=SP_EXHAUSTED;best.t=worldRay.tMin;}
    return best;
}

void SilPomFaceBounds(SilPomMeshFace f,float scale,float reference,SP_REF(float3) boundsLow,SP_REF(float3) boundsHigh)
{
    boundsLow=float3(1e30f,1e30f,1e30f);
    boundsHigh=float3(-1e30f,-1e30f,-1e30f);
    for(uint i=0;i<6;++i)
    {
        float2 uv=i/2==0?f.uv0:(i/2==1?f.uv1:f.uv2);
        float3 D=i/2==0?f.d0:(i/2==1?f.d1:f.d2);
        float h=scale*(float(i%2)-reference);
        float3 cornerPosition=f.origin+f.du*(uv.x-f.uv0.x)+f.dv*(uv.y-f.uv0.y)+D*h;
        boundsLow=min(boundsLow,cornerPosition);boundsHigh=max(boundsHigh,cornerPosition);
    }
}

#if SILPOM_HIT_NEURAL
#include "ProfileNetworks.azsli"
#ifndef SILPOM_EVALUATION
#include "NeuralTower.azsli"
#endif
#if SILPOM_NEURAL_NO_MARCH

// Fixed-feature inference and bounded Newton validation. No heightfield walk.
SilPomHit SilPomNoMarchCandidate(Texture2D texture, SilPomPatch p, SilPomMeshFace face,
    SilPomRay worldRay, SilPomRay projected, float2 low, float seedT,uint validationIterations,float toleranceMultiplier)
{
    SilPomHit hit=SP_ZERO(SilPomHit);
    float t=seedT;
    float2 uv=SP_XY(projected.origin)+SP_XY(projected.direction)*t;
    const float3 weights=max(SilPomFaceWeights(face,uv),0.0f);
    uv=(weights.x*face.uv0+weights.y*face.uv1+weights.z*face.uv2)/(weights.x+weights.y+weights.z);
    SILPOM_DIAGNOSTIC(6,0);
    if(SilPomRefineFace(texture,p,face,worldRay,low,uv,t,validationIterations,toleranceMultiplier)!=SP_HIT) return hit;
    SILPOM_DIAGNOSTIC(7,0);
    hit.status=SP_HIT;
    hit.t=t;
    hit.position=worldRay.origin+worldRay.direction*t;
    hit.faceUv=uv;
    hit.uv=(uv-low)*float2(p.tileU/p.width,p.tileV/p.height)+float2(p.offsetU,p.offsetV);
    return hit;
}

bool SilPomPreparePrediction(SilPomPatch p,SilPomMeshFace face,SilPomRay worldRay,
    SP_REF(SilPomRay) search,SP_REF(SilPomRay) projected)
{
    const float3 average=(face.d0+face.d1+face.d2)*(1.0f/3.0f);
    projected=search;
    if(!SilPomMakeSeedRay(face,average,worldRay,projected)) return false;
    const float middle=(search.tMin+search.tMax)*.5f;
    const float2 midUv=SP_XY(projected.origin)+SP_XY(projected.direction)*middle;
    const float3 weights=max(SilPomFaceWeights(face,midUv),0.0f);
    const float3 local=(face.d0*weights.x+face.d1*weights.y+face.d2*weights.z)/
        (weights.x+weights.y+weights.z);
    if(!SilPomMakeSeedRay(face,local,worldRay,projected)) return false;

    const float3 heights=float3(dot(face.normal,face.d0),dot(face.normal,face.d1),
        dot(face.normal,face.d2))/dot(face.normal,local);
    const float3 lowZ=min(-p.scale*p.reference*heights,p.scale*(1-p.reference)*heights);
    const float3 highZ=max(-p.scale*p.reference*heights,p.scale*(1-p.reference)*heights);
    const float minZ=min(lowZ.x,min(lowZ.y,lowZ.z))-1e-5f;
    const float maxZ=max(highZ.x,max(highZ.y,highZ.z))+1e-5f;
    if(abs(projected.direction.z)>1e-7f)
    {
        const float a=(minZ-projected.origin.z)/projected.direction.z;
        const float b=(maxZ-projected.origin.z)/projected.direction.z;
        search.tMin=max(search.tMin,min(a,b));
        search.tMax=min(search.tMax,max(a,b));
    }
    else if(projected.origin.z<minZ || projected.origin.z>maxZ) return false;
    const float span=search.tMax-search.tMin;
    if(span<=1e-7f) return false;

    return true;
}

SilPomHit SilPomPredictTowerHit(Texture2D texture, SilPomPatch p, SilPomMeshFace face,
    SilPomRay worldRay, SilPomRay search, float2 low, SilPomTrainedModel model,uint validationIterations,uint retryCap,float toleranceMultiplier,
    uint reliefMode)
{
    SilPomHit miss=SP_ZERO(SilPomHit);
    SilPomRay projected;
    if(!SilPomPreparePrediction(p,face,worldRay,search,projected)) return miss;
    const float span=search.tMax-search.tMin;

    const float2 size=float2(p.textureWidth,p.textureHeight);
    const float2 tile=float2(p.tileU/p.width,p.tileV/p.height);
    const float2 offset=float2(p.offsetU,p.offsetV);
    const float2 inset=.5f/size;
    float feature[11];
    // These four independent texture samples are a descriptor of the ray.
    // The network, rather than a crossing search, chooses the first candidate.
    SP_UNROLL for(uint i=0;i<4;++i)
    {
        const float t=search.tMin+span*((float(i)+.5f)*.25f);
        const float3 location=projected.origin+projected.direction*t;
        const float2 tex=(SP_XY(location)-low)*tile+offset;
        const float2 addressed=p.addressMode==0 ? frac(tex) : clamp(tex,inset,1-inset);
        const float height=SP_SAMPLE_HEIGHT(texture,addressed);
        feature[i]=clamp(height-(location.z/p.scale+p.reference),-1.5f,1.5f);
        const float3 w=SilPomFaceWeights(face,SP_XY(location));
        feature[6+i]=clamp(24.0f*min(w.x,min(w.y,w.z)),-1.0f,1.0f);
    }
    const float2 rate=clamp(SP_XY(projected.direction)*span*tile*size/16.0f,-2.0f,2.0f);
    feature[4]=rate.x;
    feature[5]=rate.y;
    feature[10]=-dot(face.normal,worldRay.direction);
#ifdef SILPOM_CAPTURE_FEATURES
    SILPOM_CAPTURE_INTERVAL(search.tMin,span);
    if(SILPOM_CAPTURE_FEATURES(feature,11)) return miss;
#endif
    float2 logits;
#ifdef SILPOM_OVERRIDE_MODEL
    if(!SILPOM_OVERRIDE_MODEL(feature,model,logits))
#endif
    {
    // Every profile, model 0 included, reads its hit network from its weights.
    logits=SilPomHitNetwork(feature,model.weights);
    }
    float4 residuals=abs(float4(feature[0],feature[1],feature[2],feature[3]));
    const float nearestResidual=min(min(residuals.x,residuals.y),min(residuals.z,residuals.w));
    const float insideFace=max(max(feature[6],feature[7]),max(feature[8],feature[9]));
    // A small residual and an interior descriptor sample justify trying the
    // local solver even if the network is slightly below its usual cutoff.
    const bool recoverMiss=SilPomReliefFillEnabled(reliefMode) && insideFace>=0.0f && nearestResidual<.12f;
    if(logits.y<(recoverMiss?-3.5f:-2.944439f)) { SILPOM_DIAGNOSTIC(8,0); return miss; }
    const float fraction=rcp(1.0f+exp(-clamp(logits.x,-20.0f,20.0f)));
    SilPomHit hit=SilPomNoMarchCandidate(texture,p,face,worldRay,projected,low,search.tMin+fraction*span,validationIterations,toleranceMultiplier);
    if(hit.status==SP_HIT || !SilPomReliefNoMarch(reliefMode)) return hit;

    // Retry independent descriptor seeds in residual order. An unsuccessful
    // solve does not advance the ray or supply the start of the next solve.
    // The welded wall model gets one retry after its first Newton attempt.
    const uint attempts=min(retryCap,(!SilPomIsWallProfile(model) && recoverMiss && logits.y>0.0f) ? 4u : 1u);
    SP_LOOP for(uint attempt=0;attempt<attempts;++attempt)
    {
        SILPOM_DIAGNOSTIC(9,0);
        const uint first=residuals.x<=residuals.y?0u:1u;
        const uint second=residuals.z<=residuals.w?2u:3u;
        const uint nearest=residuals[first]<=residuals[second]?first:second;
        hit=SilPomNoMarchCandidate(texture,p,face,worldRay,projected,low,
            search.tMin+span*((float(nearest)+.5f)*.25f),validationIterations,toleranceMultiplier);
        if(hit.status==SP_HIT) return hit;
        residuals[nearest]=2.0f;
    }
    return hit;
}

// A prediction step that hands the first-level solver to its caller: bit 31
// of the status marks it, the low 16 bits carry the remaining retry cap. SP_*
// statuses are small, so no published hit or miss has this bit.
static const uint SP_PREDICTION_FALLBACK=0x80000000u;
SilPomHit SilPomPredictionFallback(uint retryCap)
{
    SilPomHit fallback=SP_ZERO(SilPomHit);
    fallback.status=SP_PREDICTION_FALLBACK|retryCap;
    return fallback;
}
#ifdef SILPOM_LEVEL2
#include "LevelTwo.azsli"
#endif
#include "NearestHit.azsli"

// Intersect the authored triangle for the grazing fill or the shell transition.
SilPomHit SilPomTowerBaseHit(SilPomPatch p, SilPomMeshFace face, SilPomRay ray, float2 low,
    bool grazingOnly=true)
{
    SilPomHit hit=SP_ZERO(SilPomHit);
    const float incidence=dot(face.normal,ray.direction);
    if(grazingOnly ? (incidence>=-1e-7f || incidence<=-SP_TOWER_MAX_FILL_INCIDENCE) :
        abs(incidence)<=1e-7f) return hit;
    const float3 origin=ray.origin-face.origin;
    const float t=-dot(face.normal,origin)/incidence;
    if(t<ray.tMin || t>ray.tMax) return hit;

    const float3 tangentU=cross(face.dv,face.normal);
    const float3 tangentV=cross(face.normal,face.du);
    const float3 offset=origin+ray.direction*t;
    const float2 uv=face.uv0+float2(dot(tangentU,offset),dot(tangentV,offset))/dot(face.du,tangentU);
    const float3 weights=SilPomFaceWeights(face,uv);
    if(min(weights.x,min(weights.y,weights.z))<0.0f) return hit;

    hit.status=SP_HIT;
    hit.t=t;
    hit.position=ray.origin+ray.direction*t;
    hit.faceUv=uv;
    hit.gradientRepresentation=2u; // authored base plane, including ordinary-status grazing fill
    hit.uv=(uv-low)*float2(p.tileU/p.width,p.tileV/p.height)+float2(p.offsetU,p.offsetV);
    return hit;
}

#endif
#endif

SilPomHit SilPomIntersectFace(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,SilPomRay worldRay,float2 low
#if SILPOM_HIT_NEURAL
    ,SilPomTrainedModel model
#endif
#if SILPOM_NEURAL_NO_MARCH
    ,uint validationIterations,uint retryCap,float toleranceMultiplier,uint reliefMode
#endif
#if SILPOM_HIT_NEURAL_CACHE
    ,SP_TEX neuralCache
#endif
#if SILPOM_MESH_DEPTH_BOUNDS
    ,SP_BOUND_TEX bounds,bool useBounds
#endif
    ,bool useHeightDerivedNormals=true
)
{
    SilPomHit best=SP_ZERO(SilPomHit);best.t=worldRay.tMax;
    float3 boundsLow,boundsHigh;
    SilPomFaceBounds(f,p.scale,p.reference,boundsLow,boundsHigh);
    for(uint axis=0;axis<3;++axis)
    {
        float lo=boundsLow[axis]-1e-5f,hi=boundsHigh[axis]+1e-5f;
        float origin=worldRay.origin[axis],direction=worldRay.direction[axis];
        if(direction==0) {if(origin<lo || origin>hi) return best;}
        else
        {
            float a=(lo-origin)/direction,b=(hi-origin)/direction;
            worldRay.tMin=max(worldRay.tMin,min(a,b));worldRay.tMax=min(worldRay.tMax,max(a,b));
        }
    }
    if(worldRay.tMin>worldRay.tMax) return best;
    bool constant=p.scale==0 || dot(f.d1-f.d0,f.d1-f.d0)+dot(f.d2-f.d0,f.d2-f.d0)<1e-12f;
    SilPomRay searchRay=worldRay;
    if(!constant && !SilPomSweptFaceInterval(p,f,searchRay)) return best;

#if SILPOM_HIT_NEURAL
#if SILPOM_NEURAL_NO_MARCH
    // The welded profiles do not have a legacy cache or compatible legacy weights.
    if(model.id==0u)
#endif
    {
    SilPomHit neural=SilPomTryTowerNeural(texture,p,f,worldRay,searchRay,low,model.weights
#if SILPOM_HIT_NEURAL_CACHE
        ,neuralCache
#endif
    );
    if(neural.status==SP_HIT) return neural;
    }
#if SILPOM_NEURAL_NO_MARCH
    // One call site for the first-level solver: Level 2 returns a fallback
    // marker instead of inlining its own copies (same order and retry caps).
    SilPomHit predicted=SilPomPredictionFallback(retryCap);
#ifdef SILPOM_LEVEL2
    SP_BRANCH if(SILPOM_LEVEL2 && SilPomHasLevelTwo(model))
        predicted=SilPomPredictTowerHit2(texture,p,f,worldRay,searchRay,low,model,validationIterations,retryCap,toleranceMultiplier,reliefMode);
#endif
    SP_BRANCH if((predicted.status&SP_PREDICTION_FALLBACK)!=0u)
        predicted=SilPomPredictTowerHit(texture,p,f,worldRay,searchRay,low,model,validationIterations,predicted.status&0xFFFFu,toleranceMultiplier,reliefMode);
    predicted=SilPomRecoverNearestHit(texture,p,f,worldRay,searchRay,low,predicted,model.id);
    if(predicted.status==SP_HIT || !SilPomReliefFillEnabled(reliefMode)) return predicted;
    SILPOM_DIAGNOSTIC(10,0);
    SilPomHit fill=SilPomTowerBaseHit(p,f,worldRay,low);
    SILPOM_DIAGNOSTIC(11,fill.status);
    return fill;
#endif
#endif

#if !SILPOM_NEURAL_NO_MARCH
    bool shortened=searchRay.tMin>worldRay.tMin || searchRay.tMax<worldRay.tMax;
#if SILPOM_MESH_DEPTH_BOUNDS
    const bool clipped=shortened;
    const SilPomRay clippedRay=searchRay;
#endif
    uint priorCells=0;
    for(;;)
    {
        SilPomHit hit=SilPomSearchFace(texture,p,f,worldRay,low,searchRay.tMin,searchRay.tMax,constant
#if SILPOM_MESH_DEPTH_BOUNDS
            ,bounds,useBounds
#endif
            ,useHeightDerivedNormals
        );
#if SILPOM_MESH_DEPTH_BOUNDS
        // Block skips charge an upper bound on cell visits at diagonal crossings.
        // Re-run from the original budget if that estimate exhausts the search.
        if(useBounds && hit.status==SP_EXHAUSTED)
        {
            useBounds=false;
            p.maxCells+=priorCells;
            priorCells=0;
            searchRay=clippedRay;
            shortened=clipped;
            continue;
        }
#endif
        if(!shortened || hit.status!=SP_EXHAUSTED || hit.cells>=p.maxCells)
        {
            hit.cells+=priorCells;
            return hit;
        }
        // A seed outside the clipped interval can refine to a valid hit inside.
        // Give exhausted searches one retry with the remaining cell budget.
        priorCells=hit.cells;
        p.maxCells-=priorCells;
        searchRay=worldRay;
        shortened=false;
    }
#endif
}
