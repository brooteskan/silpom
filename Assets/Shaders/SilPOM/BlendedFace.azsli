};
static const float2 TowerNoMarchB1 = float2(1.917806715e-01f, 4.202251509e-02f);
#include "NeuralWeldedTowerWeights.azsli"
#include "NeuralOpenShaftTowerWeights.azsli"

float2 SilPomEvaluateHitModel(float feature[11], const float w0[16][11], const float b0[16], const float2 w1[16], float2 b1)
{
    float2 logits=b1;
    SP_UNROLL for(uint j=0;j<16;++j)
    {
        float unit=b0[j];
        SP_UNROLL for(uint k=0;k<11;++k) unit+=feature[k]*w0[j][k];
        unit=max(unit,0.0f);
        logits+=unit*unit*w1[j];
    }
    return logits;
}

// Fixed-feature inference and bounded Newton validation. No heightfield walk.
SilPomHit SilPomNoMarchCandidate(Texture2D texture, SilPomPatch p, SilPomMeshFace face,
    SilPomRay worldRay, SilPomRay projected, float2 low, float seedT,uint validationIterations,float toleranceMultiplier)
{
    SilPomHit hit=SP_ZERO(SilPomHit);
    float t=seedT;
    float2 uv=SP_XY(projected.origin)+SP_XY(projected.direction)*t;
    const float3 weights=max(SilPomFaceWeights(face,uv),0.0f);
    uv=(weights.x*face.uv0+weights.y*face.uv1+weights.z*face.uv2)/(weights.x+weights.y+weights.z);
    SILPOM_DIAGNOSTIC(6,0);
    if(SilPomRefineFace(texture,p,face,worldRay,low,uv,t,validationIterations,toleranceMultiplier)!=SP_HIT) return hit;
    SILPOM_DIAGNOSTIC(7,0);
    hit.status=SP_HIT;
    hit.t=t;
    hit.position=worldRay.origin+worldRay.direction*t;
    hit.faceUv=uv;
    hit.uv=(uv-low)*float2(p.tileU/p.width,p.tileV/p.height)+float2(p.offsetU,p.offsetV);
    return hit;
}

bool SilPomPreparePrediction(SilPomPatch p,SilPomMeshFace face,SilPomRay worldRay,
    SP_REF(SilPomRay) search,SP_REF(SilPomRay) projected)
{
    const float3 average=(face.d0+face.d1+face.d2)*(1.0f/3.0f);
    projected=search;
    if(!SilPomMakeSeedRay(face,average,worldRay,projected)) return false;
    const float middle=(search.tMin+search.tMax)*.5f;
    const float2 midUv=SP_XY(projected.origin)+SP_XY(projected.direction)*middle;
    const float3 weights=max(SilPomFaceWeights(face,midUv),0.0f);
    const float3 local=(face.d0*weights.x+face.d1*weights.y+face.d2*weights.z)/
        (weights.x+weights.y+weights.z);
    if(!SilPomMakeSeedRay(face,local,worldRay,projected)) return false;

    const float3 heights=float3(dot(face.normal,face.d0),dot(face.normal,face.d1),
        dot(face.normal,face.d2))/dot(face.normal,local);
    const float3 lowZ=min(-p.scale*p.reference*heights,p.scale*(1-p.reference)*heights);
    const float3 highZ=max(-p.scale*p.reference*heights,p.scale*(1-p.reference)*heights);
    const float minZ=min(lowZ.x,min(lowZ.y,lowZ.z))-1e-5f;
    const float maxZ=max(highZ.x,max(highZ.y,highZ.z))+1e-5f;
    if(abs(projected.direction.z)>1e-7f)
    {
        const float a=(minZ-projected.origin.z)/projected.direction.z;
        const float b=(maxZ-projected.origin.z)/projected.direction.z;
        search.tMin=max(search.tMin,min(a,b));
        search.tMax=min(search.tMax,max(a,b));
    }
    else if(projected.origin.z<minZ || projected.origin.z>maxZ) return false;
    const float span=search.tMax-search.tMin;
    if(span<=1e-7f) return false;

    return true;
}

SilPomHit SilPomPredictTowerHit(Texture2D texture, SilPomPatch p, SilPomMeshFace face,
    SilPomRay worldRay, SilPomRay search, float2 low, uint model,uint validationIterations,uint retryCap,float toleranceMultiplier)
{
    SilPomHit miss=SP_ZERO(SilPomHit);
    SilPomRay projected;
    if(!SilPomPreparePrediction(p,face,worldRay,search,projected)) return miss;
    const float span=search.tMax-search.tMin;

    const float2 size=float2(p.textureWidth,p.textureHeight);
    const float2 tile=float2(p.tileU/p.width,p.tileV/p.height);
    const float2 offset=float2(p.offsetU,p.offsetV);
    const float2 inset=.5f/size;
    float feature[11];
    // These four independent texture samples are a descriptor of the ray.
    // The network, rather than a crossing search, chooses the first candidate.
    SP_UNROLL for(uint i=0;i<4;++i)
    {
        const float t=search.tMin+span*((float(i)+.5f)*.25f);
        const float3 location=projected.origin+projected.direction*t;
        const float2 tex=(SP_XY(location)-low)*tile+offset;
        const float2 addressed=p.addressMode==0 ? frac(tex) : clamp(tex,inset,1-inset);
        const float height=SP_SAMPLE_HEIGHT(texture,addressed);
        feature[i]=clamp(height-(location.z/p.scale+p.reference),-1.5f,1.5f);
        const float3 w=SilPomFaceWeights(face,SP_XY(location));
        feature[6+i]=clamp(24.0f*min(w.x,min(w.y,w.z)),-1.0f,1.0f);
    }
    const float2 rate=clamp(SP_XY(projected.direction)*span*tile*size/16.0f,-2.0f,2.0f);
    feature[4]=rate.x;
    feature[5]=rate.y;
    feature[10]=-dot(face.normal,worldRay.direction);
#ifdef SILPOM_CAPTURE_FEATURES
    SILPOM_CAPTURE_INTERVAL(search.tMin,span);
    if(SILPOM_CAPTURE_FEATURES(feature,11)) return miss;
#endif
    float2 logits;
#ifdef SILPOM_OVERRIDE_MODEL
    if(!SILPOM_OVERRIDE_MODEL(feature,model,logits))
#endif
    {
    // The model is constant for the material batch.
    SP_BRANCH if(model==1u) logits=SilPomEvaluateHitModel(feature,WeldedWallW0,WeldedWallB0,WeldedWallW1,WeldedWallB1);
    else if(model==2u) logits=SilPomEvaluateHitModel(feature,WeldedStairsW0,WeldedStairsB0,WeldedStairsW1,WeldedStairsB1);
    else if(model==3u) logits=SilPomEvaluateHitModel(feature,WeldedDoorW0,WeldedDoorB0,WeldedDoorW1,WeldedDoorB1);
    else if(model==4u) logits=SilPomEvaluateHitModel(feature,OpenShaftWallW0,OpenShaftWallB0,OpenShaftWallW1,OpenShaftWallB1);
    else if(model==5u) logits=SilPomEvaluateHitModel(feature,OpenShaftStairsW0,OpenShaftStairsB0,OpenShaftStairsW1,OpenShaftStairsB1);
    else if(model==6u) logits=SilPomEvaluateHitModel(feature,OpenShaftTrimW0,OpenShaftTrimB0,OpenShaftTrimW1,OpenShaftTrimB1);
    else if(model==7u) logits=SilPomEvaluateHitModel(feature,OpenShaftRevealW0,OpenShaftRevealB0,OpenShaftRevealW1,OpenShaftRevealB1);
    else if(model==0u) logits=SilPomEvaluateHitModel(feature,TowerNoMarchW0,TowerNoMarchB0,TowerNoMarchW1,TowerNoMarchB1);
    else return miss;
    }
    float4 residuals=abs(float4(feature[0],feature[1],feature[2],feature[3]));
    const float nearestResidual=min(min(residuals.x,residuals.y),min(residuals.z,residuals.w));
    const float insideFace=max(max(feature[6],feature[7]),max(feature[8],feature[9]));
    // A small residual and an interior descriptor sample justify trying the
    // local solver even if the network is slightly below its usual cutoff.
    const bool recoverMiss=SilPomTowerFillEnabled(p.maxCells) && insideFace>=0.0f && nearestResidual<.12f;
    if(logits.y<(recoverMiss?-3.5f:-2.944439f)) { SILPOM_DIAGNOSTIC(8,0); return miss; }
    const float fraction=rcp(1.0f+exp(-clamp(logits.x,-20.0f,20.0f)));
    SilPomHit hit=SilPomNoMarchCandidate(texture,p,face,worldRay,projected,low,search.tMin+fraction*span,validationIterations,toleranceMultiplier);
    if(hit.status==SP_HIT || !SilPomTowerNoMarch(p.maxCells)) return hit;

    // Retry independent descriptor seeds in residual order. An unsuccessful
    // solve does not advance the ray or supply the start of the next solve.
    // The welded wall model gets one retry after its first Newton attempt.
    const uint attempts=min(retryCap,(!SilPomIsTowerWallModel(model) && recoverMiss && logits.y>0.0f) ? 4u : 1u);
    SP_LOOP for(uint attempt=0;attempt<attempts;++attempt)
    {
        SILPOM_DIAGNOSTIC(9,0);
        const uint first=residuals.x<=residuals.y?0u:1u;
        const uint second=residuals.z<=residuals.w?2u:3u;
        const uint nearest=residuals[first]<=residuals[second]?first:second;
        hit=SilPomNoMarchCandidate(texture,p,face,worldRay,projected,low,
            search.tMin+span*((float(nearest)+.5f)*.25f),validationIterations,toleranceMultiplier);
        if(hit.status==SP_HIT) return hit;
        residuals[nearest]=2.0f;
    }
    return hit;
}

#ifdef SILPOM_LEVEL2
#include "LevelTwo.azsli"
#endif
#include "NearestHit.azsli"

// Intersect the authored triangle for the grazing fill or the shell transition.
SilPomHit SilPomTowerBaseHit(SilPomPatch p, SilPomMeshFace face, SilPomRay ray, float2 low,
    bool grazingOnly=true)
{
    SilPomHit hit=SP_ZERO(SilPomHit);
    const float incidence=dot(face.normal,ray.direction);
    if(grazingOnly ? (incidence>=-1e-7f || incidence<=-SP_TOWER_MAX_FILL_INCIDENCE) :
        abs(incidence)<=1e-7f) return hit;
    const float3 origin=ray.origin-face.origin;
    const float t=-dot(face.normal,origin)/incidence;
    if(t<ray.tMin || t>ray.tMax) return hit;

    const float3 tangentU=cross(face.dv,face.normal);
    const float3 tangentV=cross(face.normal,face.du);
    const float3 offset=origin+ray.direction*t;
    const float2 uv=face.uv0+float2(dot(tangentU,offset),dot(tangentV,offset))/dot(face.du,tangentU);
    const float3 weights=SilPomFaceWeights(face,uv);
    if(min(weights.x,min(weights.y,weights.z))<0.0f) return hit;

    hit.status=SP_HIT;
    hit.t=t;
    hit.position=ray.origin+ray.direction*t;
    hit.faceUv=uv;
    hit.uv=(uv-low)*float2(p.tileU/p.width,p.tileV/p.height)+float2(p.offsetU,p.offsetV);
    return hit;
}

#endif
#endif

SilPomHit SilPomIntersectFace(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,SilPomRay worldRay,float2 low
#if SILPOM_NEURAL_NO_MARCH
    ,uint model,uint validationIterations,uint retryCap,float toleranceMultiplier
#endif
#if SILPOM_HIT_NEURAL_CACHE
    ,SP_TEX neuralCache
#endif
#if SILPOM_MESH_DEPTH_BOUNDS
    ,SP_BOUND_TEX bounds,bool useBounds
#endif
    ,bool useHeightDerivedNormals=true
)
{
    SilPomHit best=SP_ZERO(SilPomHit);best.t=worldRay.tMax;
    float3 boundsLow,boundsHigh;
    SilPomFaceBounds(f,p.scale,p.reference,boundsLow,boundsHigh);
    for(uint axis=0;axis<3;++axis)
    {
        float lo=boundsLow[axis]-1e-5f,hi=boundsHigh[axis]+1e-5f;
        float origin=worldRay.origin[axis],direction=worldRay.direction[axis];
        if(direction==0) {if(origin<lo || origin>hi) return best;}
        else
        {
            float a=(lo-origin)/direction,b=(hi-origin)/direction;
            worldRay.tMin=max(worldRay.tMin,min(a,b));worldRay.tMax=min(worldRay.tMax,max(a,b));
        }
    }
    if(worldRay.tMin>worldRay.tMax) return best;
    bool constant=p.scale==0 || dot(f.d1-f.d0,f.d1-f.d0)+dot(f.d2-f.d0,f.d2-f.d0)<1e-12f;
    SilPomRay searchRay=worldRay;
    if(!constant && !SilPomSweptFaceInterval(p,f,searchRay)) return best;

#if SILPOM_HIT_NEURAL
#if SILPOM_NEURAL_NO_MARCH
    // The welded profiles do not have a legacy cache or compatible legacy weights.
    if(model==0u)
#endif
    {
    SilPomHit neural=SilPomTryTowerNeural(texture,p,f,worldRay,searchRay,low
#if SILPOM_HIT_NEURAL_CACHE
        ,neuralCache
#endif
    );
    if(neural.status==SP_HIT) return neural;
    }
#if SILPOM_NEURAL_NO_MARCH
    SilPomHit predicted;
#ifdef SILPOM_LEVEL2
    SP_BRANCH if(SILPOM_LEVEL2 && model>=4u && model<=7u)
        predicted=SilPomPredictTowerHit2(texture,p,f,worldRay,searchRay,low,model,validationIterations,retryCap,toleranceMultiplier);
    else
#endif
        predicted=SilPomPredictTowerHit(texture,p,f,worldRay,searchRay,low,model,validationIterations,retryCap,toleranceMultiplier);
    predicted=SilPomRecoverNearestHit(texture,p,f,worldRay,searchRay,low,predicted,model);
    if(predicted.status==SP_HIT || !SilPomTowerFillEnabled(p.maxCells)) return predicted;
    SILPOM_DIAGNOSTIC(10,0);
    SilPomHit fill=SilPomTowerBaseHit(p,f,worldRay,low);
    SILPOM_DIAGNOSTIC(11,fill.status);
    return fill;
#endif
#endif

#if !SILPOM_NEURAL_NO_MARCH
    bool shortened=searchRay.tMin>worldRay.tMin || searchRay.tMax<worldRay.tMax;
#if SILPOM_MESH_DEPTH_BOUNDS
    const bool clipped=shortened;
    const SilPomRay clippedRay=searchRay;
#endif
    uint priorCells=0;
    for(;;)
    {
        SilPomHit hit=SilPomSearchFace(texture,p,f,worldRay,low,searchRay.tMin,searchRay.tMax,constant
#if SILPOM_MESH_DEPTH_BOUNDS
            ,bounds,useBounds
#endif
            ,useHeightDerivedNormals
        );
#if SILPOM_MESH_DEPTH_BOUNDS
        // Block skips charge an upper bound on cell visits at diagonal crossings.
        // Re-run from the original budget if that estimate exhausts the search.
        if(useBounds && hit.status==SP_EXHAUSTED)
        {
            useBounds=false;
            p.maxCells+=priorCells;
            priorCells=0;
            searchRay=clippedRay;
            shortened=clipped;
            continue;
        }
#endif
        if(!shortened || hit.status!=SP_EXHAUSTED || hit.cells>=p.maxCells)
        {
            hit.cells+=priorCells;
            return hit;
        }
        // A seed outside the clipped interval can refine to a valid hit inside.
        // Give exhausted searches one retry with the remaining cell budget.
        priorCells=hit.cells;
        p.maxCells-=priorCells;
        searchRay=worldRay;
        shortened=false;
    }
#endif
}
