#pragma once
// Restricted extension for planar base triangles with generated corner normals.
// D(u,v) is AFFINE, not normalized after interpolation: this keeps the six
// displaced corner extrema conservative, and makes shared edges identical.
#include "MeshFace.azsli"
#include "Quality.azsli"
#include "EvaluationHooks.azsli"
#if !defined(SILPOM_CPU) && defined(SILPOM_VALIDATION_GATHER)
#include "ValidationHeight.azsli"
#endif
// A planar seed need not intersect the deformed surface. Newton rejection is
// not traversal-budget exhaustion and must not be published as diagnostic
// geometry at the bounding-box entry point.
static const uint SP_REFINE_REJECTED=4;
// The preview uses the second learned candidate with either coverage proxy.
static const uint SP_TOWER_NO_MARCH=65534u;
static const uint SP_TOWER_RECTANGLE_CONTROL=65531u;
static const uint SP_TOWER_UNFILLED_CONTROL=65530u;
static const uint SP_TOWER_LOD_2PX=65529u;
static const uint SP_TOWER_LOD_4PX=65528u;
static const uint SP_TOWER_LOD_8PX=65527u;
static const uint SP_TOWER_LOD_SHELL=65526u;
static const uint SP_TOWER_LOD_4PX_RESOLVE=65525u;
static const float SP_TOWER_MAX_FILL_INCIDENCE=.20f;
bool SilPomIsTowerWallModel(uint model)
{
    return model==1u || model==4u;
}
bool SilPomTowerUsesLod(uint mode)
{
    return mode>=SP_TOWER_LOD_4PX_RESOLVE && mode<=SP_TOWER_LOD_2PX;
}
bool SilPomTowerUsesSmoothLod(uint mode)
{
    return mode==SP_TOWER_LOD_4PX || mode==SP_TOWER_LOD_4PX_RESOLVE;
}
bool SilPomTowerNoMarch(uint mode)
{
    return mode==SP_TOWER_NO_MARCH || mode==SP_TOWER_RECTANGLE_CONTROL ||
        mode==SP_TOWER_UNFILLED_CONTROL || SilPomTowerUsesLod(mode);
}
bool SilPomTowerFillEnabled(uint mode)
{
    return mode==SP_TOWER_NO_MARCH || SilPomTowerUsesLod(mode);
}
float SilPomUvArea(SilPomMeshFace f)
{
    return (f.uv1.x-f.uv0.x)*(f.uv2.y-f.uv0.y)-(f.uv1.y-f.uv0.y)*(f.uv2.x-f.uv0.x);
}
float3 SilPomFaceWeights(SilPomMeshFace f, float2 uv)
{
    float area=SilPomUvArea(f);
    float b=((uv.x-f.uv0.x)*(f.uv2.y-f.uv0.y)-(uv.y-f.uv0.y)*(f.uv2.x-f.uv0.x))/area;
    float c=((f.uv1.x-f.uv0.x)*(uv.y-f.uv0.y)-(f.uv1.y-f.uv0.y)*(uv.x-f.uv0.x))/area;
    return float3(1-b-c,b,c);
}
float3 SilPomFaceDirection(SilPomMeshFace f, float2 uv)
{
    float3 w=SilPomFaceWeights(f,uv);
    return f.d0*w.x+f.d1*w.y+f.d2*w.z;
}
// Returns height and derivatives in SOURCE UV coordinates.
float3 SilPomFaceHeight(SP_TEX texture, SilPomPatch p, float2 uv, float2 low)
{
    float u=(uv.x-low.x)*p.tileU/p.width+p.offsetU;
    float v=(uv.y-low.y)*p.tileV/p.height+p.offsetV;
    float x=u*p.textureWidth-.5f,y=v*p.textureHeight-.5f;
    int ix=int(floor(x)),iy=int(floor(y)); float fx=x-floor(x),fy=y-floor(y);
    float a=SilPomTexel(texture,p,ix,iy),b=SilPomTexel(texture,p,ix+1,iy)-a;
    float c=SilPomTexel(texture,p,ix,iy+1)-a;
    float d=SilPomTexel(texture,p,ix+1,iy+1)-a-b-c;
    return float3(p.scale*(a+b*fx+c*fy+d*fx*fy-p.reference),
        p.scale*(b+d*fy)*p.textureWidth*p.tileU/p.width,
        p.scale*(c+d*fx)*p.textureHeight*p.tileV/p.height);
}
float3 SilPomRotateNormal(float3 value,float3 from,float3 to)
{
    float3 axis=cross(from,to);
    return value+cross(axis,value)+cross(axis,cross(axis,value))*(1/(1+dot(from,to)));
}
float3 SilPomFaceNormal(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,float2 uv,float2 low)
{
    float3 h=SilPomFaceHeight(texture,p,uv,low);
    float det=dot(f.du,cross(f.dv,f.normal));
    float3 dualU=cross(f.dv,f.normal)*(1/det),dualV=cross(f.normal,f.du)*(1/det);
    float3 baseNormal=normalize(f.normal-dualU*h.y-dualV*h.z);
    return normalize(SilPomRotateNormal(baseNormal,f.normal,normalize(SilPomFaceDirection(f,uv))));
}
float3 SilPomShadingNormal(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,float2 uv,float2 low,bool useHeight)
{
    if(!useHeight) return f.normal;
    return SilPomFaceNormal(texture,p,f,uv,low);
}
// Bounded Newton refinement of a planar-kernel seed. Never accept an
// unconverged iterate as geometry. This is a local heuristic, not a complete
// intersection algorithm for arbitrary curved surfaces or folded volumes.
uint SilPomRefineFace(SP_TEX texture, SilPomPatch p, SilPomMeshFace f,
    SilPomRay ray,float2 low,SP_REF(float2) uv,SP_REF(float) t,uint maxIterations=16,float toleranceMultiplier=1.0f)
{
    float area=SilPomUvArea(f);
    float3 dU=((f.d1-f.d0)*(f.uv2.y-f.uv0.y)-(f.d2-f.d0)*(f.uv1.y-f.uv0.y))*(1/area);
    float3 dV=((f.d2-f.d0)*(f.uv1.x-f.uv0.x)-(f.d1-f.d0)*(f.uv2.x-f.uv0.x))*(1/area);
    float tolerance=2e-6f*max(1.0f,max(length(f.du),length(f.dv)))*toleranceMultiplier;
    for(uint iteration=0;iteration<maxIterations;++iteration)
    {
        SILPOM_DIAGNOSTIC(1,iteration);
#if !defined(SILPOM_CPU) && defined(SILPOM_VALIDATION_GATHER)
        float3 h;
        [branch] if(SILPOM_VALIDATION_GATHER) h=SilPomGatherFaceHeight(texture,p,uv,low);
        else h=SilPomFaceHeight(texture,p,uv,low);
#else
        float3 h=SilPomFaceHeight(texture,p,uv,low);
#endif
        float3 D=SilPomFaceDirection(f,uv);
        float3 position=f.origin+f.du*(uv.x-f.uv0.x)+f.dv*(uv.y-f.uv0.y)+D*h.x;
        float3 residual=position-(ray.origin+ray.direction*t);
        if(dot(residual,residual)<=tolerance*tolerance)
        {
            float3 w=SilPomFaceWeights(f,uv);
            uint status=min(w.x,min(w.y,w.z))>=-2e-6f && t>=ray.tMin && t<=ray.tMax ? SP_HIT : SP_MISS;
            SILPOM_DIAGNOSTIC(2,status);
            return status;
        }
        float3 U=f.du+dU*h.x+D*h.y,V=f.dv+dV*h.x+D*h.z;
        float determinant=dot(U,cross(V,ray.direction));
        if(abs(determinant)<1e-9f) { SILPOM_DIAGNOSTIC(3,0); return SP_REFINE_REJECTED; }
        float deltaU=-dot(residual,cross(V,ray.direction))/determinant;
        float deltaV=-dot(U,cross(residual,ray.direction))/determinant;
        float deltaT=dot(U,cross(V,residual))/determinant;
        // Keep Newton from jumping across many unrelated heightfield features.
        float step=max(abs(deltaU)/p.width,abs(deltaV)/p.height);
        float damping=step>.25f?.25f/step:1.0f;
        uv.x+=deltaU*damping;uv.y+=deltaV*damping;t+=deltaT*damping;
        if(uv.x<low.x-p.width || uv.x>low.x+2*p.width || uv.y<low.y-p.height || uv.y>low.y+2*p.height)
        { SILPOM_DIAGNOSTIC(4,0); return SP_REFINE_REJECTED; }
    }
    SILPOM_DIAGNOSTIC(5,0);
    return SP_REFINE_REJECTED;
}
// The displaced point is a convex combination of the six corner extrema.
// Bound their projections along three side normals of an oblique triangular
// prism. Clip only the planar seed search. The refinement ray retains its
// original interval because a planar seed can converge to a different t.
bool SilPomSweptFaceInterval(SilPomPatch p, SilPomMeshFace f, SP_REF(SilPomRay) ray)
{
    const float3 b = f.du*(f.uv1.x-f.uv0.x) + f.dv*(f.uv1.y-f.uv0.y);
    const float3 c = f.du*(f.uv2.x-f.uv0.x) + f.dv*(f.uv2.y-f.uv0.y);
    const float3 extrusion = f.d0+f.d1+f.d2;
    const float h0 = -p.scale*p.reference;
    const float h1 = p.scale*(1-p.reference);
    const float3 origin = ray.origin-f.origin;
    const float3 start = origin+ray.direction*ray.tMin;
    const float3 end = origin+ray.direction*ray.tMax;
    // Include the Newton residual and shared-edge tolerances, and allow for
    // cancellation when evaluating a distant ray at the face.
    const float size = max(1.0f,max(length(f.du),max(length(f.dv),abs(p.scale))));
    const float padding = 1e-5f*(size+length(origin));
    float enter = 0.0f, exit = 1.0f;
    for(uint side=0;side<3;++side)
    {
        const float3 edge = side==0 ? b : (side==1 ? c-b : c*(-1.0f));
        const float3 normal = cross(extrusion,edge);
        const float d0 = dot(normal,f.d0), d1 = dot(normal,f.d1), d2 = dot(normal,f.d2);
        const float lower0 = min(d0*h0,d0*h1);
        const float lower1 = dot(normal,b)+min(d1*h0,d1*h1);
        const float lower2 = dot(normal,c)+min(d2*h0,d2*h1);
        const float lower = min(lower0,min(lower1,lower2))
            -padding*(abs(normal.x)+abs(normal.y)+abs(normal.z));
        const float first = dot(normal,start)-lower;
        const float last = dot(normal,end)-lower;
        if(max(first,last)<0.0f) return false;
        if(min(first,last)<0.0f)
        {
            const float crossing = first/(first-last);
            if(first<0.0f) enter=max(enter,crossing);
            else exit=min(exit,crossing);
        }
    }
    if(enter>exit+1e-6f) return false;

    const float span = ray.tMax-ray.tMin;
    ray.tMin += span*max(0.0f,enter-1e-6f);
    ray.tMax -= span*max(0.0f,1.0f-exit-1e-6f);
    return true;
}

bool SilPomMakeSeedRay(SilPomMeshFace f,float3 D,SilPomRay worldRay,SP_REF(SilPomRay) ray)
{
    float determinant=dot(f.du,cross(f.dv,D));
    if(abs(determinant)<1e-10f) return false;
    float3 U=cross(f.dv,D)*(1/determinant),V=cross(D,f.du)*(1/determinant),Z=cross(f.du,f.dv)*(1/determinant);
    ray.origin=float3(f.uv0.x+dot(U,worldRay.origin-f.origin),f.uv0.y+dot(V,worldRay.origin-f.origin),dot(Z,worldRay.origin-f.origin));
    ray.direction=float3(dot(U,worldRay.direction),dot(V,worldRay.direction),dot(Z,worldRay.direction));
    return true;
}

SilPomHit SilPomSearchFace(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,
    SilPomRay worldRay,float2 low,float searchBegin,float searchEnd,bool constant
#if SILPOM_MESH_DEPTH_BOUNDS
    ,SP_BOUND_TEX bounds,bool useBounds
#endif
    ,bool useHeightDerivedNormals=true
)
{
    SilPomHit best=SP_ZERO(SilPomHit);best.t=worldRay.tMax;
    float2 center=float2(low.x+p.width*.5f,low.y+p.height*.5f);
    uint spent=0;bool unresolved=false;
    for(uint seed=0;seed<(constant?1u:4u);++seed)
    {
        float3 D=seed==0?(f.d0+f.d1+f.d2)*(1.0f/3.0f):(seed==1?f.d0:(seed==2?f.d1:f.d2));
        SilPomRay ray;
        if(!SilPomMakeSeedRay(f,D,worldRay,ray)) {best.status=SP_INVALID;return best;}
        ray.tMin=searchBegin;ray.tMax=searchEnd;
        if(constant)
        {
            float begin,end;
            if(!SilPomFaceInterval(ray,f.uv0,f.uv1,f.uv2,begin,end)) continue;
            ray.tMin=begin;ray.tMax=end;
        }
        ray.origin.x-=center.x;ray.origin.y-=center.y;
        // Outside-triangle roots of the seed rectangle must not hide later
        // roots inside the triangle. Bound both candidates and total cell work.
        for(uint candidate=0;candidate<8;++candidate)
        {
            if(spent>=p.maxCells) {unresolved=true;break;}
            SilPomPatch bounded=p;bounded.maxCells=p.maxCells-spent;
#if SILPOM_MESH_DEPTH_BOUNDS
            SilPomHit hit=SilPomIntersectMode(texture,bounded,ray,true,bounds,useBounds);
#else
            SilPomHit hit=SilPomIntersect(texture,bounded,ray);
#endif
            spent+=hit.cells;
            if(hit.status==SP_MISS) break;
            if(hit.status!=SP_HIT) {unresolved=true;break;}
            float2 uv=float2(hit.position.x+center.x,hit.position.y+center.y);float t=hit.t;
            uint status=constant?SP_HIT:SilPomRefineFace(texture,p,f,worldRay,low,uv,t);
            if(status==SP_HIT)
            {
                if(best.status!=SP_HIT || t<best.t)
                {
                    best=hit;best.status=SP_HIT;best.t=t;
                    best.position=worldRay.origin+worldRay.direction*t;
                    best.uv=float2((uv.x-low.x)*p.tileU/p.width+p.offsetU,(uv.y-low.y)*p.tileV/p.height+p.offsetV);
#if SILPOM_HIT_DEPTH
                    best.faceUv=uv;
#else
                    best.normal=SilPomShadingNormal(texture,p,f,uv,low,useHeightDerivedNormals);
#endif
                }
                break;
            }
            // Rejected/outside seeds contribute no geometry. Continue looking
            // for candidates; only actual work-budget limits set unresolved.
            ray.tMin=hit.t+max(1e-5f,abs(hit.t)*1e-6f);
            if(candidate==7) unresolved=true;
        }
    }
    best.cells=spent;
#if SILPOM_MESH_DEPTH_BOUNDS
    if(useBounds && unresolved) best.status=SP_EXHAUSTED;
#endif
    if(best.status!=SP_HIT && unresolved) {best.status=SP_EXHAUSTED;best.t=worldRay.tMin;}
    return best;
}

void SilPomFaceBounds(SilPomMeshFace f,float scale,float reference,SP_REF(float3) boundsLow,SP_REF(float3) boundsHigh)
{
    boundsLow=float3(1e30f,1e30f,1e30f);
    boundsHigh=float3(-1e30f,-1e30f,-1e30f);
    for(uint i=0;i<6;++i)
    {
        float2 uv=i/2==0?f.uv0:(i/2==1?f.uv1:f.uv2);
        float3 D=i/2==0?f.d0:(i/2==1?f.d1:f.d2);
        float h=scale*(float(i%2)-reference);
        float3 cornerPosition=f.origin+f.du*(uv.x-f.uv0.x)+f.dv*(uv.y-f.uv0.y)+D*h;
        boundsLow=min(boundsLow,cornerPosition);boundsHigh=max(boundsHigh,cornerPosition);
    }
}

