#pragma once
#include "VisibilityInputs.azsli"
#include "NeuralVisibilityPhysicalWeights.azsli"
#include "VisibilityClassificationThresholds.azsli"
// Owned by one center lighting invocation, after normal-only AA probes. This
// cache never receives writes from generic height/normal acquisition helpers.
struct SilPomNeuralPhysicalReceiver
{
    bool cacheAvailable,framePrepared,frameValid,heightPrepared;
    float3 direction,du,dv,crossDvDirection;
    float determinant,start;
};
void SilPomInitNeuralPhysicalReceiver(SP_REF(SilPomNeuralPhysicalReceiver) receiver)
{
    receiver.cacheAvailable=true;receiver.framePrepared=false;
    receiver.frameValid=false;receiver.heightPrepared=false;
}
bool SilPomPrepareNeuralLocalShadow(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,float2 uv,float2 low,
    float3 light,uint steps,float maxDistance,SP_REF(SilPomNeuralPhysicalReceiver) receiver,
    SP_REF(SilPomLocalShadowRay) ray,SP_REF(float) immediate)
{
    // Cache failure changes acquisition cost, never the selected estimator.
    if(!receiver.cacheAvailable)
        return SilPomPrepareLocalShadow(texture,p,f,uv,low,light,steps,maxDistance,true,ray,immediate);
    immediate=1;
    if(steps==0 || abs(p.scale)<1e-8f)return false;
    if(!receiver.framePrepared)
    {
        receiver.direction=SilPomFaceDirection(f,uv);
        receiver.du=f.du;receiver.dv=f.dv;
        receiver.crossDvDirection=cross(f.dv,receiver.direction);
        receiver.determinant=dot(f.du,receiver.crossDvDirection);
        receiver.frameValid=!(abs(receiver.determinant)<1e-10f);
        receiver.framePrepared=true;
    }
    if(!receiver.frameValid)return false;
    // Retain the original scalar-triple-product and division order.
    ray.uRate=dot(light,receiver.crossDvDirection)/receiver.determinant;
    ray.vRate=dot(receiver.du,cross(light,receiver.direction))/receiver.determinant;
    ray.hRate=dot(receiver.du,cross(receiver.dv,light))/receiver.determinant;
    if(ray.hRate<=0){immediate=0;return false;}
    float rate=max(abs(ray.uRate*p.tileU/p.width)*p.textureWidth,
                   abs(ray.vRate*p.tileV/p.height)*p.textureHeight);
    if(rate<1e-8f){immediate=ray.hRate>=0?1:0;return false;}
    if(!receiver.heightPrepared)
    {
        receiver.start=SilPomShadowHeight(texture,p,uv,low);
        receiver.heightPrepared=true;
    }
    ray.start=receiver.start;
    ray.top=max(-p.scale*p.reference,p.scale*(1-p.reference));
    ray.bias=max(1e-5f,abs(p.scale)*.002f);
    ray.count=min(steps,64u);ray.step=1.0f/rate;ray.extra=0;
    float reach=SilPomPhysicalShadowReach(ray.start,ray.top,ray.bias,ray.hRate,maxDistance);
    if(reach<=0)return false;
    ray.step=min(ray.step,reach/float(ray.count));
    ray.extra=max(0.0f,reach-ray.step*float(ray.count));
    ray.reach=ray.step*float(ray.count)+ray.extra;
    if(ray.hRate>0 && ray.start+ray.hRate*ray.step+ray.bias>=ray.top)return false;
    return true;
}
float SilPomPhysicalVisibilityProbability(float feature[10],uint model)
{
    float logit;
#ifdef SILPOM_OVERRIDE_VISIBILITY
    if(!SILPOM_OVERRIDE_VISIBILITY(feature,logit))
#endif
    {
        SP_BRANCH if(model==4u) logit=SilPomVisibilityNetwork(feature,PhysicalVisibilityWallW0,PhysicalVisibilityWallB0,PhysicalVisibilityWallW1,PhysicalVisibilityWallB1);
        else if(model==5u) logit=SilPomVisibilityNetwork(feature,PhysicalVisibilityStairsW0,PhysicalVisibilityStairsB0,PhysicalVisibilityStairsW1,PhysicalVisibilityStairsB1);
        else if(model==6u) logit=SilPomVisibilityNetwork(feature,PhysicalVisibilityTrimW0,PhysicalVisibilityTrimB0,PhysicalVisibilityTrimW1,PhysicalVisibilityTrimB1);
        else logit=SilPomVisibilityNetwork(feature,PhysicalVisibilityRevealW0,PhysicalVisibilityRevealB0,PhysicalVisibilityRevealW1,PhysicalVisibilityRevealB1);
    }
    return SilPomVisibilityProbabilityFromLogit(logit);
}
// Fixed acquisition budget, then a final binary decision. This source has no
// dependency on either local visibility marcher. Material preparation validates
// the supported model/profile, positive scale and sample schedule (0 or 5-64).
float SilPomNeuralVisibilityForRay(SP_TEX texture,SilPomPatch p,float2 uv,float2 low,
    SilPomLocalShadowRay ray,uint model,float threshold)
{
    // Saturation is a deliberate bounded representation, not an algorithm
    // switch. Report these queries separately in offline accuracy measurements.
    float travelU=ray.uRate*ray.reach*p.textureWidth*p.tileU/p.width;
    float travelV=ray.vRate*ray.reach*p.textureHeight*p.tileV/p.height;
    if(max(abs(travelU),abs(travelV))>256.0f || abs(ray.hRate*ray.reach/p.scale)>2.0f)
    { SILPOM_SHADOW_STAT(11); }
    float feature[10];
    if(!SilPomVisibilityFeatures(texture,p,uv,low,ray,feature)) return 0;
    float visible=SilPomPhysicalVisibilityProbability(feature,model);
    if(visible>=threshold) { SILPOM_SHADOW_STAT(3);return 1; }
    SILPOM_SHADOW_STAT(4);return 0;
}
float SilPomNeuralOnlyVisibility(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,
    float2 uv,float2 low,float3 light,uint steps,float maxDistance,uint model,float threshold)
{
    SilPomLocalShadowRay ray;float immediate;
    if(!SilPomPrepareLocalShadow(texture,p,f,uv,low,light,steps,maxDistance,true,ray,immediate))
    { SILPOM_SHADOW_STAT(1);return immediate; }
    return SilPomNeuralVisibilityForRay(texture,p,uv,low,ray,model,threshold);
}
float SilPomNeuralOnlyVisibilityPrepared(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,
    float2 uv,float2 low,float3 light,uint steps,float maxDistance,uint model,float threshold,
    SP_REF(SilPomNeuralPhysicalReceiver) receiver)
{
    SilPomLocalShadowRay ray;float immediate;
    if(!SilPomPrepareNeuralLocalShadow(texture,p,f,uv,low,light,steps,maxDistance,receiver,ray,immediate))
    { SILPOM_SHADOW_STAT(1);return immediate; }
    return SilPomNeuralVisibilityForRay(texture,p,uv,low,ray,model,threshold);
}
float SilPomNeuralOnlyThreshold(uint model)
{
    return model==4u?VisibilityWallThreshold:model==5u?VisibilityStairsThreshold:
        model==6u?VisibilityTrimThreshold:VisibilityRevealThreshold;
}
