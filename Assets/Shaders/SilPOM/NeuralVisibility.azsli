#pragma once
#include "VisibilityInputs.azsli"
#include "NeuralVisibilityPhysicalWeights.azsli"
#include "VisibilityClassificationThresholds.azsli"
float SilPomPhysicalVisibilityProbability(float feature[10],uint model)
{
    float logit;
#ifdef SILPOM_OVERRIDE_VISIBILITY
    if(!SILPOM_OVERRIDE_VISIBILITY(feature,logit))
#endif
    {
        SP_BRANCH if(model==4u) logit=SilPomVisibilityNetwork(feature,PhysicalVisibilityWallW0,PhysicalVisibilityWallB0,PhysicalVisibilityWallW1,PhysicalVisibilityWallB1);
        else if(model==5u) logit=SilPomVisibilityNetwork(feature,PhysicalVisibilityStairsW0,PhysicalVisibilityStairsB0,PhysicalVisibilityStairsW1,PhysicalVisibilityStairsB1);
        else if(model==6u) logit=SilPomVisibilityNetwork(feature,PhysicalVisibilityTrimW0,PhysicalVisibilityTrimB0,PhysicalVisibilityTrimW1,PhysicalVisibilityTrimB1);
        else logit=SilPomVisibilityNetwork(feature,PhysicalVisibilityRevealW0,PhysicalVisibilityRevealB0,PhysicalVisibilityRevealW1,PhysicalVisibilityRevealB1);
    }
    return SilPomVisibilityProbabilityFromLogit(logit);
}
// Fixed acquisition budget, then a final binary decision. This source has no
// dependency on either local visibility marcher. Material preparation validates
// the supported model/profile, positive scale and sample schedule (0 or 5-64).
float SilPomNeuralOnlyVisibility(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,
    float2 uv,float2 low,float3 light,uint steps,float maxDistance,uint model,float threshold)
{
    SilPomLocalShadowRay ray;float immediate;
    if(!SilPomPrepareLocalShadow(texture,p,f,uv,low,light,steps,maxDistance,true,ray,immediate))
    { SILPOM_SHADOW_STAT(1);return immediate; }
    // Saturation is a deliberate bounded representation, not an algorithm
    // switch. Report these queries separately in offline accuracy measurements.
    float travelU=ray.uRate*ray.reach*p.textureWidth*p.tileU/p.width;
    float travelV=ray.vRate*ray.reach*p.textureHeight*p.tileV/p.height;
    if(max(abs(travelU),abs(travelV))>256.0f || abs(ray.hRate*ray.reach/p.scale)>2.0f)
    { SILPOM_SHADOW_STAT(11); }
    float feature[10];
    if(!SilPomVisibilityFeatures(texture,p,uv,low,ray,feature)) return 0;
    float visible=SilPomPhysicalVisibilityProbability(feature,model);
    if(visible>=threshold) { SILPOM_SHADOW_STAT(3);return 1; }
    SILPOM_SHADOW_STAT(4);return 0;
}
float SilPomNeuralOnlyThreshold(uint model)
{
    return model==4u?VisibilityWallThreshold:model==5u?VisibilityStairsThreshold:
        model==6u?VisibilityTrimThreshold:VisibilityRevealThreshold;
}
