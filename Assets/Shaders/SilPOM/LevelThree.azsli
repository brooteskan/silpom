#pragma once
#include "NeuralVisibilityWeights.azsli"
#ifndef SILPOM_SHADOW_STAT
#define SILPOM_SHADOW_STAT(event)
#endif
struct SilPomLocalShadowRay
{
    float uRate,vRate,hRate,start,top,bias,step,extra,reach;
    uint count;
};
float SilPomShadowHeight(SP_TEX texture,SilPomPatch p,float2 uv,float2 low)
{
    SILPOM_SHADOW_STAT(0);
#ifdef SILPOM_CPU
    return SilPomFaceHeight(texture,p,uv,low).x;
#else
    return SilPomGatherFaceHeight(texture,p,uv,low).x;
#endif
}
bool SilPomPrepareLocalShadow(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,float2 uv,float2 low,
    float3 toLight,uint steps,float maxDistance,SP_REF(SilPomLocalShadowRay) ray,SP_REF(float) immediate)
{
    immediate=1;
    if(steps==0 || abs(p.scale)<1e-8f) return false;
    float3 D=SilPomFaceDirection(f,uv);
    float determinant=dot(f.du,cross(f.dv,D));
    if(abs(determinant)<1e-10f) return false;
    ray.uRate=dot(toLight,cross(f.dv,D))/determinant;
    ray.vRate=dot(f.du,cross(toLight,D))/determinant;
    ray.hRate=dot(f.du,cross(f.dv,toLight))/determinant;
    float rate=max(abs(ray.uRate*p.tileU/p.width)*p.textureWidth,
                   abs(ray.vRate*p.tileV/p.height)*p.textureHeight);
    if(rate<1e-8f) { immediate=ray.hRate>=0?1:0;return false; }
    ray.start=SilPomShadowHeight(texture,p,uv,low);
    ray.top=max(-p.scale*p.reference,p.scale*(1-p.reference));
    ray.bias=max(1e-5f,abs(p.scale)*.002f);
    ray.count=min(steps,64u);ray.step=1.0f/rate;ray.extra=0;
    if(maxDistance>0)
    {
        float reach=ray.hRate>0?min(maxDistance,(ray.top-ray.start-ray.bias)/ray.hRate):maxDistance;
        if(reach<=0) return false;
        ray.step=min(ray.step,reach/float(ray.count));
        ray.extra=max(0.0f,reach-ray.step*float(ray.count));
    }
    ray.reach=ray.step*float(ray.count)+ray.extra;
    if(ray.hRate>0 && ray.start+ray.hRate*ray.step+ray.bias>=ray.top) return false;
    return true;
}
float SilPomLocalShadowTime(SilPomLocalShadowRay ray,uint i)
{
    float fraction=float(i)/float(ray.count);
    return float(i)*ray.step+ray.extra*fraction*fraction;
}
float SilPomMarchLocalShadow(SP_TEX texture,SilPomPatch p,float2 uv,float2 low,
    SilPomLocalShadowRay ray,bool skipProbes)
{
    uint b=(ray.count+2u)/3u,c=(2u*ray.count+2u)/3u;
    for(uint i=1;i<=ray.count;++i)
    {
        float t=SilPomLocalShadowTime(ray,i);
        float height=ray.start+ray.hRate*t+ray.bias;
        if(ray.hRate>0 && height>=ray.top) return 1;
        if(skipProbes && (i==1u||i==b||i==c||i==ray.count)) continue;
        if(SilPomShadowHeight(texture,p,float2(uv.x+ray.uRate*t,uv.y+ray.vRate*t),low)>height) return 0;
    }
    return 1;
}
float SilPomVisibilityNetwork(float feature[10],const float w0[12][10],const float b0[12],const float w1[12],float b1)
{
    float value=b1;
    SP_UNROLL for(uint j=0;j<12;++j)
    {
        float unit=b0[j];
        SP_UNROLL for(uint k=0;k<10;++k) unit+=feature[k]*w0[j][k];
        unit=max(unit,0.0f);value+=unit*unit*w1[j];
    }
    return value;
}
float SilPomLearnedReliefVisibility(SP_TEX texture,SilPomPatch p,SilPomMeshFace f,
    float2 uv,float2 low,float3 toLight,uint steps,float maxDistance,uint model,bool neural,float confidence)
{
    SilPomLocalShadowRay ray;float immediate;
    if(!SilPomPrepareLocalShadow(texture,p,f,uv,low,toLight,steps,maxDistance,ray,immediate))
    { SILPOM_SHADOW_STAT(1);return immediate; }
    if(!neural || ray.count<=4u || model<4u || model>7u || p.scale<=0)
    { SILPOM_SHADOW_STAT(6);return SilPomMarchLocalShadow(texture,p,uv,low,ray,false); }
    // Avoid extrapolating beyond the descriptor's trained travel/rise domain.
    float travelU=ray.uRate*ray.reach*p.textureWidth*p.tileU/p.width;
    float travelV=ray.vRate*ray.reach*p.textureHeight*p.tileV/p.height;
    if(max(abs(travelU),abs(travelV))>256.0f || abs(ray.hRate*ray.reach/p.scale)>2.0f)
    { SILPOM_SHADOW_STAT(6);return SilPomMarchLocalShadow(texture,p,uv,low,ray,false); }
    float feature[10];
    uint indices[4];indices[0]=1u;indices[1]=(ray.count+2u)/3u;indices[2]=(2u*ray.count+2u)/3u;indices[3]=ray.count;
    SP_UNROLL for(uint i=0;i<4;++i)
    {
        float t=SilPomLocalShadowTime(ray,indices[i]);
        float delta=SilPomShadowHeight(texture,p,float2(uv.x+ray.uRate*t,uv.y+ray.vRate*t),low)
            -(ray.start+ray.hRate*t+ray.bias);
        feature[i]=clamp(delta/abs(p.scale),-2.0f,2.0f);
        if(delta>0) { SILPOM_SHADOW_STAT(2);return 0; }
    }
    feature[4]=travelU/64.0f;
    feature[5]=travelV/64.0f;
    feature[6]=clamp(ray.hRate*ray.reach/abs(p.scale),-2.0f,2.0f);
    feature[7]=ray.start/p.scale+p.reference;
    feature[8]=float(ray.count)/64.0f;
    feature[9]=ray.step*float(ray.count)/max(ray.reach,1e-8f);
#ifdef SILPOM_CAPTURE_VISIBILITY
    SILPOM_CAPTURE_VISIBILITY(feature,ray);
#endif
    float logit;
#ifdef SILPOM_OVERRIDE_VISIBILITY
    if(!SILPOM_OVERRIDE_VISIBILITY(feature,logit))
#endif
    {
        SP_BRANCH if(model==4u) logit=SilPomVisibilityNetwork(feature,VisibilityWallW0,VisibilityWallB0,VisibilityWallW1,VisibilityWallB1);
        else if(model==5u) logit=SilPomVisibilityNetwork(feature,VisibilityStairsW0,VisibilityStairsB0,VisibilityStairsW1,VisibilityStairsB1);
        else if(model==6u) logit=SilPomVisibilityNetwork(feature,VisibilityTrimW0,VisibilityTrimB0,VisibilityTrimW1,VisibilityTrimB1);
        else logit=SilPomVisibilityNetwork(feature,VisibilityRevealW0,VisibilityRevealB0,VisibilityRevealW1,VisibilityRevealB1);
    }
    float visible=rcp(1.0f+exp(-clamp(logit,-20.0f,20.0f)));
#ifdef SILPOM_VISIBILITY_PROBABILITY
    SILPOM_VISIBILITY_PROBABILITY(visible);
#endif
    SILPOM_SHADOW_STAT(7);
    if(visible>=confidence) { SILPOM_SHADOW_STAT(3);return 1; }
    if(visible<=1.0f-confidence) { SILPOM_SHADOW_STAT(4);return 0; }
    SILPOM_SHADOW_STAT(5);
    return SilPomMarchLocalShadow(texture,p,uv,low,ray,true);
}
