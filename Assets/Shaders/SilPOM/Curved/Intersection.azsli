// SPDX-License-Identifier: MIT
// Shared per-ray kernel. Configure SP_CURVED_DATA/SP_CURVED_HEIGHT and the
// surface parameters before inclusion. Traversal is independent of submission.
#pragma once
struct SilPomCurved_Ray
{
    float3 origin;
    float3 direction;
    float tMin;
    float tMax;
};
struct SilPomCurved_Result
{
    uint status;
    uint primitiveId;
    uint nodes;
    uint maximumDepth;
    float t;
    float tError;
    float3 barycentric;
    float unresolvedT;
    float unresolvedUpper;
    uint singular;
    uint exhaustionReasons;
    float2 uv;
    float3 normal;
};
static const uint SilPomCurved_Miss = 0;
static const uint SilPomCurved_Hit = 1;
static const uint SilPomCurved_Exhausted = 2;
static const uint SilPomCurved_Invalid = 3;
static const uint SilPomCurved_ReasonNodeBudget = 1u << 0;
static const uint SilPomCurved_ReasonMaximumDepth = 1u << 1;
static const uint SilPomCurved_ReasonParameterResolution = 1u << 2;
static const uint SilPomCurved_ReasonDepthResolution = 1u << 3;
static const uint SilPomCurved_ReasonUncertifiedLeaf = 1u << 4;
static const uint SilPomCurved_ReasonStackCapacity = 1u << 5;
// Four-way depth-first subdivision needs at most 1 + 3 * depth entries.
// The default depth 12 therefore needs 37, not 128, entries per ray. Larger
// requested depths still fail explicitly if this capacity is insufficient.
static const uint SilPomCurved_StackCapacity = 48;

int SilPomCurved_Address(int value, int size)
{
    return addressMode == 0 ? ((value % size) + size) % size : clamp(value, 0, size - 1);
}

float SilPomCurved_Height(float2 uv)
{
    float2 q = uv * float2(textureWidth, textureHeight) - .5f;
    int2 cell = int2(floor(q));
    float2 f = q - cell;
    float h00 = SP_CURVED_HEIGHT(int3(SilPomCurved_Address(cell.x, textureWidth), SilPomCurved_Address(cell.y, textureHeight), 0));
    float h10 = SP_CURVED_HEIGHT(int3(SilPomCurved_Address(cell.x + 1, textureWidth), SilPomCurved_Address(cell.y, textureHeight), 0));
    float h01 = SP_CURVED_HEIGHT(int3(SilPomCurved_Address(cell.x, textureWidth), SilPomCurved_Address(cell.y + 1, textureHeight), 0));
    float h11 = SP_CURVED_HEIGHT(int3(SilPomCurved_Address(cell.x + 1, textureWidth), SilPomCurved_Address(cell.y + 1, textureHeight), 0));
    return lerp(lerp(h00, h10, f.x), lerp(h01, h11, f.x), f.y);
}

struct SilPomCurved_Fragment
{
    float3 position[3];
    float3 direction[3];
    float2 uv[3];
    float3 domain[3];
    uint primitiveId;
    float2 cell;
    float4 height; // h00, dh/dx, dh/dy, d2h/dxdy; not multiplied by amplitude
};

SilPomCurved_Fragment SilPomCurved_LoadFragment(uint index)
{
    uint offset = index * 11;
    SilPomCurved_Fragment f = (SilPomCurved_Fragment)0;
    if(packedTriangleCount != 0)
    {
        uint fragmentOffset=(packedTriangleCount&0x3fffffffu)*8+index*((packedTriangleCount&0x80000000u)!=0?5:4);
        float4 b01=SP_CURVED_DATA(fragmentOffset),b2=SP_CURVED_DATA(fragmentOffset+1);
        f.domain[0]=float3(1-b01.x-b01.y,b01.xy);
        f.domain[1]=float3(1-b01.z-b01.w,b01.zw);
        f.domain[2]=float3(1-b2.x-b2.y,b2.xy);
        f.height=SP_CURVED_DATA(fragmentOffset+2);
        f.cell=SP_CURVED_DATA(fragmentOffset+3).xy;
        offset=asuint(b2.z)*8;
    }
    f.position[0] = SP_CURVED_DATA(offset + 0).xyz;
    f.position[1] = SP_CURVED_DATA(offset + 1).xyz;
    f.position[2] = SP_CURVED_DATA(offset + 2).xyz;
    f.direction[0] = SP_CURVED_DATA(offset + 3).xyz;
    f.direction[1] = SP_CURVED_DATA(offset + 4).xyz;
    f.direction[2] = SP_CURVED_DATA(offset + 5).xyz;
    float4 uv01 = SP_CURVED_DATA(offset + 6);
    f.uv[0] = uv01.xy;
    f.uv[1] = uv01.zw;
    f.uv[2] = SP_CURVED_DATA(offset + 7).xy;
    f.primitiveId = asuint(SP_CURVED_DATA(offset + 7).z);
    if(packedTriangleCount == 0)
    {
        f.domain[0] = SP_CURVED_DATA(offset + 8).xyz;
        f.domain[1] = SP_CURVED_DATA(offset + 9).xyz;
        f.domain[2] = SP_CURVED_DATA(offset + 10).xyz;
    }
    return f;
}

bool SilPomCurved_FragmentMayIntersect(uint index,SilPomCurved_Ray ray,SilPomCurved_Result result)
{
    if((packedTriangleCount&0x80000000u)==0)return true;
    uint offset=(packedTriangleCount&0x3fffffffu)*8+index*5;
    float4 a=SP_CURVED_DATA(offset+3),b=SP_CURVED_DATA(offset+4);
    float3 low=float3(a.z,a.w,b.x),high=b.yzw;
    float begin=ray.tMin,end=result.status==SilPomCurved_Hit?min(ray.tMax,result.t+result.tError):ray.tMax;
    [unroll] for(uint axis=0;axis!=3;++axis)
    {
        float error=16.0f*1.192092896e-7f*max(1.0f,max(abs(ray.origin[axis]),max(abs(low[axis]),abs(high[axis]))));
        low[axis]-=error;high[axis]+=error;
        if(ray.direction[axis]==0)
        {if(ray.origin[axis]<low[axis]||ray.origin[axis]>high[axis])return false;}
        else
        {
            float t0=(low[axis]-ray.origin[axis])/ray.direction[axis],t1=(high[axis]-ray.origin[axis])/ray.direction[axis];
            begin=max(begin,min(t0,t1));end=min(end,max(t0,t1));
        }
    }
    return begin<=end;
}

float3 SilPomCurved_SurfacePoint(SilPomCurved_Fragment f, float3 barycentric)
{
    float3 p = f.position[0] * barycentric.x + f.position[1] * barycentric.y + f.position[2] * barycentric.z;
    float3 d = f.direction[0] * barycentric.x + f.direction[1] * barycentric.y + f.direction[2] * barycentric.z;
    float2 uv = f.uv[0] * barycentric.x + f.uv[1] * barycentric.y + f.uv[2] * barycentric.z;
    float2 q=uv*float2(textureWidth,textureHeight)-.5f-f.cell;
    float height=packedTriangleCount==0?SilPomCurved_Height(uv):
        f.height.x+f.height.y*q.x+f.height.z*q.y+f.height.w*q.x*q.y;
    return baseScale * p + amplitude * (height - reference) * d;
}

// Polar form of a quadratic height polynomial. Evaluating at equal arguments
// gives height; unequal arguments give the mixed quadratic Bernstein controls.
float SilPomCurved_HeightBlossom(SilPomCurved_Fragment f,float2 a,float2 b)
{
    return amplitude*(f.height.x-reference+.5f*f.height.y*(a.x+b.x)+
        .5f*f.height.z*(a.y+b.y)+.5f*f.height.w*(a.x*b.y+a.y*b.x));
}

void SilPomCurved_SurfaceFrame(SilPomCurved_Fragment f,float3 barycentric,out float2 uv,out float3 du,out float3 dv)
{
    uv=f.uv[0]*barycentric.x+f.uv[1]*barycentric.y+f.uv[2]*barycentric.z;
    float2 q=uv*float2(textureWidth,textureHeight)-.5f-f.cell;
    float4 h=f.height;
    if(packedTriangleCount==0)
    {
        float2 texel=uv*float2(textureWidth,textureHeight)-.5f;int2 cell=int2(floor(texel));q=texel-cell;
        float h00=SP_CURVED_HEIGHT(int3(SilPomCurved_Address(cell.x,textureWidth),SilPomCurved_Address(cell.y,textureHeight),0));
        float h10=SP_CURVED_HEIGHT(int3(SilPomCurved_Address(cell.x+1,textureWidth),SilPomCurved_Address(cell.y,textureHeight),0));
        float h01=SP_CURVED_HEIGHT(int3(SilPomCurved_Address(cell.x,textureWidth),SilPomCurved_Address(cell.y+1,textureHeight),0));
        float h11=SP_CURVED_HEIGHT(int3(SilPomCurved_Address(cell.x+1,textureWidth),SilPomCurved_Address(cell.y+1,textureHeight),0));
        h=float4(h00,h10-h00,h01-h00,h11-h10-h01+h00);
    }
    float displacement=amplitude*(h.x+h.y*q.x+h.z*q.y+h.w*q.x*q.y-reference);
    float2 gradient=amplitude*float2(h.y+h.w*q.y,h.z+h.w*q.x)*float2(textureWidth,textureHeight);
    float3 direction=f.direction[0]*barycentric.x+f.direction[1]*barycentric.y+f.direction[2]*barycentric.z;
    du=baseScale*(f.position[1]-f.position[0])+direction*dot(gradient,f.uv[1]-f.uv[0])+
        displacement*(f.direction[1]-f.direction[0]);
    dv=baseScale*(f.position[2]-f.position[0])+direction*dot(gradient,f.uv[2]-f.uv[0])+
        displacement*(f.direction[2]-f.direction[0]);
}

float3 SilPomCurved_DomainPoint(float3 a, float3 b, float3 c, float3 local)
{
    return a * local.x + b * local.y + c * local.z;
}

struct SilPomCurved_Projection { uint major; uint first; uint second; };
SilPomCurved_Projection SilPomCurved_MakeProjection(float3 direction)
{
    SilPomCurved_Projection p;
    p.major=2;p.first=0;p.second=1;
    if (abs(direction.x) >= abs(direction.y) && abs(direction.x) >= abs(direction.z))
    {p.major=0;p.first=1;p.second=2;}
    else if (abs(direction.y) >= abs(direction.z))
    {p.major=1;p.first=0;p.second=2;}
    return p;
}

float3 SilPomCurved_Project(SilPomCurved_Ray ray, SilPomCurved_Projection p, float3 position)
{
    float3 relative = position - ray.origin;
    return float3(ray.direction[p.major] * relative[p.first] - ray.direction[p.first] * relative[p.major],
        ray.direction[p.major] * relative[p.second] - ray.direction[p.second] * relative[p.major],
        relative[p.major] / ray.direction[p.major]);
}

void SilPomCurved_Include(inout float3 lo, inout float3 hi, float3 value)
{
    lo = min(lo, value);
    hi = max(hi, value);
}

void SilPomCurved_EdgeControls(inout float3 lo, inout float3 hi, float3 p0, float3 p3, float3 p13, float3 p23,
    out float3 c1, out float3 c2)
{
    float3 a = 27.0f * p13 - 8.0f * p0 - p3;
    float3 b = 27.0f * p23 - p0 - 8.0f * p3;
    c1 = (2.0f * a - b) / 18.0f;
    c2 = (2.0f * b - a) / 18.0f;
    SilPomCurved_Include(lo, hi, c1);
    SilPomCurved_Include(lo, hi, c2);
}

void SilPomCurved_PatchControls(SilPomCurved_Fragment fragment, SilPomCurved_Ray ray, SilPomCurved_Projection projection, float3 a, float3 b, float3 c,
    out float3 controls[10])
{
    if(packedTriangleCount!=0)
    {
        float3 bary[3]={a,b,c};float3 p[3],d[3];float2 q[3];
        [unroll] for(uint i=0;i!=3;++i)
        {
            p[i]=baseScale*(fragment.position[0]*bary[i].x+fragment.position[1]*bary[i].y+fragment.position[2]*bary[i].z);
            d[i]=fragment.direction[0]*bary[i].x+fragment.direction[1]*bary[i].y+fragment.direction[2]*bary[i].z;
            q[i]=(fragment.uv[0]*bary[i].x+fragment.uv[1]*bary[i].y+fragment.uv[2]*bary[i].z)*
                float2(textureWidth,textureHeight)-.5f-fragment.cell;
        }
        float h0=SilPomCurved_HeightBlossom(fragment,q[0],q[0]),h1=SilPomCurved_HeightBlossom(fragment,q[1],q[1]);
        float h2=SilPomCurved_HeightBlossom(fragment,q[2],q[2]),h01=SilPomCurved_HeightBlossom(fragment,q[0],q[1]);
        float h12=SilPomCurved_HeightBlossom(fragment,q[1],q[2]),h20=SilPomCurved_HeightBlossom(fragment,q[2],q[0]);
        controls[0]=p[0]+h0*d[0];controls[1]=p[1]+h1*d[1];controls[2]=p[2]+h2*d[2];
        controls[3]=(2*p[0]+p[1]+h0*d[1]+2*h01*d[0])/3;
        controls[4]=(p[0]+2*p[1]+h1*d[0]+2*h01*d[1])/3;
        controls[5]=(2*p[1]+p[2]+h1*d[2]+2*h12*d[1])/3;
        controls[6]=(p[1]+2*p[2]+h2*d[1]+2*h12*d[2])/3;
        controls[7]=(2*p[2]+p[0]+h2*d[0]+2*h20*d[2])/3;
        controls[8]=(p[2]+2*p[0]+h0*d[2]+2*h20*d[0])/3;
        controls[9]=(p[0]+p[1]+p[2]+h01*d[2]+h12*d[0]+h20*d[1])/3;
        [unroll] for(uint j=0;j!=10;++j)controls[j]=SilPomCurved_Project(ray,projection,controls[j]);
        return;
    }
    #define EVAL(local) SilPomCurved_Project(ray, projection, SilPomCurved_SurfacePoint(fragment, SilPomCurved_DomainPoint(a,b,c,local)))
    controls[0] = EVAL(float3(1,0,0));
    controls[1] = EVAL(float3(0,1,0));
    controls[2] = EVAL(float3(0,0,1));
    float3 lo = min(controls[0], min(controls[1], controls[2]));
    float3 hi = max(controls[0], max(controls[1], controls[2]));
    float3 p0=controls[0],p1=controls[1],p2=controls[2];
    float3 e01a = EVAL(float3(2.0f/3.0f,1.0f/3.0f,0));
    float3 e01b = EVAL(float3(1.0f/3.0f,2.0f/3.0f,0));
    float3 e12a = EVAL(float3(0,2.0f/3.0f,1.0f/3.0f));
    float3 e12b = EVAL(float3(0,1.0f/3.0f,2.0f/3.0f));
    float3 e20a = EVAL(float3(1.0f/3.0f,0,2.0f/3.0f));
    float3 e20b = EVAL(float3(2.0f/3.0f,0,1.0f/3.0f));
    SilPomCurved_EdgeControls(lo, hi, p0, p1, e01a, e01b, controls[3], controls[4]);
    SilPomCurved_EdgeControls(lo, hi, p1, p2, e12a, e12b, controls[5], controls[6]);
    SilPomCurved_EdgeControls(lo, hi, p2, p0, e20a, e20b, controls[7], controls[8]);
    float3 center = EVAL(float3(1.0f/3.0f,1.0f/3.0f,1.0f/3.0f));
    controls[9]=4.5f*(center-(p0+p1+p2)/27.0f-
        (controls[3]+controls[4]+controls[5]+controls[6]+controls[7]+controls[8])/9.0f);
    #undef EVAL
}

void SilPomCurved_PatchBounds(SilPomCurved_Fragment fragment, SilPomCurved_Ray ray, SilPomCurved_Projection projection, float3 a, float3 b, float3 c,
    out float3 lo, out float3 hi)
{
    float3 controls[10];
    SilPomCurved_PatchControls(fragment,ray,projection,a,b,c,controls);
    lo=controls[0];hi=controls[0];
    [unroll] for(uint index=1;index!=10;++index)SilPomCurved_Include(lo,hi,controls[index]);
    float outward = max(1e-6f, 64.0f * 1.192092896e-7f * max(1.0f, max(max(abs(lo.x),abs(hi.x)),
        max(max(abs(lo.y),abs(hi.y)),max(abs(lo.z),abs(hi.z))))));
    lo -= outward;
    hi += outward;
}

float3 SilPomCurved_DeflatedValue(SilPomCurved_Fragment fragment, SilPomCurved_Ray ray, SilPomCurved_Projection projection, float3 barycentric)
{
    float3 value=SilPomCurved_Project(ray,projection,SilPomCurved_SurfacePoint(fragment,barycentric));
    float2 uv;float3 du,dv;SilPomCurved_SurfaceFrame(fragment,barycentric,uv,du,dv);
    SilPomCurved_Ray vectorRay=ray;vectorRay.origin=0;
    float2 ju=SilPomCurved_Project(vectorRay,projection,du).xy,jv=SilPomCurved_Project(vectorRay,projection,dv).xy;
    float scale=max(1.0f,max(max(abs(ju.x),abs(ju.y)),max(abs(jv.x),abs(jv.y))));
    return float3(value.xy,(ju.x*jv.y-jv.x*ju.y)/(scale*scale));
}

bool SilPomCurved_Newton(SilPomCurved_Fragment fragment, SilPomCurved_Ray ray, SilPomCurved_Projection projection, float3 a, float3 b, float3 c,
    out float t, out float3 barycentric, out float3 local, out bool singular)
{
    local = float3(1.0f/3.0f,1.0f/3.0f,1.0f/3.0f);
    singular = false;
    [loop] for (uint iteration = 0; iteration != 20; ++iteration)
    {
        barycentric = SilPomCurved_DomainPoint(a,b,c,local);
        float3 value = SilPomCurved_Project(ray, projection, SilPomCurved_SurfacePoint(fragment,barycentric));
        float2 uv;float3 duSource,dvSource;SilPomCurved_SurfaceFrame(fragment,barycentric,uv,duSource,dvSource);
        SilPomCurved_Ray vectorRay=ray;vectorRay.origin=0;
        float2 ju=SilPomCurved_Project(vectorRay,projection,duSource*(b.y-a.y)+dvSource*(b.z-a.z)).xy;
        float2 jv=SilPomCurved_Project(vectorRay,projection,duSource*(c.y-a.y)+dvSource*(c.z-a.z)).xy;
        float determinant = ju.x*jv.y-jv.x*ju.y;
        float scale = max(1e-20f,max(max(abs(ju.x),abs(ju.y)),max(abs(jv.x),abs(jv.y))));
        if(abs(determinant)<64.0f*1.192092896e-7f*scale*scale) {singular=true;break;}
        float du=(-value.x*jv.y+jv.x*value.y)/determinant;
        float dv=(-ju.x*value.y+value.x*ju.y)/determinant;
        local.y+=du;local.z+=dv;local.x=1.0f-local.y-local.z;
        if(max(abs(du),abs(dv))<2e-6f) break;
    }
    singular=singular||abs(SilPomCurved_DeflatedValue(fragment,ray,projection,SilPomCurved_DomainPoint(a,b,c,local)).z)<
        256.0f*1.192092896e-7f;
    if(singular)
    {
        [loop] for(uint iteration=0;iteration!=20;++iteration)
        {
            float3 residual=SilPomCurved_DeflatedValue(fragment,ray,projection,SilPomCurved_DomainPoint(a,b,c,local));
            const float step=1e-2f;
            float3 luPlus=local+float3(-step,step,0),luMinus=local+float3(step,-step,0);
            float3 lvPlus=local+float3(-step,0,step),lvMinus=local+float3(step,0,-step);
            float3 du=(SilPomCurved_DeflatedValue(fragment,ray,projection,SilPomCurved_DomainPoint(a,b,c,luPlus))-
                SilPomCurved_DeflatedValue(fragment,ray,projection,SilPomCurved_DomainPoint(a,b,c,luMinus)))/(2.0f*step);
            float3 dv=(SilPomCurved_DeflatedValue(fragment,ray,projection,SilPomCurved_DomainPoint(a,b,c,lvPlus))-
                SilPomCurved_DeflatedValue(fragment,ray,projection,SilPomCurved_DomainPoint(a,b,c,lvMinus)))/(2.0f*step);
            float aa=dot(du,du)+1e-20f,ab=dot(du,dv),bb=dot(dv,dv)+1e-20f;
            float ga=dot(du,residual),gb=dot(dv,residual),determinant=aa*bb-ab*ab;
            if(abs(determinant)<1e-30f)break;
            float deltaU=(-bb*ga+ab*gb)/determinant;
            float deltaV=(ab*ga-aa*gb)/determinant;
            local.y+=deltaU;local.z+=deltaV;local.x=1.0f-local.y-local.z;
            if(max(abs(deltaU),abs(deltaV))<2e-5f)break;
        }
    }
    barycentric=SilPomCurved_DomainPoint(a,b,c,local);
    float3 value=SilPomCurved_Project(ray,projection,SilPomCurved_SurfacePoint(fragment,barycentric));
    t=value.z;
    float determinantResidual=abs(SilPomCurved_DeflatedValue(fragment,ray,projection,barycentric).z);
    return all(local>=-2e-4f) && all(local<=1.0002f) && max(abs(value.x),abs(value.y))<=2e-4f &&
        (!singular||determinantResidual<=2e-3f) &&
        t>=ray.tMin-2e-5f && t<=ray.tMax+2e-5f;
}

float SilPomCurved_IntervalError(float2 value)
{
    return max(1e-30f,32.0f*1.192092896e-7f*max(1.0f,max(abs(value.x),abs(value.y))));
}

float2 SilPomCurved_ExpandInterval(float2 value)
{
    float error=SilPomCurved_IntervalError(value);
    return float2(value.x-error,value.y+error);
}

float2 SilPomCurved_AddInterval(float2 a,float2 b)
{
    return SilPomCurved_ExpandInterval(float2(a.x+b.x,a.y+b.y));
}

float2 SilPomCurved_ScaleInterval(float scale,float2 value)
{
    float2 product=scale>=0?float2(scale*value.x,scale*value.y):float2(scale*value.y,scale*value.x);
    return SilPomCurved_ExpandInterval(product);
}

float2 SilPomCurved_MultiplyInterval(float2 a,float2 b)
{
    float4 products=float4(a.x*b.x,a.x*b.y,a.y*b.x,a.y*b.y);
    return SilPomCurved_ExpandInterval(float2(min(min(products.x,products.y),min(products.z,products.w)),
        max(max(products.x,products.y),max(products.z,products.w))));
}

void SilPomCurved_IncludeValue(inout float2 interval,float value)
{
    interval=float2(min(interval.x,value),max(interval.y,value));
}

float2 SilPomCurved_QuadraticSquareBounds(float q200,float q110,float q101,float q020,float q011,float q002)
{
    float coefficients[5];
    coefficients[0]=2.0f*(q110-q200);
    coefficients[1]=2.0f*(q101-q200);
    coefficients[2]=q200-2.0f*q110+q020;
    coefficients[3]=2.0f*(q200-q110-q101+q011);
    coefficients[4]=q200-2.0f*q101+q002;
    float2 result=float2(q200,q200);
    [unroll] for(uint index=0;index!=5;++index)
        result+=float2(min(0.0f,coefficients[index]),max(0.0f,coefficients[index]));
    return SilPomCurved_ExpandInterval(result);
}

bool SilPomCurved_StrictDomainContains(float3 domain[3],float3 barycentric,float margin)
{
    float3 e0=domain[1]-domain[0],e1=domain[2]-domain[0],relative=barycentric-domain[0];
    float aa=dot(e0,e0),ab=dot(e0,e1),bb=dot(e1,e1);
    float determinant=aa*bb-ab*ab;
    if(abs(determinant)<1e-30f)return false;
    float u=(dot(relative,e0)*bb-dot(relative,e1)*ab)/determinant;
    float v=(dot(relative,e1)*aa-dot(relative,e0)*ab)/determinant;
    return u>margin&&v>margin&&u+v<1.0f-margin;
}

// Krawczyk inclusion over the current triangular parameter domain.  The
// derivative ranges come from the exact derivative Bernstein control nets;
// every arithmetic operation is expanded by a float-rounding error bound.
// Success proves a unique regular root.  Singular/boundary leaves remain
// SilPomCurved_Exhausted instead of being accepted from a small sampled residual.
bool SilPomCurved_IntervalInclusion(SilPomCurved_Fragment fragment,SilPomCurved_Ray ray,SilPomCurved_Projection projection,float3 a,float3 b,float3 c,
    float3 local,float3 controls[10],out float4 enclosure)
{
    float2 dx[6],dy[6];
    dx[0]=3.0f*(controls[3].xy-controls[0].xy);
    dx[1]=3.0f*(controls[4].xy-controls[3].xy);
    dx[2]=3.0f*(controls[9].xy-controls[8].xy);
    dx[3]=3.0f*(controls[1].xy-controls[4].xy);
    dx[4]=3.0f*(controls[5].xy-controls[9].xy);
    dx[5]=3.0f*(controls[6].xy-controls[7].xy);
    dy[0]=3.0f*(controls[8].xy-controls[0].xy);
    dy[1]=3.0f*(controls[9].xy-controls[3].xy);
    dy[2]=3.0f*(controls[7].xy-controls[8].xy);
    dy[3]=3.0f*(controls[5].xy-controls[4].xy);
    dy[4]=3.0f*(controls[6].xy-controls[5].xy);
    dy[5]=3.0f*(controls[2].xy-controls[7].xy);
    float2 j00=SilPomCurved_QuadraticSquareBounds(dx[0].x,dx[1].x,dx[2].x,dx[3].x,dx[4].x,dx[5].x);
    float2 j10=SilPomCurved_QuadraticSquareBounds(dx[0].y,dx[1].y,dx[2].y,dx[3].y,dx[4].y,dx[5].y);
    float2 j01=SilPomCurved_QuadraticSquareBounds(dy[0].x,dy[1].x,dy[2].x,dy[3].x,dy[4].x,dy[5].x);
    float2 j11=SilPomCurved_QuadraticSquareBounds(dy[0].y,dy[1].y,dy[2].y,dy[3].y,dy[4].y,dy[5].y);

    float3 barycentric=SilPomCurved_DomainPoint(a,b,c,local);
    float2 residual=SilPomCurved_Project(ray,projection,SilPomCurved_SurfacePoint(fragment,barycentric)).xy;
    float2 column0=float2((j00.x+j00.y)*.5f,(j10.x+j10.y)*.5f);
    float2 column1=float2((j01.x+j01.y)*.5f,(j11.x+j11.y)*.5f);
    float determinant=column0.x*column1.y-column1.x*column0.y;
    float derivativeScale=max(1e-20f,max(max(abs(column0.x),abs(column0.y)),max(abs(column1.x),abs(column1.y))));
    if(!isfinite(determinant)||abs(determinant)<=256.0f*1.192092896e-7f*derivativeScale*derivativeScale)
    {enclosure=float4(-3,-3,3,3);return false;}
    float c00=column1.y/determinant,c01=-column1.x/determinant;
    float c10=-column0.y/determinant,c11=column0.x/determinant;
    float centerX=local.y-(c00*residual.x+c01*residual.y);
    float centerY=local.z-(c10*residual.x+c11*residual.y);
    float2 m00=SilPomCurved_AddInterval(SilPomCurved_AddInterval(float2(1,1),SilPomCurved_ScaleInterval(-c00,j00)),SilPomCurved_ScaleInterval(-c01,j10));
    float2 m01=SilPomCurved_AddInterval(SilPomCurved_ScaleInterval(-c00,j01),SilPomCurved_ScaleInterval(-c01,j11));
    float2 m10=SilPomCurved_AddInterval(SilPomCurved_ScaleInterval(-c10,j00),SilPomCurved_ScaleInterval(-c11,j10));
    float2 m11=SilPomCurved_AddInterval(SilPomCurved_AddInterval(float2(1,1),SilPomCurved_ScaleInterval(-c10,j01)),SilPomCurved_ScaleInterval(-c11,j11));
    float2 deltaX=float2(-local.y,1.0f-local.y);
    float2 deltaY=float2(-local.z,1.0f-local.z);
    float2 kx=SilPomCurved_AddInterval(float2(centerX,centerX),SilPomCurved_AddInterval(SilPomCurved_MultiplyInterval(m00,deltaX),SilPomCurved_MultiplyInterval(m01,deltaY)));
    float2 ky=SilPomCurved_AddInterval(float2(centerY,centerY),SilPomCurved_AddInterval(SilPomCurved_MultiplyInterval(m10,deltaX),SilPomCurved_MultiplyInterval(m11,deltaY)));
    enclosure=float4(kx,ky);
    float margin=256.0f*1.192092896e-7f;
    // The depth enclosure belongs to this child triangle, not to its parent
    // fragment or to the surrounding unit square. The complete root enclosure
    // must lie inside this triangle before that depth bound can be returned.
    if(kx.x<=margin||ky.x<=margin||kx.y+ky.y>=1.0f-margin)return false;
    float2 xs=float2(kx.x,kx.y),ys=float2(ky.x,ky.y);
    [unroll] for(uint ix=0;ix!=2;++ix)[unroll] for(uint iy=0;iy!=2;++iy)
    {
        float3 candidatePoint=SilPomCurved_DomainPoint(a,b,c,float3(1.0f-xs[ix]-ys[iy],xs[ix],ys[iy]));
        if(!SilPomCurved_StrictDomainContains(fragment.domain,candidatePoint,margin))return false;
    }
    return true;
}

// A non-zero degree of the projected patch boundary is an existence proof even
// when interval SilPomCurved_Newton is too pessimistic.  Each cubic boundary segment is
// subdivided with de Casteljau; an outward-expanded control hull must fit wholly
// in one open coordinate half-plane before its angle contribution is used.
bool SilPomCurved_WindingInclusion(float3 patch[10])
{
    uint edgeIndices[12]={0,3,4,1, 1,5,6,2, 2,7,8,0};
    float winding=0;
    [unroll] for(uint edge=0;edge!=3;++edge)
    {
        float2 s0[8],s1[8],s2[8],s3[8];uint depths[8];uint size=1;
        s0[0]=patch[edgeIndices[edge*4+0]].xy;s1[0]=patch[edgeIndices[edge*4+1]].xy;
        s2[0]=patch[edgeIndices[edge*4+2]].xy;s3[0]=patch[edgeIndices[edge*4+3]].xy;depths[0]=0;
        [loop] while(size)
        {
            --size;float2 p0=s0[size],p1=s1[size],p2=s2[size],p3=s3[size];uint depth=depths[size];
            if(depth!=4)
            {
                float2 a01=(p0+p1)*.5f,a12=(p1+p2)*.5f,a23=(p2+p3)*.5f;
                float2 b01=(a01+a12)*.5f,b12=(a12+a23)*.5f,center=(b01+b12)*.5f;
                s0[size]=center;s1[size]=b12;s2[size]=a23;s3[size]=p3;depths[size++]=depth+1;
                s0[size]=p0;s1[size]=a01;s2[size]=b01;s3[size]=center;depths[size++]=depth+1;
                continue;
            }
            float2 lo=min(min(p0,p1),min(p2,p3)),hi=max(max(p0,p1),max(p2,p3));
            float outward=64.0f*1.192092896e-7f*max(1.0f,max(max(abs(lo.x),abs(hi.x)),max(abs(lo.y),abs(hi.y))));
            lo-=outward;hi+=outward;
            if(!(lo.x>0||hi.x<0||lo.y>0||hi.y<0))return false;
            float first=atan2(p0.y,p0.x),last=atan2(p3.y,p3.x),delta=last-first;
            if(delta>3.141592654f)delta-=6.283185307f;
            if(delta<-3.141592654f)delta+=6.283185307f;
            winding+=delta;
        }
    }
    return abs(winding)>4.0f;
}

bool SilPomCurved_CouldIntersect(float3 lo,float3 hi,SilPomCurved_Ray ray,SilPomCurved_Result result)
{
    return !(lo.x>0||hi.x<0||lo.y>0||hi.y<0||hi.z<ray.tMin||lo.z>ray.tMax||
        (result.status==SilPomCurved_Hit&&lo.z>result.t+result.tError));
}

void SilPomCurved_RecordUnresolved(inout SilPomCurved_Result result,float3 lo,float3 hi,uint reason)
{
    result.unresolvedT=min(result.unresolvedT,lo.z);
    result.unresolvedUpper=max(result.unresolvedUpper,hi.z);
    result.exhaustionReasons|=reason;
}

#include "CurvedGpuInterval.hlsli"
#include "CurvedGpuRational.hlsli"

SilPomCurved_Result SilPomCurved_Intersect(SilPomCurved_Ray ray)
{
    SilPomCurved_Result result=(SilPomCurved_Result)0;
    result.status=SilPomCurved_Miss;
    result.primitiveId=0xffffffffu;
    result.t=ray.tMax;
    result.tError=0;
    result.unresolvedT=3.402823466e+38f;
    result.unresolvedUpper=-3.402823466e+38f;
    if(any(!isfinite(ray.origin))||any(!isfinite(ray.direction))||dot(ray.direction,ray.direction)==0||
        !isfinite(ray.tMin)||isnan(ray.tMax)||ray.tMin>ray.tMax)
    {result.status=SilPomCurved_Invalid;return result;}
    SilPomCurved_Projection projection=SilPomCurved_MakeProjection(ray.direction);
    bool exhausted=false;
    bool abortAll=false;
    [loop] for(uint fragmentIndex=0;fragmentIndex<fragmentCount;++fragmentIndex)
    {
        if(!SilPomCurved_FragmentMayIntersect(fragmentIndex,ray,result))continue;
        SilPomCurved_Fragment fragment=SilPomCurved_LoadFragment(fragmentIndex);
        float3 stackA[SilPomCurved_StackCapacity],stackB[SilPomCurved_StackCapacity],stackC[SilPomCurved_StackCapacity];uint stackDepth[SilPomCurved_StackCapacity];
        uint stackSize=1;
        stackA[0]=fragment.domain[0];stackB[0]=fragment.domain[1];stackC[0]=fragment.domain[2];stackDepth[0]=0;
        [loop] while(stackSize)
        {
            if(result.nodes>=maxNodes)
            {
                exhausted=true;abortAll=true;
                [loop] for(uint pending=0;pending<stackSize;++pending)
                {
                    float3 pendingLo,pendingHi;
                    SilPomCurved_PatchBounds(fragment,ray,projection,stackA[pending],stackB[pending],stackC[pending],pendingLo,pendingHi);
                    if(SilPomCurved_CouldIntersect(pendingLo,pendingHi,ray,result))
                        SilPomCurved_RecordUnresolved(result,pendingLo,pendingHi,SilPomCurved_ReasonNodeBudget);
                }
                [loop] for(uint remaining=fragmentIndex+1;remaining<fragmentCount;++remaining)
                {
                    SilPomCurved_Fragment pendingFragment=SilPomCurved_LoadFragment(remaining);float3 pendingLo,pendingHi;
                    SilPomCurved_PatchBounds(pendingFragment,ray,projection,pendingFragment.domain[0],pendingFragment.domain[1],
                        pendingFragment.domain[2],pendingLo,pendingHi);
                    if(SilPomCurved_CouldIntersect(pendingLo,pendingHi,ray,result))
                        SilPomCurved_RecordUnresolved(result,pendingLo,pendingHi,SilPomCurved_ReasonNodeBudget);
                }
                break;
            }
            --stackSize;float3 a=stackA[stackSize],b=stackB[stackSize],c=stackC[stackSize];uint depth=stackDepth[stackSize];
            ++result.nodes;result.maximumDepth=max(result.maximumDepth,depth);
            float3 controls[10];SilPomCurved_PatchControls(fragment,ray,projection,a,b,c,controls);
            float3 lo=controls[0],hi=controls[0];
            [unroll] for(uint ci=1;ci!=10;++ci)SilPomCurved_Include(lo,hi,controls[ci]);
            float outward=max(1e-6f,64.0f*1.192092896e-7f*max(1.0f,max(max(abs(lo.x),abs(hi.x)),
                max(max(abs(lo.y),abs(hi.y)),max(abs(lo.z),abs(hi.z))))));
            lo-=outward;hi+=outward;
            if(!SilPomCurved_CouldIntersect(lo,hi,ray,result))continue;
            if(packedTriangleCount!=0&&depth>=3)
            {
                float3 proofBary;float2 proofDepth;
                uint proof=SilPomCurved_ProofRegular(fragment,ray,projection,a,b,c,proofBary,proofDepth);
                if(proof==2)continue;
                if(proof==1)
                {
                    float t=(proofDepth.x+proofDepth.y)*.5f;
                    float error=SilPomCurved_ProofUp(max(t-proofDepth.x,proofDepth.y-t));
                    float2 hitUv;float3 hitDu,hitDv;SilPomCurved_SurfaceFrame(fragment,proofBary,hitUv,hitDu,hitDv);
                    float3 hitNormal=cross(hitDu,hitDv);float normalLength=length(hitNormal);
                    if(!isfinite(normalLength)||normalLength<=1e-12f)
                    {result.status=SilPomCurved_Invalid;return result;}
                    if(t+error<result.t-result.tError||
                        (t-error<=result.t+result.tError&&fragment.primitiveId<result.primitiveId))
                    {
                        result.status=SilPomCurved_Hit;result.t=t;result.tError=error;result.barycentric=proofBary;
                        result.primitiveId=fragment.primitiveId;result.singular=0;result.uv=hitUv;result.normal=hitNormal/normalLength;
                    }
                    continue;
                }
            }
            float diameter=max(length(a-b),max(length(b-c),length(c-a)));
            // The legacy sample reconstruction loses accuracy as domains shrink.
            // Analytic product controls do not divide cancellation error by the
            // domain diameter, so the compact path can use a linear epsilon
            // floor. Depth/stack/node budgets remain separately enforced.
            float parameterFloor=(packedTriangleCount&0x40000000u)!=0?64.0f*1.192092896e-7f:2.0f*sqrt(1.192092896e-7f);
            float depthFloor=32.0f*1.192092896e-7f*max(1.0f,max(abs(lo.z),abs(hi.z)));
            float t=0;float3 barycentric=0,local=float3(1.0f/3.0f,1.0f/3.0f,1.0f/3.0f);bool singular=false;
            float4 enclosure=0;
            bool certified=false;
            float inclusionScale=4.0f*sqrt(sqrt(1.192092896e-7f));
            if(diameter<inclusionScale)
            {
                SilPomCurved_Newton(fragment,ray,projection,a,b,c,t,barycentric,local,singular);
                float2 locatedResidual=SilPomCurved_Project(ray,projection,SilPomCurved_SurfacePoint(fragment,barycentric)).xy;
                float residualScale=max(1.0f,max(max(abs(lo.x),abs(hi.x)),max(abs(lo.y),abs(hi.y))));
                bool locatorValid=all(local>=-parameterFloor)&&all(local<=1.0f+parameterFloor)&&
                    max(abs(locatedResidual.x),abs(locatedResidual.y))<=512.0f*1.192092896e-7f*residualScale;
                bool intervalCertified=SilPomCurved_IntervalInclusion(fragment,ray,projection,a,b,c,local,controls,enclosure);
                bool windingCertified=!intervalCertified&&!singular&&
                    hi.z-lo.z<=max(requiredDepthAccuracy,depthFloor)&&SilPomCurved_WindingInclusion(controls);
                float hitLower=lo.z,hitUpper=hi.z;
                if(intervalCertified&&packedTriangleCount!=0)
                {
                    // Krawczyk proves a unique root in this domain. Bound its
                    // small enclosure, rather than subdividing the whole leaf
                    // until every point on it has nearly identical depth.
                    // The doubled right triangle contains the enclosure box.
                    // The cell polynomial is extended only for bounding; the
                    // inclusion test already proves the root is inside its cell.
                    float x=enclosure.x,y=enclosure.z;
                    float dx=enclosure.y-x,dy=enclosure.w-y;
                    float3 rootA=SilPomCurved_DomainPoint(a,b,c,float3(1-x-y,x,y));
                    float3 rootB=SilPomCurved_DomainPoint(a,b,c,float3(1-x-y-2*dx,x+2*dx,y));
                    float3 rootC=SilPomCurved_DomainPoint(a,b,c,float3(1-x-y-2*dy,x,y+2*dy));
                    float3 rootLo,rootHi;SilPomCurved_PatchBounds(fragment,ray,projection,rootA,rootB,rootC,rootLo,rootHi);
                    hitLower=rootLo.z;hitUpper=rootHi.z;
                }
                float2 hitUv;float3 hitDu,hitDv;SilPomCurved_SurfaceFrame(fragment,barycentric,hitUv,hitDu,hitDv);
                float3 hitNormal=cross(hitDu,hitDv);float normalLength=length(hitNormal);
                if(locatorValid&&(intervalCertified||windingCertified)&&
                    isfinite(normalLength)&&normalLength>1e-12f&&
                    t>=ray.tMin-depthFloor&&t<=ray.tMax+depthFloor&&
                    t>=hitLower-depthFloor&&t<=hitUpper+depthFloor&&
                    hitUpper-hitLower<=max(requiredDepthAccuracy,depthFloor))
                {
                    certified=true;
                    float error=max(max(abs(t-hitLower),abs(hitUpper-t)),depthFloor);
                    if(t+error<result.t-result.tError||
                        (t-error<=result.t+result.tError&&fragment.primitiveId<result.primitiveId))
                    {result.status=SilPomCurved_Hit;result.t=t;result.tError=error;
                        result.barycentric=barycentric;result.primitiveId=fragment.primitiveId;result.singular=0;
                        result.uv=hitUv;result.normal=hitNormal/normalLength;}
                }
            }
            if(certified)continue;
            if(depth>=maxDepth||diameter<parameterFloor||hi.z-lo.z<depthFloor)
            {
                exhausted=true;
                uint reason=SilPomCurved_ReasonUncertifiedLeaf;
                if(depth>=maxDepth)reason|=SilPomCurved_ReasonMaximumDepth;
                if(diameter<parameterFloor)reason|=SilPomCurved_ReasonParameterResolution;
                if(hi.z-lo.z<depthFloor)reason|=SilPomCurved_ReasonDepthResolution;
                SilPomCurved_RecordUnresolved(result,lo,hi,reason);
                continue;
            }
            if(stackSize+4>SilPomCurved_StackCapacity)
            {
                exhausted=true;abortAll=true;SilPomCurved_RecordUnresolved(result,lo,hi,SilPomCurved_ReasonStackCapacity);
                [loop] for(uint pending=0;pending<stackSize;++pending)
                {
                    float3 pendingLo,pendingHi;
                    SilPomCurved_PatchBounds(fragment,ray,projection,stackA[pending],stackB[pending],stackC[pending],pendingLo,pendingHi);
                    if(SilPomCurved_CouldIntersect(pendingLo,pendingHi,ray,result))
                        SilPomCurved_RecordUnresolved(result,pendingLo,pendingHi,SilPomCurved_ReasonStackCapacity);
                }
                [loop] for(uint remaining=fragmentIndex+1;remaining<fragmentCount;++remaining)
                {
                    SilPomCurved_Fragment pendingFragment=SilPomCurved_LoadFragment(remaining);float3 pendingLo,pendingHi;
                    SilPomCurved_PatchBounds(pendingFragment,ray,projection,pendingFragment.domain[0],pendingFragment.domain[1],
                        pendingFragment.domain[2],pendingLo,pendingHi);
                    if(SilPomCurved_CouldIntersect(pendingLo,pendingHi,ray,result))
                        SilPomCurved_RecordUnresolved(result,pendingLo,pendingHi,SilPomCurved_ReasonStackCapacity);
                }
                break;
            }
            float3 ab=(a+b)*.5f,bc=(b+c)*.5f,ca=(c+a)*.5f;
            stackA[stackSize]=a;stackB[stackSize]=ab;stackC[stackSize]=ca;stackDepth[stackSize++]=depth+1;
            stackA[stackSize]=ab;stackB[stackSize]=b;stackC[stackSize]=bc;stackDepth[stackSize++]=depth+1;
            stackA[stackSize]=ca;stackB[stackSize]=bc;stackC[stackSize]=c;stackDepth[stackSize++]=depth+1;
            stackA[stackSize]=ab;stackB[stackSize]=bc;stackC[stackSize]=ca;stackDepth[stackSize++]=depth+1;
        }
        if(abortAll)break;
    }
    // Reaching a budget is not itself an unresolved intersection: the exit
    // audit may reject every pending node. Only recorded candidate intervals
    // can turn a proven miss (or a certified nearer hit) into SilPomCurved_Exhausted.
    if(exhausted&&result.exhaustionReasons!=0&&
        (result.status!=SilPomCurved_Hit||result.unresolvedT<result.t-result.tError))result.status=SilPomCurved_Exhausted;
    return result;
}

// Separate pass to keep bounded integer algebra out of the main kernel's
// register allocation. Only unresolved precision leaves are eligible. Explicit
// work limits remain exhausted; a failed proof preserves the original result.
SilPomCurved_Result SilPomCurved_Resolve(SilPomCurved_Ray ray, SilPomCurved_Result previous)
{
    if(packedTriangleCount==0)return previous;
    if(previous.status!=SilPomCurved_Exhausted||
        (previous.exhaustionReasons&(SilPomCurved_ReasonNodeBudget|SilPomCurved_ReasonMaximumDepth|SilPomCurved_ReasonStackCapacity))!=0)return previous;
    SilPomCurved_Projection projection=SilPomCurved_MakeProjection(ray.direction);
    SilPomCurved_Result candidate=(SilPomCurved_Result)0;
    candidate.status=SilPomCurved_Miss;candidate.primitiveId=0xffffffffu;candidate.t=ray.tMax;
    candidate.nodes=previous.nodes;candidate.maximumDepth=previous.maximumDepth;
    candidate.unresolvedT=3.402823466e+38f;candidate.unresolvedUpper=-3.402823466e+38f;
    [loop]for(uint fragmentIndex=0;fragmentIndex<fragmentCount;++fragmentIndex)
    {
        if(!SilPomCurved_FragmentMayIntersect(fragmentIndex,ray,candidate))continue;
        if(candidate.nodes>=maxNodes)
        {previous.nodes=candidate.nodes;previous.exhaustionReasons|=SilPomCurved_ReasonNodeBudget;return previous;}
        ++candidate.nodes;
        SilPomCurved_Fragment f=SilPomCurved_LoadFragment(fragmentIndex);float3 lo,hi;
        SilPomCurved_PatchBounds(f,ray,projection,f.domain[0],f.domain[1],f.domain[2],lo,hi);
        if(!SilPomCurved_CouldIntersect(lo,hi,ray,candidate))continue;
        float3 bary;float2 depth;bool singular;
        uint proof=SilPomCurved_ProofRational(f,ray,projection,bary,depth,singular);
        if(proof==2)continue;
        if(proof==0){SilPomCurved_RecordUnresolved(candidate,lo,hi,SilPomCurved_ReasonUncertifiedLeaf);continue;}
        float t=(depth.x+depth.y)*.5f,error=SilPomCurved_ProofUp(max(t-depth.x,depth.y-t));
        float2 uv;float3 du,dv;SilPomCurved_SurfaceFrame(f,bary,uv,du,dv);
        float3 normal=cross(du,dv);float normalLength=length(normal);
        if(!isfinite(normalLength)||normalLength<=1e-12f)
        {candidate.status=SilPomCurved_Invalid;return candidate;}
        if(t+error<candidate.t-candidate.tError||
            (t-error<=candidate.t+candidate.tError&&f.primitiveId<candidate.primitiveId))
        {
            candidate.status=SilPomCurved_Hit;candidate.t=t;candidate.tError=error;candidate.primitiveId=f.primitiveId;
            candidate.barycentric=bary;candidate.uv=uv;candidate.normal=normal/normalLength;candidate.singular=singular?1:0;
        }
    }
    if(candidate.status==SilPomCurved_Hit&&candidate.exhaustionReasons!=0)
    {
        // A rational contact does not erase unrelated, potentially closer
        // intervals. Re-audit unsupported cells against the now-proved depth;
        // coarse whole-fragment bounds can overlap it without any nearer root.
        candidate.exhaustionReasons=0;candidate.unresolvedT=3.402823466e+38f;candidate.unresolvedUpper=-3.402823466e+38f;
        [loop]for(uint fi=0;fi<fragmentCount;++fi)
        {
            if(!SilPomCurved_FragmentMayIntersect(fi,ray,candidate))continue;
            if(candidate.nodes>=maxNodes)
            {previous.nodes=candidate.nodes;previous.exhaustionReasons|=SilPomCurved_ReasonNodeBudget;return previous;}
            ++candidate.nodes;
            SilPomCurved_Fragment f=SilPomCurved_LoadFragment(fi);float3 bary;float2 interval;bool singular;
            if(SilPomCurved_ProofRational(f,ray,projection,bary,interval,singular)!=0)continue;
            float3 sa[32],sb[32],sc[32];uint depths[32];uint size=1;
            sa[0]=f.domain[0];sb[0]=f.domain[1];sc[0]=f.domain[2];depths[0]=0;
            [loop]while(size!=0)
            {
                if(candidate.nodes>=maxNodes)
                {previous.nodes=candidate.nodes;previous.exhaustionReasons|=SilPomCurved_ReasonNodeBudget;return previous;}
                --size;++candidate.nodes;
                float3 a=sa[size],b=sb[size],c=sc[size];uint depth=depths[size];
                float3 lo,hi;SilPomCurved_PatchBounds(f,ray,projection,a,b,c,lo,hi);
                if(!SilPomCurved_CouldIntersect(lo,hi,ray,candidate)||lo.z>=candidate.t-candidate.tError)continue;
                if(depth>=min(maxDepth,8u)||size+4>32)
                {SilPomCurved_RecordUnresolved(candidate,lo,hi,SilPomCurved_ReasonUncertifiedLeaf);continue;}
                float3 ab=(a+b)*.5f,bc=(b+c)*.5f,ca=(c+a)*.5f;
                sa[size]=a;sb[size]=ab;sc[size]=ca;depths[size++]=depth+1;
                sa[size]=ab;sb[size]=b;sc[size]=bc;depths[size++]=depth+1;
                sa[size]=ca;sb[size]=bc;sc[size]=c;depths[size++]=depth+1;
                sa[size]=ab;sb[size]=bc;sc[size]=ca;depths[size++]=depth+1;
            }
        }
    }
    if(candidate.exhaustionReasons!=0&&(candidate.status!=SilPomCurved_Hit||candidate.unresolvedT<candidate.t-candidate.tError))
    {previous.nodes=candidate.nodes;return previous;}
    return candidate;
}
