#pragma once
#include "MeshFace.azsli"
#include "Quality.azsli"
#include "FrustumDepthBound.azsli"
#include "ReliefMode.azsli"
#include "ProfileRole.azsli"

// These helpers describe only the implicit NDC proxy. Authored shell/proxy
// vertices retain their original clip W, UV and sample-depth interpolation.
static const uint SP_IMPLICIT_CACHE_UNAVAILABLE=0u;
static const uint SP_IMPLICIT_CACHE_LIVE=1u;
static const uint SP_IMPLICIT_CACHE_EMPTY=2u;
static const uint SP_IMPLICIT_CACHE_BYTES=48u;
static const uint SP_FACE_COEFFICIENT_BYTES=48u;

struct SilPomImplicitProfile
{
    float scale,reference,pixelBudget,maxDistance;
    uint reliefMode,role; // role: SP_ROLE_*
    bool proxyLodEnabled;
};
struct SilPomImplicitCoverage
{
    // The original proxy feeds a precise SV_Position. Keep that precision
    // dependency when its final coordinates are produced by compute instead.
    precise float2 ndc[4];
    float depth;
    uint status;
};
float SilPomImplicitLodDepth(SilPomImplicitProfile profile,float projectionY)
{
    if(profile.proxyLodEnabled)return 1e20f;
    if(profile.reliefMode==SP_RELIEF_LOD_SHELL)return 0;
    const float budget=SilPomReliefLodPixels(profile.reliefMode);
    return SilPomQualityLodDepth(profile.scale,profile.reference,projectionY,budget,profile.pixelBudget,profile.maxDistance);
}
struct SilPomImplicitTriangle
{
    float2 origin,edgeB,edgeC;
    float3 lower;
    float scale;
    bool positive;
};
bool SilPomImplicitTriangleShape(float4 corners[6],inout float proxyArea,out SilPomImplicitTriangle shape)
{
    shape=(SilPomImplicitTriangle)0;
    const float2 origin=corners[0].xy/corners[0].w;
    const float2 edgeB=corners[2].xy/corners[2].w-origin;
    const float2 edgeC=corners[4].xy/corners[4].w-origin;
    const float area=edgeB.x*edgeC.y-edgeB.y*edgeC.x;
    if(abs(area)<1e-6f)return false;
    const float2 gradB=float2(edgeC.y,-edgeC.x)/area;
    const float2 gradC=float2(-edgeB.y,edgeB.x)/area;
    float3 lower=0;
    [unroll] for(uint i=1;i<6;i+=2)
    {
        const float2 delta=corners[i].xy/corners[i].w-origin;
        const float b=dot(delta,gradB),c=dot(delta,gradC);
        lower=min(lower,float3(1.0f-b-c,b,c));
    }
    const float2 gradA=gradB+gradC;
    lower-=2e-5f*float3(abs(gradA.x)+abs(gradA.y),abs(gradB.x)+abs(gradB.y),abs(gradC.x)+abs(gradC.y));
    const float scale=1.0f-lower.x-lower.y-lower.z;
    const float triangleArea=.5f*abs(area)*scale*scale;
    if(triangleArea>=proxyArea)return false;
    proxyArea=triangleArea;
    shape.origin=origin;shape.edgeB=edgeB;shape.edgeC=edgeC;
    shape.lower=lower;shape.scale=scale;shape.positive=area>0.0f;
    return true;
}
float2 SilPomImplicitTriangleCorner(SilPomImplicitTriangle shape,float2 quadCorner)
{
    const bool useB=shape.positive?quadCorner.x>0&&quadCorner.y<=0:quadCorner.y>0;
    const bool useC=shape.positive?quadCorner.y>0:quadCorner.x>0&&quadCorner.y<=0;
    return shape.origin+shape.edgeB*(shape.lower.y+(useB?shape.scale:0.0f))
        +shape.edgeC*(shape.lower.z+(useC?shape.scale:0.0f));
}
struct SilPomImplicitWallBounds
{
    float3 axisX,axisY;
    float3 minU,minV,maxU,maxV;
};
float2 SilPomImplicitProjectedEdge(float4 a,float4 b)
{
    const float2 edge=b.xy*a.w-a.xy*b.w;
    const float lengthSq=dot(edge,edge);
    return lengthSq>1e-12f?edge*rsqrt(lengthSq):float2(1,0);
}
void SilPomImplicitGrowWall(inout SilPomImplicitWallBounds bounds,float2 xy)
{
    const float3 u=bounds.axisX*xy.x+bounds.axisY*xy.y;
    const float3 v=bounds.axisX*xy.y-bounds.axisY*xy.x;
    bounds.minU=min(bounds.minU,u);bounds.maxU=max(bounds.maxU,u);
    bounds.minV=min(bounds.minV,v);bounds.maxV=max(bounds.maxV,v);
}
float SilPomImplicitVisibleQuadArea(float2 origin,float2 u,float2 v)
{
    float2 polygon[8];
    polygon[0]=origin;polygon[1]=origin+u;
    polygon[2]=origin+u+v;polygon[3]=origin+v;
    uint count=4;
    [loop] for(uint plane=0;plane<4;++plane)
    {
        float2 clipped[8];uint nextCount=0;
        const uint axis=plane>>1;
        const float sign=(plane&1)==0?1.0f:-1.0f;
        float2 a=polygon[count-1];
        float da=1.0f-sign*a[axis];
        [loop] for(uint i=0;i<count;++i)
        {
            const float2 b=polygon[i];
            const float db=1.0f-sign*b[axis];
            if((da<0)!=(db<0))clipped[nextCount++]=lerp(a,b,da/(da-db));
            if(db>=0)clipped[nextCount++]=b;
            a=b;da=db;
        }
        if(nextCount<3)return 0;
        count=nextCount;
        [loop] for(uint i=0;i<count;++i)polygon[i]=clipped[i];
    }
    float twiceArea=0;float2 a=polygon[count-1];
    [loop] for(uint i=0;i<count;++i)
    {
        const float2 b=polygon[i];twiceArea+=a.x*b.y-a.y*b.x;a=b;
    }
    return .5f*abs(twiceArea);
}
struct SilPomImplicitWallShape {float2 origin,u,v;bool selected;};
SilPomImplicitWallShape SilPomImplicitChooseWall(SilPomImplicitWallBounds bounds,float area)
{
    SilPomImplicitWallShape shape=(SilPomImplicitWallShape)0;
    [loop] for(uint i=0;i<3;++i)
    {
        const float2 axisU=float2(bounds.axisX[i],bounds.axisY[i]);
        const float2 axisV=float2(-axisU.y,axisU.x);
        const float2 lo=float2(bounds.minU[i],bounds.minV[i])-2e-5f;
        const float2 hi=float2(bounds.maxU[i],bounds.maxV[i])+2e-5f;
        const float2 origin=lo.x*axisU+lo.y*axisV;
        const float2 u=(hi.x-lo.x)*axisU,v=(hi.y-lo.y)*axisV;
        const float visibleArea=SilPomImplicitVisibleQuadArea(origin,u,v);
        if(visibleArea<area)
        {
            area=visibleArea;shape.origin=origin;shape.u=u;shape.v=v;shape.selected=true;
        }
    }
    return shape;
}

SilPomImplicitCoverage SilPomBuildImplicitCoverage(SilPomMeshFace f,SilPomImplicitProfile profile,
    float4x4 model,float4x4 vp,float projectionY,bool nearPolicy,bool trianglePolicy,bool proxySelected,
    bool singleCorner=false,float2 requestedCorner=float2(0,0))
{
    SilPomImplicitCoverage result=(SilPomImplicitCoverage)0;
    result.status=SP_IMPLICIT_CACHE_EMPTY;
    if(nearPolicy&&proxySelected)return result;
    float nearLimit=0;
    if(nearPolicy)
    {
        const float cutoff=SilPomImplicitLodDepth(profile,projectionY);
        if(cutoff<=0)return result;
        nearLimit=cutoff+SilPomQualityLodOverlap(profile.scale,profile.maxDistance);
    }
    float2 low=float2(1,1),high=float2(-1,-1);
    float4 corners[6];bool clipped=false;
    for(uint i=0;i<6;++i)
    {
        float2 uv=i/2==0?f.uv0:(i/2==1?f.uv1:f.uv2);
        float h=profile.scale*((i&1)-profile.reference);
        float3 D=i/2==0?f.d0:(i/2==1?f.d1:f.d2);
        float3 p=f.origin+f.du*(uv.x-f.uv0.x)+f.dv*(uv.y-f.uv0.y)+D*h;
        // Coverage deliberately retains the two-stage projection expression.
        corners[i]=mul(vp,mul(model,float4(p,1)));
    }
    const bool tightWall=nearPolicy&&profile.role==SP_ROLE_WALL&&profile.reliefMode==SP_RELIEF_LOD_4PX_RESOLVE;
    SilPomImplicitWallBounds wallBounds=(SilPomImplicitWallBounds)0;
    if(tightWall)
    {
        const float2 a=SilPomImplicitProjectedEdge(corners[0],corners[2]);
        const float2 b=SilPomImplicitProjectedEdge(corners[2],corners[4]);
        const float2 c=SilPomImplicitProjectedEdge(corners[4],corners[0]);
        wallBounds.axisX=float3(a.x,b.x,c.x);wallBounds.axisY=float3(a.y,b.y,c.y);
        wallBounds.minU=wallBounds.minV=1e30f;wallBounds.maxU=wallBounds.maxV=-1e30f;
    }
    for(uint i=0;i<6;++i)
    {
        const float4 clipPosition=corners[i];
        if(clipPosition.w>1e-6&&clipPosition.z>=0&&clipPosition.z<=clipPosition.w
            &&(!nearPolicy||clipPosition.w<=nearLimit))
        {
            float2 xy=clipPosition.xy/clipPosition.w;
            low=min(low,xy);high=max(high,xy);
            if(tightWall)SilPomImplicitGrowWall(wallBounds,xy);
        }
        else clipped=true;
    }
    if(clipped)
    {
        for(uint i=0;i<6;++i)
        {
            float4 a=corners[i];
            for(uint j=i+1;j<6;++j)
            {
                float4 b=corners[j];
                const uint planeCount=nearPolicy?3u:2u;
                for(uint plane=0;plane<planeCount;++plane)
                {
                    float da=plane==0?a.w-a.z:a.z;
                    float db=plane==0?b.w-b.z:b.z;
                    if(nearPolicy&&plane==2)
                    {da=nearLimit-a.w;db=nearLimit-b.w;}
                    if((da<0)!=(db<0))
                    {
                        float4 edge=lerp(a,b,da/(da-db));
                        if(edge.w>1e-6&&(!nearPolicy||plane==2||edge.w<=nearLimit))
                        {
                            float2 xy=edge.xy/edge.w;
                            low=min(low,xy);high=max(high,xy);
                            if(tightWall)SilPomImplicitGrowWall(wallBounds,xy);
                        }
                    }
                }
            }
        }
    }
    if(any(low>high))return result;
    low=max(low-1e-5,float2(-1,-1));high=min(high+1e-5,float2(1,1));
    const float2 extent=max(high-low,0.0f);
    float proxyArea=extent.x*extent.y;
    SilPomImplicitTriangle triangleShape;
    const bool useTriangle=trianglePolicy&&!clipped&&SilPomReliefNoMarch(profile.reliefMode)
        &&profile.reliefMode!=SP_RELIEF_RECTANGLE_CONTROL&&SilPomImplicitTriangleShape(corners,proxyArea,triangleShape);
    SilPomImplicitWallShape wall=(SilPomImplicitWallShape)0;
    if(tightWall&&proxyArea>0)wall=SilPomImplicitChooseWall(wallBounds,proxyArea);
    const float2 quadCorners[4]={float2(-1,-1),float2(1,-1),float2(-1,1),float2(1,1)};
    [unroll] for(uint i=0;i<4;++i)
    {
        if(singleCorner&&i>0)break;
        const float2 quadCorner=singleCorner?requestedCorner:quadCorners[i];
        const float2 corner=quadCorner*.5+.5;
        result.ndc[i]=lerp(low,high,corner);
        if(useTriangle)result.ndc[i]=SilPomImplicitTriangleCorner(triangleShape,quadCorner);
        if(wall.selected)result.ndc[i]=wall.origin+corner.x*wall.u+corner.y*wall.v;
    }
    result.status=SP_IMPLICIT_CACHE_LIVE;
    return result;
}

float SilPomImplicitNearestDepth(SilPomMeshFace face,float scale,float reference,
    float4x4 model,float4x4 vp)
{
    float3 low=float3(1e30f,1e30f,1e30f),high=float3(-1e30f,-1e30f,-1e30f);
    // Retain the depth enclosure's original endpoint expression independently
    // of coverage clipping/shape selection and its optional LOD cut.
    for(uint i=0;i<6;++i)
    {
        float2 uv=i/2==0?face.uv0:(i/2==1?face.uv1:face.uv2);
        float3 D=i/2==0?face.d0:(i/2==1?face.d1:face.d2);
        float h=scale*(float(i%2)-reference);
        float3 p=face.origin+face.du*(uv.x-face.uv0.x)+face.dv*(uv.y-face.uv0.y)+D*h;
        low=min(low,p);high=max(high,p);
    }
    const float3 extent=(high-low)*.5f+2e-5f;
    const float4x4 localToClip=mul(vp,model);
    const float4 center=mul(localToClip,float4((high+low)*.5f,1.0f));
    const float minW=center.w-dot(abs(localToClip[3].xyz),extent);
    const float maxZ=center.z+dot(abs(localToClip[2].xyz),extent);
    const float legacy=minW>1e-6f?saturate(maxZ/minW+1e-5f):1.0f;
    if(legacy<1.0f)return legacy;
    return SilPomFrustumDepthBound((high+low)*.5f,extent,model,vp);
}
