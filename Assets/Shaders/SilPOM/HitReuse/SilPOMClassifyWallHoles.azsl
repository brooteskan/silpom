#include <Atom/Features/SrgSemantics.azsli>
#include <Atom/Features/PostProcessing/FullscreenVertex.azsli>
#include "SilPOMHitRecord.azsli"
#include "../GradientContext.azsli"
#include "../RepairGradientContext.azsli"

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2DMS<float2> m_sceneDepth;
    Texture2DMS<uint4> m_hits;
    Texture2DMS<float4> m_hitUvGradients;
    Texture2DMS<float4> m_hitDepthGradients;
}

bool IsWallHit(uint4 record)
{
    return (record.z & SP_HIT_RECORD_WALL) != 0 && (record.w & 3u) == 1u;
}

static uint silpomRepairSample;
static const float MinimumPairAgreement = .90f;
static const float MaximumGapDepthRatio = .80f;

SilPomGradientContext GradientAt(int2 pixel)
{
    return SilPomGradientUnpack(PassSrg::m_hitUvGradients.Load(pixel,silpomRepairSample),
        PassSrg::m_hitDepthGradients.Load(pixel,silpomRepairSample));
}

struct SilPomClassifyOutput
{
    uint4 hit:SV_Target0;
    float4 uvGradients:SV_Target1;
    float4 depthGradients:SV_Target2;
};
SilPomClassifyOutput RepairOutput(uint4 hit,SilPomGradientContext context)
{
    context=SilPomGradientConditionRepair(context);
    SilPomClassifyOutput output;
    output.hit=hit;output.uvGradients=context.uv;
    output.depthGradients=SilPomGradientPackDepth(context);
    return output;
}

float RecordDepth(uint4 record)
{
    return asfloat(record.z & SP_HIT_RECORD_DEPTH);
}

float PairAgreement(uint4 a, uint4 b)
{
    const float za = RecordDepth(a);
    const float zb = RecordDepth(b);
    const float nearer = max(za, zb);
    return nearer > 0.0f ? min(za, zb) / nearer : 0.0f;
}

uint4 FillIsolatedSky(int2 pixel,uint4 left, uint4 right, uint4 top, uint4 bottom,out SilPomGradientContext context)
{
    context=(SilPomGradientContext)0;
    if (!IsWallHit(left) || !IsWallHit(right) || !IsWallHit(top) || !IsWallHit(bottom))
        return 0;

    const float horizontal = PairAgreement(left, right);
    const float vertical = PairAgreement(top, bottom);
    if (max(horizontal, vertical) < MinimumPairAgreement)
        return 0;

    // Prefer interpolating across the same face. At a seam, borrow the farther
    // record from the more consistent pair so its UV remains on the donor face.
    const bool horizontalSame = left.w == right.w && horizontal >= MinimumPairAgreement;
    const bool verticalSame = top.w == bottom.w && vertical >= MinimumPairAgreement;
    const bool useHorizontal = horizontalSame == verticalSame ? horizontal >= vertical : horizontalSame;
    const uint4 a = useHorizontal ? left : top;
    const uint4 b = useHorizontal ? right : bottom;
    const uint za = a.z & SP_HIT_RECORD_DEPTH;
    const uint zb = b.z & SP_HIT_RECORD_DEPTH;
    uint4 fill = za <= zb ? a : b;
    const int2 axis=useHorizontal?int2(1,0):int2(0,1);
    const SilPomGradientContext aContext=GradientAt(pixel-axis),bContext=GradientAt(pixel+axis);
    if(za<=zb)context=SilPomGradientCopied(aContext);
    else context=SilPomGradientCopied(bContext);
    if (a.w == b.w)
    {
        fill.xy = asuint((asfloat(a.xy) + asfloat(b.xy)) * .5f);
        fill.z = (fill.z & ~SP_HIT_RECORD_DEPTH) | asuint((asfloat(za) + asfloat(zb)) * .5f);
        context=SilPomGradientBlendAnchored(asfloat(a.xy),asfloat(za),aContext,
            asfloat(b.xy),asfloat(zb),bContext,.5f,float2(axis)*.5f,false,SP_GRADIENT_REPAIR_ARITHMETIC,
            asfloat(fill.xy),RecordDepth(fill));
    }
    return fill;
}

// A pixel without any SilPOM record whose depth is at or behind an anchor shows
// nothing nearer than the wall there: with the depth pre-pass that is the
// bottom shell, a few centimetres behind its neighbours rather than the far
// plane. Treat it like background; foreground geometry is still nearer.
bool BehindAnchor(float depth, float anchor, uint centerOwner)
{
    return depth < MaximumGapDepthRatio * anchor || (centerOwner == 0u && depth <= anchor);
}

uint4 BridgeGap(int2 pixel, int2 axis, float centerDepth, uint centerOwner, uint4 a, uint4 b,out SilPomGradientContext context)
{
    context=(SilPomGradientContext)0;
    int2 aPixel=pixel-axis,bPixel=pixel+axis;
    float za = RecordDepth(a);
    float zb = RecordDepth(b);
    const bool nearA = IsWallHit(a) && BehindAnchor(centerDepth, za, centerOwner);
    const bool nearB = IsWallHit(b) && BehindAnchor(centerDepth, zb, centerOwner);
    if (!nearA && !nearB)
        return 0;

    // A two-pixel gap has an adjacent anchor on only one side. Check the scene
    // depth of the other gap pixel too, so foreground geometry stops the bridge.
    float gapDepth = centerDepth;
    float weight = .5f;
    if (!nearA)
    {
        gapDepth = max(gapDepth, PassSrg::m_sceneDepth.Load(pixel - axis,silpomRepairSample).r);
        a = PassSrg::m_hits.Load(pixel - 2 * axis,silpomRepairSample);
        aPixel=pixel-2*axis;
        if (!IsWallHit(a))
            return 0;
        za = RecordDepth(a);
        weight = 2.0f / 3.0f;
    }
    else if (!nearB)
    {
        gapDepth = max(gapDepth, PassSrg::m_sceneDepth.Load(pixel + axis,silpomRepairSample).r);
        b = PassSrg::m_hits.Load(pixel + 2 * axis,silpomRepairSample);
        bPixel=pixel+2*axis;
        if (!IsWallHit(b))
            return 0;
        zb = RecordDepth(b);
        weight = 1.0f / 3.0f;
    }

    const float farAnchor = min(za, zb);
    if (a.w != b.w || a.w == centerOwner || !BehindAnchor(gapDepth, farAnchor, centerOwner) ||
        farAnchor < MinimumPairAgreement * max(za, zb))
        return 0;

    const float depth = lerp(za, zb, weight);
    uint4 fill = za <= zb ? a : b;
    fill.xy = asuint(lerp(asfloat(a.xy) * za, asfloat(b.xy) * zb, weight) / depth);
    fill.z = (fill.z & ~SP_HIT_RECORD_DEPTH) | asuint(depth);
    const float2 separation=float2(bPixel-aPixel);
    const float2 weightGradient=separation/dot(separation,separation);
    const SilPomGradientContext aContext=GradientAt(aPixel),bContext=GradientAt(bPixel);
    context=SilPomGradientBlendAnchored(asfloat(a.xy),za,aContext,asfloat(b.xy),zb,bContext,
        weight,weightGradient,true,SP_GRADIENT_REPAIR_DEPTH_WEIGHTED,asfloat(fill.xy),RecordDepth(fill));
    return fill;
}

SilPomClassifyOutput MainPS(VSOutput input,uint sampleIndex:SV_SampleIndex)
{
    silpomRepairSample=sampleIndex;
    const int2 pixel = int2(input.m_position.xy);
    uint width,height,samples;PassSrg::m_hits.GetDimensions(width,height,samples);
    if(samples>2)
    {
        // Experimental 4x preserves raw mixed/partial sample ownership.
        // Standard 2x instead uses the established neighbor-supported repair
        // per sample, before the recessed wall backup can introduce a seam.
        const uint owner=PassSrg::m_hits.Load(pixel,0).w;
        for(uint s=0;s<samples;++s)
        {
            const uint4 hit=PassSrg::m_hits.Load(pixel,s);
            if(!IsWallHit(hit)||hit.w!=owner)return (SilPomClassifyOutput)0;
        }
    }
    const float centerDepth = PassSrg::m_sceneDepth.Load(pixel,silpomRepairSample).r;
    const int2 horizontal = int2(1, 0);
    const int2 vertical = int2(0, 1);
    // Out-of-bounds loads are zero, so the viewport edge cannot supply support.
    const uint4 left = PassSrg::m_hits.Load(pixel - horizontal,silpomRepairSample);
    const uint4 right = PassSrg::m_hits.Load(pixel + horizontal,silpomRepairSample);
    const uint4 top = PassSrg::m_hits.Load(pixel - vertical,silpomRepairSample);
    const uint4 bottom = PassSrg::m_hits.Load(pixel + vertical,silpomRepairSample);
    SilPomGradientContext context=(SilPomGradientContext)0;
    const uint centerRecord = PassSrg::m_hits.Load(pixel,silpomRepairSample).w;
    const float nearestAnchor = max(max(RecordDepth(left), RecordDepth(right)), max(RecordDepth(top), RecordDepth(bottom)));
    if (centerDepth == 0.0f || (centerRecord == 0u && centerDepth <= nearestAnchor))
    {
        const uint4 skyFill = FillIsolatedSky(pixel,left, right, top, bottom,context);
        if (skyFill.w != 0)
            return RepairOutput(skyFill,context);
    }

    const uint centerOwner = PassSrg::m_hits.Load(pixel,silpomRepairSample).w;
    uint4 fill = BridgeGap(pixel, horizontal, centerDepth, centerOwner, left, right,context);
    if (fill.w == 0)
        fill = BridgeGap(pixel, vertical, centerDepth, centerOwner, top, bottom,context);

    const int2 diagonals[2] = {int2(1, 1), int2(1, -1)};
    [unroll]
    for (int i = 0; i < 2; ++i)
    {
        if (fill.w == 0)
        {
            const int2 axis = diagonals[i];
            const uint4 a = PassSrg::m_hits.Load(pixel - axis,silpomRepairSample);
            const uint4 b = PassSrg::m_hits.Load(pixel + axis,silpomRepairSample);
            fill = BridgeGap(pixel, axis, centerDepth, centerOwner, a, b,context);
        }
    }
    // The 4x variant initializes every sample instead of using a native clear
    // of the integer MSAA target. Preserve the established 1x discard behavior.
    if (fill.w == 0 && samples==1)
        discard;
    return RepairOutput(fill,context);
}
