#include <Atom/Features/SrgSemantics.azsli>
#include <Atom/Features/PostProcessing/FullscreenVertex.azsli>

// Pixel-frequency broadcast of the empty record and its invalid gradient
// context to all covered samples, starting the same attachment generation.
// No depth attachment is written and no hit record is resolved.
struct SilPomClearOutput
{
    uint4 hit:SV_Target0;
    float4 uvGradients:SV_Target1;
    float4 depthGradients:SV_Target2;
};
SilPomClearOutput MainPS(VSOutput input) { return (SilPomClearOutput)0; }
