+    }
+
+    bool CharacterController::SetPushStrength(float newtons)
+    {
+        const bool wasEnabled = m_push.Enabled();
+        if (!m_push.SetStrength(newtons)) return false;
+        if (wasEnabled == m_push.Enabled()) return true;
