+            }
+            m_ridingPlatformRemovedHandler = AzPhysics::SceneEvents::OnSimulationBodyRemoved::Handler(
+                [this](AzPhysics::SceneHandle, AzPhysics::SimulatedBodyHandle removed)
+                {
+                    if (removed == m_ridingPlatform || removed == m_bodyHandle)
