diff --git a/Gems/Atom/Feature/Common/Assets/ShaderLib/Atom/Features/PBR/DecalComposite.azsli b/Gems/Atom/Feature/Common/Assets/ShaderLib/Atom/Features/PBR/DecalComposite.azsli
new file mode 100644
index 0000000000000000000000000000000000000000..bcd4a19e3f29e2e16e123af1eb3cc2ae7cf327bd
--- /dev/null
+++ b/Gems/Atom/Feature/Common/Assets/ShaderLib/Atom/Features/PBR/DecalComposite.azsli
@@ -0,0 +1,134 @@
+// Copyright (c) Contributors to the Open 3D Engine Project.
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+#pragma once
+#include <Atom/Features/Bindless.azsli>
+#ifndef DECAL_PAINT_HEIGHT
+#define DECAL_PAINT_HEIGHT() -1.0f
+#endif
+
+bool PaintHeightSelected(uint flags,float height)
+{
+    const uint mask=(flags>>8)&7;
+    if(mask==7)return true; // Includes ordinary materials without a heightmap.
+    if(height<0)return false;
+    const uint band=height<1.0f/3.0f?0:(height<2.0f/3.0f?1:2);
+    return (mask&(1u<<band))!=0;
+}
+
+Decal LoadPaintDab(ByteAddressBuffer buffer, uint offset)
+{
+    uint4 a=buffer.Load4(offset), b=buffer.Load4(offset+16), c=buffer.Load4(offset+32);
+    uint4 d=buffer.Load4(offset+48), e=buffer.Load4(offset+64);
+    Decal value;
+    value.m_position=asfloat(a.xyz);value.m_opacity=asfloat(a.w);
+    value.m_quaternion=asfloat(b);value.m_halfSize=asfloat(c.xyz);value.m_angleAttenuation=asfloat(c.w);
+    value.m_normalMapOpacity=asfloat(d.x);value.m_sortKeyPacked=d.y;
+    value.m_textureArrayIndex=d.z;value.m_textureIndex=d.w;
+    value.m_decalColor=asfloat(e.xyz);value.m_decalColorFactor=asfloat(e.w);
+    return value;
+}
+
+// Alpha-only projections do not need normal-map fetches. Accumulating from
+// newest to oldest permits a bounded-error opacity early-out in dense paint.
+void SamplePaintAlpha(Decal decal, Surface surface, float3 positionDx, float3 positionDy, out float3 color, out float alpha)
+{
+    color=0;alpha=0;
+    float3x3 rotation=transpose(MatrixFromQuaternion(decal.m_quaternion));
+    float3 uvw=mul(rotation,surface.position-decal.m_position)/decal.m_halfSize;
+    if(any(uvw < -1.0)||any(uvw > 1.0))return;
+    float3 uv=float3(uvw.x*.5+.5,.5-uvw.y*.5,decal.m_textureIndex);
+    float2 decalDx=mul(rotation,positionDx).xy/decal.m_halfSize.xy*float2(.5,-.5);
+    float2 decalDy=mul(rotation,positionDy).xy/decal.m_halfSize.xy*float2(.5,-.5);
+    float4 map=0;
+    switch(decal.m_textureArrayIndex)
+    {
+        case 0:map=ViewSrg::m_decalTextureArrayDiffuse0.SampleGrad(PassSrg::LinearSampler,uv,decalDx,decalDy);break;
+        case 1:map=ViewSrg::m_decalTextureArrayDiffuse1.SampleGrad(PassSrg::LinearSampler,uv,decalDx,decalDy);break;
+        case 2:map=ViewSrg::m_decalTextureArrayDiffuse2.SampleGrad(PassSrg::LinearSampler,uv,decalDx,decalDy);break;
+        case 3:map=ViewSrg::m_decalTextureArrayDiffuse3.SampleGrad(PassSrg::LinearSampler,uv,decalDx,decalDy);break;
+        case 4:map=ViewSrg::m_decalTextureArrayDiffuse4.SampleGrad(PassSrg::LinearSampler,uv,decalDx,decalDy);break;
+    }
+    bool useTexture=true;
+    color=BlendBaseColor(real3(map.rgb),real3(decal.m_decalColor),real(decal.m_decalColorFactor),TextureBlendMode::Multiply,useTexture);
+    alpha=map.a*decal.m_opacity*GetDecalAttenuation(surface.GetVertexNormal(),rotation[2],decal.m_angleAttenuation);
+}
+
+void ApplyPaintForward(ByteAddressBuffer buffer,uint offset,inout Surface surface,float3 positionDx,float3 positionDy,
+    float height,inout uint layer,inout float3 baseColor,inout float3 baseNormal)
+{
+    const uint4 meta=buffer.Load4(offset+80);
+    if(!PaintHeightSelected(meta.x,height))return;
+    if(layer!=meta.y){layer=meta.y;baseColor=surface.albedo;baseNormal=surface.normal;}
+    Decal dab=LoadPaintDab(buffer,offset);
+    if((meta.x&1)!=0)
+    {
+        float3 ignored;float alpha;SamplePaintAlpha(dab,surface,positionDx,positionDy,ignored,alpha);
+        surface.albedo=real3(lerp(surface.albedo,baseColor,alpha));
+        surface.normal=alpha>=1?real3(baseNormal):real3(normalize(lerp(surface.normal,baseNormal,alpha)));
+    }
+    else ApplyDecalData(dab,surface,positionDx,positionDy);
+}
+
+void ApplyPaintComposite(Decal composite,inout Surface surface,float3 positionDx,float3 positionDy)
+{
+    ByteAddressBuffer buffer=Bindless::GetByteAddressBuffer(composite.m_textureArrayIndex);
+    uint4 header=buffer.Load4(0);
+    // The material hook performs exact bilinear mip-zero height lookup once per
+    // filtered batch, with the same tiling/addressing as SILPOM intersection.
+    float height=-1;
+    [branch] if((header.z&4)!=0)height=DECAL_PAINT_HEIGHT();
+    uint layer=0xFFFFFFFF;
+    float3 baseColor=0,baseNormal=0;
+    if((header.z&2)!=0)
+    {
+        [loop]
+        for(uint i=0;i<header.w;++i)ApplyPaintForward(buffer,header.y+i*96,surface,positionDx,positionDy,height,layer,baseColor,baseNormal);
+        return;
+    }
+    float3 premultiplied=0;
+    float transmittance=1;
+    float3 layerColor=0;
+    float layerAlpha=0,weight=1;
+    uint node=0;
+    [loop]
+    while(node<header.x)
+    {
+        uint offset=16+node*32;
+        uint4 low=buffer.Load4(offset), high=buffer.Load4(offset+16);
+        if(any(surface.position<asfloat(low.xyz))||any(surface.position>asfloat(high.xyz)))
+        {
+            node=low.w;continue;
+        }
+        ++node;
+        if(high.w>=header.w)continue; // Interior node.
+        const uint leafOffset=header.y+high.w*96;
+        const uint4 meta=buffer.Load4(leafOffset+80);
+        if(!PaintHeightSelected(meta.x,height))continue;
+        if((header.z&1)!=0)
+        {
+            if(layer!=meta.y)
+            {
+                premultiplied+=transmittance*layerColor;transmittance*=saturate(1-layerAlpha);
+                if(transmittance<0.00001){layerColor=0;layerAlpha=0;break;}
+                layer=meta.y;layerColor=0;layerAlpha=0;weight=1;
+            }
+            Decal dab=LoadPaintDab(buffer,leafOffset);
+            float3 color;float alpha;SamplePaintAlpha(dab,surface,positionDx,positionDy,color,alpha);
+            if((meta.x&1)==0){layerColor+=weight*alpha*color;layerAlpha+=weight*alpha;}
+            weight*=1-alpha;
+            if(transmittance*(1-layerAlpha)<0.00001)break;
+            // A full erase can make the older part of this layer irrelevant,
+            // while paint in lower layers must still remain visible.
+            if(weight<0.00001)node=meta.z;
+        }
+        else
+        {
+            ApplyPaintForward(buffer,leafOffset,surface,positionDx,positionDy,height,layer,baseColor,baseNormal);
+        }
+    }
+    if((header.z&1)!=0)
+    {
+        premultiplied+=transmittance*layerColor;transmittance*=saturate(1-layerAlpha);
+        surface.albedo=real3(premultiplied+transmittance*surface.albedo);
