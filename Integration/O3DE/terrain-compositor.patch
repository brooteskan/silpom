 {
-    uint v = uint(value);
-    return (v & QuadReadAcrossX(v) & QuadReadAcrossY(v) & QuadReadAcrossDiagonal(v)) != 0;
+    // A binary value is constant over the quad iff both first differences
+    // and the cross difference vanish. The cross term catches a false lane
+    // diagonally opposite a true lane whose immediate neighbors are both true.
+    // Fine derivatives include helper pixels and avoid making later implicit
+    // texture gradients depend on a wave intrinsic's result (DXIL validation).
+    float v = value ? 1.0 : 0.0;
+    float horizontal = abs(ddx_fine(v));
+    float vertical = abs(ddy_fine(v));
+    float crossDifference = abs(ddx_fine(vertical));
+    return v > 0.0 && horizontal + vertical + crossDifference == 0.0;
 }
